"""
feature_store/online/client.py

Online Feature Store client.

Wraps Redis with a typed, domain-aware API for reading and writing
feature vectors. All platform components use this instead of talking
to Redis directly.

Design principles:
  - Key namespacing prevents collisions between feature groups
  - All values stored as JSON strings (preserves types, allows dicts)
  - TTL enforced per-write (features expire if telemetry stops)
  - Bulk operations for batch inference
"""

from __future__ import annotations

import json
import logging
from typing import Any

logger = logging.getLogger(__name__)

# Key format: {namespace}:{entity_id}
# e.g.  features:vol-0001
#        predictions:vol-0001
#        hotspot_state:vol-0001

NAMESPACE_FEATURES    = "features"
NAMESPACE_PREDICTIONS = "predictions"
NAMESPACE_HOTSPOT     = "hotspot_state"
NAMESPACE_BASELINE    = "baseline"


class OnlineFeatureStore:
    """
    Redis-backed online feature store.

    Usage:
        store = OnlineFeatureStore(host="localhost", port=6379)

        # Write feature vector for a volume
        store.write_features("vol-001", {"iops": 42000, "latency_us": 400, ...})

        # Read it back at inference time
        features = store.read_features("vol-001")

        # Write prediction result
        store.write_prediction("vol-001", {"predicted_class": "DB_OLTP", "confidence": 0.97})
    """

    def __init__(
        self,
        host: str = "localhost",
        port: int = 6379,
        db: int = 0,
        default_ttl_s: int = 300,
        password: str | None = None,
    ) -> None:
        import redis
        self._r = redis.Redis(
            host=host,
            port=port,
            db=db,
            password=password,
            decode_responses=True,
            socket_connect_timeout=5,
            socket_timeout=2,
            retry_on_timeout=True,
        )
        self.default_ttl_s = default_ttl_s

    #  Features 

    def write_features(
        self,
        entity_id: str,
        features: dict[str, Any],
        ttl_s: int | None = None,
    ) -> bool:
        """Write a feature vector. Returns True on success."""
        key = f"{NAMESPACE_FEATURES}:{entity_id}"
        try:
            self._r.set(key, json.dumps(features), ex=ttl_s or self.default_ttl_s)
            return True
        except Exception as exc:
            logger.warning("write_features failed for %s: %s", entity_id, exc)
            return False

    def read_features(self, entity_id: str) -> dict[str, Any] | None:
        """Read a feature vector. Returns None if not found or expired."""
        key = f"{NAMESPACE_FEATURES}:{entity_id}"
        try:
            raw = self._r.get(key)
            return json.loads(raw) if raw else None
        except Exception as exc:
            logger.warning("read_features failed for %s: %s", entity_id, exc)
            return None

    def bulk_read_features(self, entity_ids: list[str]) -> dict[str, dict | None]:
        """Read feature vectors for multiple entities in one round-trip."""
        if not entity_ids:
            return {}
        keys = [f"{NAMESPACE_FEATURES}:{eid}" for eid in entity_ids]
        try:
            values = self._r.mget(keys)
        except Exception as exc:
            logger.warning("bulk_read_features failed: %s", exc)
            return {eid: None for eid in entity_ids}
        return {
            eid: json.loads(v) if v else None
            for eid, v in zip(entity_ids, values)
        }

    #  Predictions

    def write_prediction(
        self,
        entity_id: str,
        prediction: dict[str, Any],
        ttl_s: int | None = None,
    ) -> bool:
        key = f"{NAMESPACE_PREDICTIONS}:{entity_id}"
        try:
            self._r.set(key, json.dumps(prediction), ex=ttl_s or self.default_ttl_s)
            return True
        except Exception as exc:
            logger.warning("write_prediction failed for %s: %s", entity_id, exc)
            return False

    def read_prediction(self, entity_id: str) -> dict[str, Any] | None:
        key = f"{NAMESPACE_PREDICTIONS}:{entity_id}"
        try:
            raw = self._r.get(key)
            return json.loads(raw) if raw else None
        except Exception as exc:
            logger.warning("read_prediction failed for %s: %s", entity_id, exc)
            return None

    #  Hotspot State ─

    def set_hotspot(
        self,
        entity_id: str,
        severity: str,
        ttl_s: int = 120,
    ) -> bool:
        """Mark a volume as a current hotspot."""
        key = f"{NAMESPACE_HOTSPOT}:{entity_id}"
        try:
            self._r.set(key, severity, ex=ttl_s)
            return True
        except Exception as exc:
            logger.warning("set_hotspot failed for %s: %s", entity_id, exc)
            return False

    def get_hotspot(self, entity_id: str) -> str | None:
        """Returns hotspot severity string, or None if not currently hot."""
        key = f"{NAMESPACE_HOTSPOT}:{entity_id}"
        try:
            return self._r.get(key)
        except Exception as exc:
            logger.warning("get_hotspot failed for %s: %s", entity_id, exc)
            return None

    def list_hotspots(self) -> list[str]:
        """Return all entity IDs currently flagged as hotspots."""
        try:
            keys = self._r.keys(f"{NAMESPACE_HOTSPOT}:*")
            return [k.split(":", 1)[1] for k in keys]
        except Exception as exc:
            logger.warning("list_hotspots failed: %s", exc)
            return []

    #  Volume Baselines 

    def write_baseline(
        self,
        entity_id: str,
        baseline: dict[str, float],
        ttl_s: int = 3600,
    ) -> bool:
        """Store per-volume adaptive baseline metrics (1h TTL by default)."""
        key = f"{NAMESPACE_BASELINE}:{entity_id}"
        try:
            self._r.set(key, json.dumps(baseline), ex=ttl_s)
            return True
        except Exception as exc:
            logger.warning("write_baseline failed for %s: %s", entity_id, exc)
            return False

    def read_baseline(self, entity_id: str) -> dict[str, float] | None:
        key = f"{NAMESPACE_BASELINE}:{entity_id}"
        try:
            raw = self._r.get(key)
            return json.loads(raw) if raw else None
        except Exception as exc:
            logger.warning("read_baseline failed for %s: %s", entity_id, exc)
            return None

    #  Health 

    def ping(self) -> bool:
        try:
            return self._r.ping()
        except Exception:
            return False

    def stats(self) -> dict[str, Any]:
        try:
            info = self._r.info("memory")
            key_count = self._r.dbsize()
            return {
                "connected": True,
                "key_count": key_count,
                "used_memory_mb": round(info["used_memory"] / 1024 / 1024, 2),
                "maxmemory_mb": round(info.get("maxmemory", 0) / 1024 / 1024, 2),
            }
        except Exception as exc:
            return {"connected": False, "error": str(exc)}
