"""
actuators/actuator.py

Actuator layer.

Translates abstract move plans from the rebalancer into physical
storage operations via:
  - CSI driver calls (Kubernetes)
  - Array API calls (vendor-specific, e.g. Pure Storage, NetApp, Dell)
  - Hypervisor DRS (vSphere)

This module defines the abstract interface; concrete implementations
live in actuators/csi.py, actuators/array_api.py, etc.

In POC/dev mode, StubActuator is used which simulates moves
without touching any real hardware.
"""

from __future__ import annotations

import logging
import time
import uuid
from abc import ABC, abstractmethod
from dataclasses import dataclass

from rebalancer.optimizer import MoveOp, MovePlan
from execution_monitor.monitor import ExecutionMonitor, MovePhase

logger = logging.getLogger(__name__)


#  Abstract Interface 

class BaseActuator(ABC):
    """
    Abstract base class for all actuator implementations.
    """

    def __init__(self, monitor: ExecutionMonitor) -> None:
        self.monitor = monitor

    def execute_plan(self, plan: MovePlan) -> dict[str, bool]:
        """
        Execute all moves in a plan.

        Returns:
            dict mapping op_id → success (True/False)
        """
        if not plan.feasible:
            logger.error("Plan %s is not feasible: %s",
                         plan.plan_id, plan.infeasibility_reason)
            return {}

        results = {}
        for move in plan.moves:
            if not self.monitor.can_accept(move.volume_id):
                logger.warning("Cannot execute move for vol=%s — monitor at capacity",
                               move.volume_id)
                results[move.op_id] = False
                continue

            self.monitor.register(
                op_id=move.op_id,
                volume_id=move.volume_id,
                source_node=move.source_node,
                target_node=move.target_node,
                size_gb=move.size_gb,
            )

            try:
                success = self._execute_move(move)
                results[move.op_id] = success
            except Exception as exc:
                logger.exception("Move %s failed with exception", move.op_id)
                self.monitor.mark_failed(move.op_id, str(exc))
                results[move.op_id] = False

        return results

    @abstractmethod
    def _execute_move(self, move: MoveOp) -> bool:
        """
        Perform a single volume move.
        Must call self.monitor.update_phase() at each transition.
        Returns True on success.
        """
        ...

    @abstractmethod
    def rollback_move(self, op_id: str) -> bool:
        """Attempt to undo a move (e.g., move data back to source)."""
        ...


#  Stub Actuator (Dev / Test) 

class StubActuator(BaseActuator):
    """
    Simulates move operations without touching hardware.
    Simulates realistic timing and occasional failures.
    """

    def __init__(
        self,
        monitor: ExecutionMonitor,
        failure_rate: float = 0.02,   # 2% simulated failure rate
        speed_up: float = 100.0,      # speed multiplier vs real time
    ) -> None:
        super().__init__(monitor)
        self.failure_rate = failure_rate
        self.speed_up = speed_up

    def _execute_move(self, move: MoveOp) -> bool:
        import random

        logger.info("[STUB] Starting move: vol=%s %s→%s size=%.1fGB",
                    move.volume_id, move.source_node, move.target_node, move.size_gb)

        self.monitor.update_phase(move.op_id, MovePhase.PRE_CHECK)
        time.sleep(0.1 / self.speed_up)

        # Simulate occasional failures
        if random.random() < self.failure_rate:
            self.monitor.mark_failed(move.op_id, "Simulated failure (pre-check)")
            return False

        self.monitor.update_phase(move.op_id, MovePhase.EXECUTING, bytes_moved_gb=0.0)

        # Simulate data transfer progress
        steps = 10
        for i in range(1, steps + 1):
            time.sleep((move.estimated_duration_s / steps) / self.speed_up)
            bytes_done = (i / steps) * move.size_gb
            self.monitor.update_phase(move.op_id, MovePhase.EXECUTING,
                                       bytes_moved_gb=bytes_done)

        self.monitor.update_phase(move.op_id, MovePhase.VERIFYING,
                                   bytes_moved_gb=move.size_gb)
        time.sleep(0.05 / self.speed_up)

        self.monitor.update_phase(move.op_id, MovePhase.COMPLETED,
                                   bytes_moved_gb=move.size_gb)
        logger.info("[STUB] Completed move: vol=%s", move.volume_id)
        return True

    def rollback_move(self, op_id: str) -> bool:
        logger.info("[STUB] Rolling back op_id=%s", op_id)
        return True


