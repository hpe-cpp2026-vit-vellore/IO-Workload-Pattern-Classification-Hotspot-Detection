#!/usr/bin/env bash
# scripts/bootstrap.sh
#
# One-shot dev environment bootstrap.
# Run from the repo root:
#   bash scripts/bootstrap.sh
#
# What this does:
#   1. Create Python virtualenv and install dependencies
#   2. Start Docker Compose stack (Kafka, Redis, Postgres, MLflow, Prometheus, Grafana)
#   3. Wait for services to be healthy
#   4. Bootstrap Kafka topics
#   5. Run batch feature backfill on sample data
#   6. Train the classification model
#   7. Print service URLs

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()    { echo -e "${GREEN}[bootstrap]${NC} $*"; }
warn()    { echo -e "${YELLOW}[bootstrap]${NC} $*"; }
error()   { echo -e "${RED}[bootstrap]${NC} $*" >&2; }

# ── 1. Python environment ──────────────────────────────────────────────────

info "Setting up Python virtual environment..."
if [ ! -d ".venv" ]; then
    python3 -m venv .venv
fi
source .venv/bin/activate
pip install --upgrade pip --quiet
pip install -r requirements.txt --quiet
info "Python environment ready ✓"

# ── 2. Docker Compose ──────────────────────────────────────────────────────

info "Starting Docker Compose stack..."
docker compose -f deploy/docker/docker-compose.yml up -d
info "Docker services started ✓"

# ── 3. Wait for services ───────────────────────────────────────────────────

wait_for_port() {
    local host=$1 port=$2 label=$3 retries=${4:-30}
    info "Waiting for $label ($host:$port)..."
    for i in $(seq 1 "$retries"); do
        if nc -z "$host" "$port" 2>/dev/null; then
            info "$label ready ✓"
            return 0
        fi
        sleep 2
    done
    error "$label did not become ready in time"
    return 1
}

wait_for_port localhost 9092  "Kafka"      30
wait_for_port localhost 6379  "Redis"      20
wait_for_port localhost 5432  "Postgres"   20
wait_for_port localhost 5000  "MLflow"     30

# Extra settle time for Kafka
sleep 5

# ── 4. Kafka topics ────────────────────────────────────────────────────────

info "Bootstrapping Kafka topics..."
python -m ingestion.kafka.admin --bootstrap-servers localhost:9092
info "Kafka topics created ✓"

# ── 5. Feature backfill ────────────────────────────────────────────────────

info "Running batch feature backfill on sample data..."
python scripts/ingest_sample.py \
    --offline \
    --file data/sample/io_workload_data_sample.csv \
    --output-dir data/offline_store
info "Feature backfill complete ✓"

# ── 6. Train classifier ────────────────────────────────────────────────────

info "Training workload classifier..."
python -m ml.classification.train \
    --config config/ml/classification.yaml \
    --data data/sample/io_workload_data_sample.csv \
    --output-dir models \
    --mlflow-uri http://localhost:5000
info "Model training complete ✓"

# ── 7. Print URLs ──────────────────────────────────────────────────────────

echo ""
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}  IO Workload Platform — Dev Stack Ready  ${NC}"
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"
echo ""
echo "  MLflow UI      →  http://localhost:5000"
echo "  Kafka UI       →  http://localhost:8090"
echo "  Prometheus     →  http://localhost:9090"
echo "  Grafana        →  http://localhost:3000  (admin/admin)"
echo ""
echo "  To start the inference server:"
echo "    source .venv/bin/activate"
echo "    uvicorn inference.serving.app:app --host 0.0.0.0 --port 8080"
echo ""
echo "  To run tests:"
echo "    pytest tests/unit -v"
echo "    pytest tests/integration -v"
echo ""
echo "  To start the telemetry agent (CSV replay):"
echo "    python -m agents.telemetry_agent.agent --mode csv"
echo ""
echo "  To start the feature engineering consumer:"
echo "    python -m feature_engineering.streaming.consumer"
echo ""
