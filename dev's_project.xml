"""
feature_engineering/features.py

Canonical feature definitions for the IO workload platform.
All feature computation (streaming and batch) uses these functions
to ensure consistency between training and inference.
"""

from __future__ import annotations

import numpy as np
import pandas as pd


# ─── Raw Feature Names (direct from telemetry) ───────────────────────────────

RAW_FEATURES = [
    "iops",
    "throughput_mbps",
    "latency_us",
    "read_ratio",
    "block_size_kb",
    "queue_depth",
    "disk_util_pct",
]

# ─── Derived Feature Names ────────────────────────────────────────────────────

DERIVED_FEATURES = [
    "iops_per_queue_depth",      # throughput efficiency signal
    "throughput_per_iops",       # effective byte transfer per IO (block size proxy)
    "latency_iops_product",      # congestion signal — high when both are high
    "read_write_asymmetry",      # |read_ratio - 0.5| — how skewed the access pattern is
    "util_per_iops",             # util pressure per unit of IOPS
    "throughput_per_util",       # throughput efficiency per % utilisation
]

ALL_FEATURES = RAW_FEATURES + DERIVED_FEATURES

# ─── Rolling Window Feature Names ─────────────────────────────────────────────
# These are appended per window, e.g., "iops_mean_60s", "iops_std_60s"

WINDOW_METRICS = ["iops", "throughput_mbps", "latency_us", "disk_util_pct"]
WINDOW_AGGS = ["mean", "std", "max", "p95"]
WINDOW_SIZES_S = [10, 60, 300]


def rolling_feature_names() -> list[str]:
    names = []
    for w in WINDOW_SIZES_S:
        for m in WINDOW_METRICS:
            for agg in WINDOW_AGGS:
                names.append(f"{m}_{agg}_{w}s")
    return names


ROLLING_FEATURES = rolling_feature_names()

MODEL_FEATURES = ALL_FEATURES  # extend with ROLLING_FEATURES when streaming data is available


# ─── Derived Feature Computation ─────────────────────────────────────────────

def compute_derived_features(df: pd.DataFrame) -> pd.DataFrame:
    """
    Add derived features to a DataFrame that already has RAW_FEATURES columns.

    Args:
        df: DataFrame with at minimum the RAW_FEATURES columns.

    Returns:
        DataFrame with additional DERIVED_FEATURES columns added.
        Original columns are preserved; new columns are appended.
    """
    df = df.copy()

    # Guard against division by zero
    eps = 1e-9

    df["iops_per_queue_depth"] = df["iops"] / (df["queue_depth"] + eps)

    df["throughput_per_iops"] = (df["throughput_mbps"] * 1024) / (df["iops"] + eps)
    # ^ in KB per IO — should correlate with block_size_kb

    df["latency_iops_product"] = (df["latency_us"] / 1000) * (df["iops"] / 1000)
    # ^ in ms * kIOPS — high values signal congestion

    df["read_write_asymmetry"] = np.abs(df["read_ratio"] - 0.5)

    df["util_per_iops"] = df["disk_util_pct"] / (df["iops"] / 1000 + eps)
    # ^ % util per kIOPS — high = less efficient storage

    df["throughput_per_util"] = df["throughput_mbps"] / (df["disk_util_pct"] + eps)
    # ^ MB/s per % util — efficiency metric

    return df


def compute_rolling_features(
    df: pd.DataFrame,
    timestamp_col: str = "timestamp_utc",
    group_col: str = "volume_id",
    window_sizes_s: list[int] | None = None,
) -> pd.DataFrame:
    """
    Compute rolling window statistics for streaming/batch feature enrichment.

    Requires df to be sorted by timestamp within each volume group.

    Args:
        df: DataFrame with RAW_FEATURES and a datetime timestamp column.
        timestamp_col: Name of the datetime column.
        group_col: Column to group by (e.g., volume_id).
        window_sizes_s: List of window sizes in seconds.

    Returns:
        DataFrame with rolling feature columns appended.
    """
    if window_sizes_s is None:
        window_sizes_s = WINDOW_SIZES_S

    df = df.copy()
    df[timestamp_col] = pd.to_datetime(df[timestamp_col], utc=True)
    df = df.sort_values([group_col, timestamp_col])

    for window_s in window_sizes_s:
        window_str = f"{window_s}s"
        grouped = df.set_index(timestamp_col).groupby(group_col)

        for metric in WINDOW_METRICS:
            roll = grouped[metric].rolling(window=window_str, min_periods=1)

            df[f"{metric}_mean_{window_s}s"] = roll.mean().reset_index(level=0, drop=True).values
            df[f"{metric}_std_{window_s}s"]  = roll.std().fillna(0).reset_index(level=0, drop=True).values
            df[f"{metric}_max_{window_s}s"]  = roll.max().reset_index(level=0, drop=True).values
            df[f"{metric}_p95_{window_s}s"]  = (
                roll.quantile(0.95).reset_index(level=0, drop=True).values
            )

    return df


def prepare_feature_vector(row: dict) -> dict:
    """
    Convert a single raw telemetry dict into a feature vector dict
    suitable for real-time inference.

    Args:
        row: Dict with keys matching RAW_FEATURES.

    Returns:
        Dict with ALL_FEATURES keys.
    """
    df = pd.DataFrame([row])
    df = compute_derived_features(df)
    return df[ALL_FEATURES].iloc[0].to_dict()


def validate_features(df: pd.DataFrame, required: list[str] | None = None) -> list[str]:
    """
    Check that all required feature columns are present and non-null.

    Returns:
        List of missing or fully-null column names (empty = OK).
    """
    required = required or MODEL_FEATURES
    issues = []
    for col in required:
        if col not in df.columns:
            issues.append(f"missing: {col}")
        elif df[col].isnull().all():
            issues.append(f"all_null: {col}")
    return issues
