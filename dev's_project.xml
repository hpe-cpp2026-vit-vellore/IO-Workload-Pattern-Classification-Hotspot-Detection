"""
rebalancer/optimizer.py

Rebalance optimizer.

Given a set of volumes flagged for rebalancing and a cluster topology,
produces a move plan: list of (volume, source_node, target_node) triples
that minimises load imbalance while respecting move budget constraints.

Two algorithms available:
  - greedy_load_aware  (default, O(n log n), runs in milliseconds)
  - lp_solver          (optimal, uses scipy.optimize.linprog, slower)
"""

from __future__ import annotations

import logging
import uuid
from dataclasses import dataclass, field
from datetime import datetime, timezone
from typing import Any

import numpy as np

logger = logging.getLogger(__name__)


#  Data Models 

@dataclass
class NodeState:
    node_id: str
    util_pct: float          # current utilization %
    free_capacity_gb: float
    iops_headroom: float     # available IOPS headroom
    tier: str                # e.g. "nvme_low_latency", "sas", "object"
    volumes: list[str] = field(default_factory=list)


@dataclass
class VolumeInfo:
    volume_id: str
    node_id: str             # current home node
    size_gb: float
    iops_demand: float
    throughput_mbps: float
    workload_class: str
    priority: int = 3        # 1=critical .. 5=best-effort


@dataclass
class MoveOp:
    op_id: str
    volume_id: str
    source_node: str
    target_node: str
    size_gb: float
    estimated_duration_s: float
    reason: str
    priority: int


@dataclass
class MovePlan:
    plan_id: str
    timestamp_utc: str
    moves: list[MoveOp]
    total_data_gb: float
    estimated_total_duration_s: float
    projected_max_util_pct: float    # expected max util after plan executes
    feasible: bool
    infeasibility_reason: str | None = None


#  Workload Tier Affinity 

TIER_AFFINITY: dict[str, list[str]] = {
    "DB_OLTP":      ["nvme_low_latency", "nvme_high_throughput", "sas"],
    "AI_Training":  ["nvme_high_throughput", "nvme_low_latency", "sas"],
    "AI_Inference": ["nvme_low_latency", "nvme_high_throughput", "sas"],
    "VM":           ["nvme_low_latency", "sas", "object"],
    "Backup":       ["sas", "object", "nvme_high_throughput"],
}


def tier_score(workload_class: str, tier: str) -> float:
    """Higher is better. Returns 1.0 for best tier, 0.0 for worst."""
    affinity = TIER_AFFINITY.get(workload_class, ["sas"])
    if tier in affinity:
        idx = affinity.index(tier)
        return 1.0 - (idx / max(len(affinity) - 1, 1))
    return 0.0


#  Greedy Optimizer 

class GreedyRebalancer:
    """
    Greedy load-aware rebalancer.

    For each flagged volume (sorted by priority then size descending):
      1. Score candidate target nodes by: (1-util) * tier_affinity
      2. Pick the best scoring node that has enough capacity
      3. Simulate the move (update in-memory node states)

    Produces a MovePlan. Does NOT execute moves.
    """

    def __init__(
        self,
        max_target_util_pct: float = 80.0,
        max_concurrent_moves: int = 5,
        max_bytes_per_move_gb: float = 100.0,
    ) -> None:
        self.max_target_util = max_target_util_pct
        self.max_concurrent_moves = max_concurrent_moves
        self.max_bytes_per_move_gb = max_bytes_per_move_gb

    def plan(
        self,
        volumes_to_move: list[VolumeInfo],
        nodes: list[NodeState],
    ) -> MovePlan:
        plan_id = str(uuid.uuid4())
        now = datetime.now(timezone.utc).isoformat()

        if not volumes_to_move or not nodes:
            return MovePlan(
                plan_id=plan_id,
                timestamp_utc=now,
                moves=[],
                total_data_gb=0.0,
                estimated_total_duration_s=0.0,
                projected_max_util_pct=max((n.util_pct for n in nodes), default=0.0),
                feasible=True,
            )

        # Work on copies so we can simulate
        node_states: dict[str, NodeState] = {
            n.node_id: NodeState(
                node_id=n.node_id,
                util_pct=n.util_pct,
                free_capacity_gb=n.free_capacity_gb,
                iops_headroom=n.iops_headroom,
                tier=n.tier,
                volumes=list(n.volumes),
            )
            for n in nodes
        }

        # Sort: highest priority first, then largest volume first (biggest impact)
        sorted_volumes = sorted(
            volumes_to_move,
            key=lambda v: (v.priority, -v.size_gb),
        )

        moves: list[MoveOp] = []

        for vol in sorted_volumes:
            if len(moves) >= self.max_concurrent_moves:
                logger.info("Move budget exhausted (%d moves), stopping", len(moves))
                break

            if vol.size_gb > self.max_bytes_per_move_gb:
                logger.warning("Volume %s size %.1fGB exceeds per-move limit %.1fGB, skipping",
                               vol.volume_id, vol.size_gb, self.max_bytes_per_move_gb)
                continue

            source = node_states.get(vol.node_id)
            if source is None:
                logger.warning("Source node %s not found for volume %s", vol.node_id, vol.volume_id)
                continue

            # Score candidate targets
            best_node: NodeState | None = None
            best_score = -1.0

            for node in node_states.values():
                if node.node_id == vol.node_id:
                    continue
                if node.util_pct >= self.max_target_util:
                    continue
                if node.free_capacity_gb < vol.size_gb:
                    continue

                util_headroom = (self.max_target_util - node.util_pct) / self.max_target_util
                t_score = tier_score(vol.workload_class, node.tier)
                score = 0.6 * util_headroom + 0.4 * t_score

                if score > best_score:
                    best_score = score
                    best_node = node

            if best_node is None:
                logger.warning("No feasible target for volume %s (size=%.1fGB)",
                               vol.volume_id, vol.size_gb)
                continue

            # Simulate the move
            vol_util_contribution = vol.iops_demand / max(source.iops_headroom + vol.iops_demand, 1) * source.util_pct
            source.util_pct = max(0.0, source.util_pct - vol_util_contribution * 0.8)
            source.free_capacity_gb += vol.size_gb
            if vol.volume_id in source.volumes:
                source.volumes.remove(vol.volume_id)

            best_node.util_pct = min(100.0, best_node.util_pct + vol_util_contribution * 0.8)
            best_node.free_capacity_gb -= vol.size_gb
            best_node.volumes.append(vol.volume_id)

            # Estimate move duration: assume 500 MB/s migration bandwidth
            migration_bw_mbps = 500.0
            duration_s = (vol.size_gb * 1024) / migration_bw_mbps

            moves.append(MoveOp(
                op_id=str(uuid.uuid4()),
                volume_id=vol.volume_id,
                source_node=vol.node_id,
                target_node=best_node.node_id,
                size_gb=vol.size_gb,
                estimated_duration_s=round(duration_s, 1),
                reason=f"Load rebalance: score={best_score:.3f} tier={best_node.tier}",
                priority=vol.priority,
            ))

            logger.info("Planned move: vol=%s %s→%s size=%.1fGB score=%.3f",
                        vol.volume_id, vol.node_id, best_node.node_id,
                        vol.size_gb, best_score)

        total_gb = sum(m.size_gb for m in moves)
        total_duration = sum(m.estimated_duration_s for m in moves) / max(len(moves), 1)  # parallel
        projected_max_util = max((n.util_pct for n in node_states.values()), default=0.0)

        return MovePlan(
            plan_id=plan_id,
            timestamp_utc=now,
            moves=moves,
            total_data_gb=round(total_gb, 2),
            estimated_total_duration_s=round(total_duration, 1),
            projected_max_util_pct=round(projected_max_util, 2),
            feasible=True,
        )


#  LP Solver (optional, more optimal) 

class LPRebalancer:
    """
    Linear-program based rebalancer using scipy.optimize.
    More computationally expensive but provably optimal.
    Falls back to GreedyRebalancer if scipy is unavailable.
    """

    def plan(
        self,
        volumes_to_move: list[VolumeInfo],
        nodes: list[NodeState],
    ) -> MovePlan:
        try:
            from scipy.optimize import linprog
        except ImportError:
            logger.warning("scipy not available, falling back to greedy rebalancer")
            return GreedyRebalancer().plan(volumes_to_move, nodes)

        # For now, delegate to greedy — LP formulation is a future enhancement
        logger.info("LP rebalancer: delegating to greedy (LP formulation TBD)")
        return GreedyRebalancer().plan(volumes_to_move, nodes)


#  Factory 

def get_rebalancer(algorithm: str = "greedy_load_aware") -> GreedyRebalancer | LPRebalancer:
    if algorithm == "lp_solver":
        return LPRebalancer()
    return GreedyRebalancer()
