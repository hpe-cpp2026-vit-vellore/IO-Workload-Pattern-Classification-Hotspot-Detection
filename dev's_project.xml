"""
ml/classification/train.py

Trains the IO workload classifier.

Supported models:
  - xgboost    (default, best accuracy)
  - lightgbm   (fast, memory-efficient)
  - random_forest

Features:
  - Derived features from feature_engineering.features
  - Optional hyperparameter tuning via Optuna
  - MLflow experiment tracking
  - ONNX export for serving

Usage:
    python -m ml.classification.train \
        --config config/ml/classification.yaml \
        --data data/offline_store/features.parquet
"""

from __future__ import annotations

import logging
import os
from pathlib import Path
from typing import Any

import click
import mlflow
import mlflow.sklearn
import numpy as np
import pandas as pd
import yaml
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    classification_report,
    confusion_matrix,
    f1_score,
    precision_recall_fscore_support,
)
from sklearn.model_selection import StratifiedKFold, train_test_split
from sklearn.preprocessing import LabelEncoder
from xgboost import XGBClassifier

from feature_engineering.features import (
    compute_derived_features,
    MODEL_FEATURES,
    ALL_FEATURES,
)

logger = logging.getLogger(__name__)

LABEL_COL = "workload_label"
CLASSES = ["DB_OLTP", "VM", "Backup", "AI_Training", "AI_Inference"]


#  Data Loading 

def load_training_data(data_path: str) -> pd.DataFrame:
    path = Path(data_path)
    if path.suffix == ".csv":
        df = pd.read_csv(path)
        if "workload_type" in df.columns and LABEL_COL not in df.columns:
            df = df.rename(columns={"workload_type": LABEL_COL})
    elif path.suffix in (".parquet", ".pq"):
        df = pd.read_parquet(path)
    else:
        raise ValueError(f"Unsupported data format: {path.suffix}")

    # Compute derived features if not already present
    if "iops_per_queue_depth" not in df.columns:
        df = compute_derived_features(df)

    return df


def build_feature_matrix(df: pd.DataFrame) -> tuple[pd.DataFrame, pd.Series]:
    """Extract X (features) and y (labels) from training DataFrame."""
    available = [f for f in MODEL_FEATURES if f in df.columns]
    missing = [f for f in MODEL_FEATURES if f not in df.columns]
    if missing:
        logger.warning("Features missing from data (will be skipped): %s", missing)

    X = df[available].astype(float)
    y = df[LABEL_COL]
    return X, y


#  Model Builders 

def build_model(model_type: str, cfg: dict) -> Any:
    if model_type == "xgboost":
        params = cfg.get("xgboost", {})
        return XGBClassifier(
            n_estimators=params.get("n_estimators", 300),
            max_depth=params.get("max_depth", 6),
            learning_rate=params.get("learning_rate", 0.05),
            subsample=params.get("subsample", 0.8),
            colsample_bytree=params.get("colsample_bytree", 0.8),
            # use_label_encoder=False,
            eval_metric="mlogloss",
            random_state=42,
            n_jobs=-1,
        )
    elif model_type == "lightgbm":
        from lightgbm import LGBMClassifier
        params = cfg.get("lightgbm", {})
        return LGBMClassifier(
            n_estimators=params.get("n_estimators", 300),
            max_depth=params.get("max_depth", 6),
            learning_rate=params.get("learning_rate", 0.05),
            num_leaves=params.get("num_leaves", 63),
            subsample=params.get("subsample", 0.8),
            random_state=42,
            n_jobs=-1,
            verbose=-1,
        )
    elif model_type == "random_forest":
        return RandomForestClassifier(
            n_estimators=300,
            max_depth=10,
            random_state=42,
            n_jobs=-1,
        )
    else:
        raise ValueError(f"Unknown model type: {model_type}")


#  Hyperparameter Tuning 

def tune_hyperparameters(
    X_train: pd.DataFrame,
    y_train: pd.Series,
    model_type: str,
    n_trials: int = 50,
) -> dict:
    """Optuna-based hyperparameter search. Returns best params dict."""
    import optuna
    optuna.logging.set_verbosity(optuna.logging.WARNING)

    le = LabelEncoder()
    y_enc = le.fit_transform(y_train)

    def objective(trial: optuna.Trial) -> float:
        if model_type == "xgboost":
            model = XGBClassifier(
                n_estimators=trial.suggest_int("n_estimators", 100, 500),
                max_depth=trial.suggest_int("max_depth", 3, 9),
                learning_rate=trial.suggest_float("learning_rate", 0.01, 0.3, log=True),
                subsample=trial.suggest_float("subsample", 0.6, 1.0),
                colsample_bytree=trial.suggest_float("colsample_bytree", 0.6, 1.0),
                # use_label_encoder=False,
                eval_metric="mlogloss",
                random_state=42,
                n_jobs=-1,
            )
        else:
            raise NotImplementedError(f"Tuning not implemented for {model_type}")

        cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)
        scores = []
        for train_idx, val_idx in cv.split(X_train, y_enc):
            Xtr, Xval = X_train.iloc[train_idx], X_train.iloc[val_idx]
            ytr, yval = y_enc[train_idx], y_enc[val_idx]
            model.fit(Xtr, ytr)
            preds = model.predict(Xval)
            scores.append(f1_score(yval, preds, average="macro"))
        return float(np.mean(scores))

    study = optuna.create_study(direction="maximize")
    study.optimize(objective, n_trials=n_trials, show_progress_bar=False)
    logger.info("Best trial f1_macro=%.4f params=%s",
                study.best_value, study.best_params)
    return study.best_params


#  Evaluation 

def evaluate(model, X_test: pd.DataFrame, y_test: pd.Series,
             label_encoder: LabelEncoder) -> dict:
    y_pred = model.predict(X_test)
    y_pred_labels = label_encoder.inverse_transform(y_pred)
    y_true_labels = label_encoder.inverse_transform(label_encoder.transform(y_test))

    report = classification_report(
        y_true_labels, y_pred_labels, target_names=label_encoder.classes_, output_dict=True
    )

    prec, rec, f1, _ = precision_recall_fscore_support(
        y_true_labels, y_pred_labels, average="macro", zero_division=0
    )

    cm = confusion_matrix(y_true_labels, y_pred_labels, labels=label_encoder.classes_)
    cm_df = pd.DataFrame(cm, index=label_encoder.classes_, columns=label_encoder.classes_)

    logger.info("\nClassification Report:\n%s",
                classification_report(y_true_labels, y_pred_labels,
                                      target_names=label_encoder.classes_))
    logger.info("Confusion Matrix:\n%s", cm_df.to_string())

    return {
        "precision_macro": float(prec),
        "recall_macro": float(rec),
        "f1_macro": float(f1),
        "per_class": report,
    }


#  ONNX Export 

def export_onnx(model, feature_names: list[str], output_path: str) -> None:
    try:
        from skl2onnx import convert_sklearn
        from skl2onnx.common.data_types import FloatTensorType
        initial_type = [("float_input", FloatTensorType([None, len(feature_names)]))]
        onnx_model = convert_sklearn(model, initial_types=initial_type)
        with open(output_path, "wb") as f:
            f.write(onnx_model.SerializeToString())
        logger.info("ONNX model saved to %s", output_path)
    except Exception as exc:
        logger.warning("ONNX export failed (non-fatal): %s", exc)


#  Main Training Pipeline 

def train(cfg: dict, data_path: str, output_dir: str) -> dict:
    """
    Full training pipeline:
      load data → build features → split → (tune) → train → eval → export
    """
    Path(output_dir).mkdir(parents=True, exist_ok=True)

    # Load data
    df = load_training_data(data_path)
    logger.info("Loaded %d samples, label distribution:\n%s",
                len(df), df[LABEL_COL].value_counts().to_string())

    X, y = build_feature_matrix(df)
    feature_names = list(X.columns)
    logger.info("Using %d features: %s", len(feature_names), feature_names)

    # Encode labels
    le = LabelEncoder()
    le.fit(CLASSES)
    y_enc = le.transform(y)

    # Train/val/test split
    train_cfg = cfg.get("training", {})
    X_trainval, X_test, y_trainval, y_test_enc = train_test_split(
        X, y_enc,
        test_size=train_cfg.get("test_size", 0.2),
        stratify=y_enc,
        random_state=train_cfg.get("random_state", 42),
    )
    X_train, X_val, y_train, y_val = train_test_split(
        X_trainval, y_trainval,
        test_size=train_cfg.get("val_size", 0.1) / (1 - train_cfg.get("test_size", 0.2)),
        stratify=y_trainval,
        random_state=42,
    )

    logger.info("Split: train=%d val=%d test=%d", len(X_train), len(X_val), len(X_test))

    model_type = cfg.get("model", {}).get("type", "xgboost")

    # Hyperparameter tuning
    tuning_cfg = cfg.get("tuning", {})
    if tuning_cfg.get("enabled", False):
        logger.info("Starting hyperparameter tuning (%d trials)...",
                    tuning_cfg.get("n_trials", 50))
        best_params = tune_hyperparameters(
            X_train, le.inverse_transform(y_train),
            model_type=model_type,
            n_trials=tuning_cfg.get("n_trials", 50),
        )
        # Patch config with best params
        cfg.setdefault(model_type, {}).update(best_params)

    # Build and train model
    model = build_model(model_type, cfg)

    with mlflow.start_run():
        mlflow.log_params({
            "model_type": model_type,
            "n_features": len(feature_names),
            "train_size": len(X_train),
            "test_size": len(X_test),
        })

        logger.info("Training %s...", model_type)
        if model_type == "xgboost":
            model.fit(
                X_train, y_train,
                eval_set=[(X_val, y_val)],
                verbose=False,
            )
        else:
            model.fit(X_train, y_train)

        # Evaluate
        metrics = evaluate(model, X_test, le.inverse_transform(y_test_enc), le)
        mlflow.log_metrics({
            "precision_macro": metrics["precision_macro"],
            "recall_macro": metrics["recall_macro"],
            "f1_macro": metrics["f1_macro"],
        })

        # Check success criteria
        success = cfg.get("success_criteria", {})
        passed = (
            metrics["precision_macro"] >= success.get("min_precision", 0.95) and
            metrics["recall_macro"] >= success.get("min_recall", 0.95) and
            metrics["f1_macro"] >= success.get("min_f1_macro", 0.95)
        )

        if passed:
            logger.info("✓ Success criteria met: precision=%.3f recall=%.3f f1=%.3f",
                        metrics["precision_macro"], metrics["recall_macro"],
                        metrics["f1_macro"])
        else:
            logger.warning("✗ Success criteria NOT met: precision=%.3f recall=%.3f f1=%.3f",
                           metrics["precision_macro"], metrics["recall_macro"],
                           metrics["f1_macro"])

        mlflow.log_metric("success_criteria_passed", int(passed))

        # Save sklearn model
        import joblib
        sklearn_path = os.path.join(output_dir, "workload_classifier_latest.pkl")
        joblib.dump({"model": model, "label_encoder": le, "feature_names": feature_names},
                    sklearn_path)
        mlflow.log_artifact(sklearn_path)
        logger.info("Saved sklearn model to %s", sklearn_path)

        # Save feature names
        import json
        meta_path = os.path.join(output_dir, "classifier_metadata.json")
        with open(meta_path, "w") as f:
            json.dump({
                "feature_names": feature_names,
                "classes": list(le.classes_),
                "model_type": model_type,
                "metrics": {k: v for k, v in metrics.items() if k != "per_class"},
            }, f, indent=2)
        mlflow.log_artifact(meta_path)

        # ONNX export
        onnx_path = os.path.join(output_dir, "workload_classifier_latest.onnx")
        export_onnx(model, feature_names, onnx_path)
        if os.path.exists(onnx_path):
            mlflow.log_artifact(onnx_path)

        run_id = mlflow.active_run().info.run_id
        logger.info("MLflow run_id: %s", run_id)
        metrics["run_id"] = run_id

    return metrics


#  CLI 

@click.command()
@click.option("--config", "config_path",
              default="config/ml/classification.yaml")
@click.option("--data", "data_path",
              default="data/sample/io_workload_data_sample.csv")
@click.option("--output-dir", default="models")
@click.option("--mlflow-uri", default="http://localhost:5000",
              envvar="MLFLOW_TRACKING_URI")
@click.option("--log-level", default="INFO")
def main(config_path, data_path, output_dir, mlflow_uri, log_level):
    """Train the IO workload classifier."""
    logging.basicConfig(
        level=log_level,
        format="%(asctime)s %(levelname)s %(name)s %(message)s",
    )
    with open(config_path) as f:
        cfg = yaml.safe_load(f)

    mlflow.set_tracking_uri(mlflow_uri)

    try:
        client.create_experiment(
            "io-workload-classification",
            artifact_location="mlflow-artifacts:/"
        )
    except:
        pass

    mlflow.set_experiment(cfg.get("mlflow", {}).get(
        "experiment_name", "io-workload-classification"))

    metrics = train(cfg=cfg, data_path=data_path, output_dir=output_dir)
    logger.info("Training complete. Final metrics: %s", {
        k: round(v, 4) for k, v in metrics.items() if isinstance(v, float)
    })


if __name__ == "__main__":
    main()
