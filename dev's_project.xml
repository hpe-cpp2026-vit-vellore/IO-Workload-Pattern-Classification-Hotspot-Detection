# config/ml/classification.yaml

model:
  type: "xgboost"           # options: xgboost, lightgbm, random_forest, ensemble
  version: "v1"

features:
  numeric:
    - iops
    - throughput_mbps
    - latency_us
    - read_ratio
    - block_size_kb
    - queue_depth
    - disk_util_pct
  # Derived features computed by feature_engineering:
  derived:
    - iops_per_queue_depth
    - throughput_per_iops         # effective block size proxy
    - latency_iops_product        # congestion signal
    - read_write_asymmetry        # |read_ratio - 0.5|

target: "workload_type"

classes:
  - DB_OLTP
  - VM
  - Backup
  - AI_Training
  - AI_Inference

training:
  test_size: 0.2
  val_size: 0.1
  stratify: true
  random_state: 42
  cv_folds: 5

xgboost:
  n_estimators: 300
  max_depth: 6
  learning_rate: 0.05
  subsample: 0.8
  colsample_bytree: 0.8
  use_label_encoder: false
  eval_metric: "mlogloss"

lightgbm:
  n_estimators: 300
  max_depth: 6
  learning_rate: 0.05
  num_leaves: 63
  subsample: 0.8

tuning:
  enabled: true
  n_trials: 50
  metric: "f1_macro"
  direction: "maximize"

export:
  onnx: true
  sklearn_pkl: true
  output_dir: "./models"

success_criteria:
  min_precision: 0.95
  min_recall: 0.95
  min_f1_macro: 0.95
