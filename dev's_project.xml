"""
tests/unit/test_decision_engine.py
"""

import time
import pytest

from decision_engine.engine import (
    DecisionEngine,
    PolicyConstraints,
    ActionType,
    ActionStatus,
    CooldownTracker,
)


def _constraints(**kwargs):
    defaults = dict(dry_run=True, cooldown_seconds=0)
    return PolicyConstraints(**{**defaults, **kwargs})


def _hotspot(severity="CRITICAL", util=97.0, latency=18_000.0,
             volume_id="vol-001", node_id="node-01", impact=25.0):
    return {
        "volume_id": volume_id,
        "node_id": node_id,
        "severity": severity,
        "metrics_snapshot": {
            "disk_util_pct": util,
            "latency_us": latency,
            "iops": 50_000,
            "throughput_mbps": 200,
        },
        "estimated_impact_pct": impact,
    }


def _forecast(capacity_warning="CRITICAL", latency_risk="HIGH",
              dtf=4.0, breach_prob=0.9, volume_id="vol-002"):
    return {
        "volume_id": volume_id,
        "node_id": "node-02",
        "summary": {
            "capacity_warning": capacity_warning,
            "latency_risk": latency_risk,
            "days_to_fill": dtf,
            "slo_breach_probability": breach_prob,
            "p99_bandwidth_mbps": 900,
        },
    }


class TestDecisionEngineHotspot:
    def test_critical_hotspot_generates_rebalance(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_hotspot_event(_hotspot(severity="CRITICAL"))
        assert action is not None
        assert action.action_type == ActionType.REBALANCE_VOLUME.value

    def test_critical_hotspot_is_priority_1(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_hotspot_event(_hotspot(severity="CRITICAL"))
        assert action.priority == 1

    def test_high_hotspot_rebalance_priority_2(self):
        engine = DecisionEngine(
            constraints=_constraints(max_node_util_pct=85.0)
        )
        action = engine.on_hotspot_event(
            _hotspot(severity="HIGH", util=90.0, latency=500.0)
        )
        assert action is not None
        assert action.priority == 2

    def test_medium_hotspot_generates_qos_action(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_hotspot_event(_hotspot(severity="MEDIUM", latency=1000.0, util=60.0))
        assert action is not None
        assert action.action_type == ActionType.APPLY_QOS.value

    def test_low_hotspot_generates_no_action(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_hotspot_event(_hotspot(severity="LOW", latency=500.0, util=40.0))
        assert action is None

    def test_slo_violated_flag_set_on_latency_breach(self):
        engine = DecisionEngine(
            constraints=_constraints(max_p99_latency_us=5_000)
        )
        action = engine.on_hotspot_event(_hotspot(latency=18_000.0))
        assert action is not None
        assert action.slo_violated is True

    def test_slo_not_violated_below_threshold(self):
        engine = DecisionEngine(
            constraints=_constraints(max_p99_latency_us=5_000)
        )
        action = engine.on_hotspot_event(
            _hotspot(severity="CRITICAL", latency=2_000.0)
        )
        if action:
            assert action.slo_violated is False

    def test_action_has_required_fields(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_hotspot_event(_hotspot())
        assert action is not None
        assert action.action_id
        assert action.timestamp_utc
        assert action.volume_id == "vol-001"
        assert action.node_id == "node-01"


class TestDecisionEngineForecast:
    def test_critical_capacity_triggers_tier_migrate(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_forecast_result(_forecast(capacity_warning="CRITICAL", dtf=4.0))
        assert action is not None
        assert action.action_type == ActionType.TIER_MIGRATE.value

    def test_ok_capacity_no_action(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_forecast_result(
            _forecast(capacity_warning="OK", latency_risk="LOW",
                      dtf=120.0, breach_prob=0.02)
        )
        assert action is None

    def test_high_latency_risk_triggers_rebalance(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_forecast_result(
            _forecast(capacity_warning="OK", latency_risk="CRITICAL",
                      dtf=90.0, breach_prob=0.9)
        )
        assert action is not None
        assert action.action_type == ActionType.REBALANCE_VOLUME.value

    def test_low_breach_prob_no_action(self):
        engine = DecisionEngine(constraints=_constraints())
        action = engine.on_forecast_result(
            _forecast(capacity_warning="WARNING", latency_risk="HIGH",
                      dtf=25.0, breach_prob=0.2)
        )
        assert action is None  # breach_prob < 0.5 threshold


class TestCooldownTracker:
    def test_can_act_initially(self):
        tracker = CooldownTracker(default_cooldown_s=60)
        assert tracker.can_act("vol-001") is True

    def test_cannot_act_immediately_after_record(self):
        tracker = CooldownTracker(default_cooldown_s=60)
        tracker.record_action("vol-001")
        assert tracker.can_act("vol-001") is False

    def test_can_act_after_cooldown_expires(self):
        tracker = CooldownTracker(default_cooldown_s=0)
        tracker.record_action("vol-001")
        time.sleep(0.01)
        assert tracker.can_act("vol-001") is True

    def test_cooldown_independent_per_volume(self):
        tracker = CooldownTracker(default_cooldown_s=60)
        tracker.record_action("vol-001")
        assert tracker.can_act("vol-001") is False
        assert tracker.can_act("vol-002") is True  # different volume


class TestMaxConcurrentMoves:
    def test_blocked_when_at_capacity(self):
        engine = DecisionEngine(
            constraints=_constraints(max_concurrent_moves=1, cooldown_seconds=0)
        )
        # First action succeeds (dry_run doesn't add to _active_moves)
        # We need to test with dry_run=False and mock
        # This test validates the guard logic via constraints
        engine.constraints.max_concurrent_moves = 0
        action = engine.on_hotspot_event(_hotspot(severity="CRITICAL"))
        assert action is None
