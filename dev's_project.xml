<file path="inference/serving/app.py">
"""
inference/serving/app.py

FastAPI inference server exposing:
  POST /classify          — workload classification
  POST /detect-hotspot    — hotspot detection
  POST /forecast          — capacity + performance forecast
  GET  /health            — liveness probe
  GET  /metrics           — Prometheus metrics

Usage:
    uvicorn inference.serving.app:app --host 0.0.0.0 --port 8080
"""

from __future__ import annotations

import json
import logging
import os
import time
from contextlib import asynccontextmanager
from pathlib import Path
from typing import Any

import joblib
import numpy as np
import pandas as pd
from fastapi import FastAPI, HTTPException, Request
from fastapi.responses import PlainTextResponse
from prometheus_client import Counter, Histogram, generate_latest, CONTENT_TYPE_LATEST
from pydantic import BaseModel, Field

from feature_engineering.features import prepare_feature_vector, MODEL_FEATURES
from ml.hotspot_detection.detector import HotspotDetector, RuleBasedHotspotDetector

logger = logging.getLogger(__name__)

#  Prometheus Metrics ─

REQUEST_COUNT = Counter(
    "inference_requests_total",
    "Total inference requests",
    ["endpoint", "status"],
)
REQUEST_LATENCY = Histogram(
    "inference_latency_seconds",
    "Inference latency",
    ["endpoint"],
    buckets=[0.001, 0.005, 0.01, 0.025, 0.05, 0.1, 0.5, 1.0],
)
CLASSIFICATION_DIST = Counter(
    "classification_predictions_total",
    "Workload classification distribution",
    ["predicted_class"],
)
HOTSPOT_EVENTS = Counter(
    "hotspot_events_total",
    "Hotspot events detected",
    ["severity"],
)


#  Request / Response Models 

class TelemetryInput(BaseModel):
    volume_id: str = Field(..., description="Volume / LUN identifier")
    node_id: str = Field(default="unknown")
    iops: float = Field(..., ge=0)
    throughput_mbps: float = Field(..., ge=0)
    latency_us: float = Field(..., ge=0)
    read_ratio: float = Field(..., ge=0, le=1)
    block_size_kb: float = Field(..., ge=0)
    queue_depth: int = Field(..., ge=0)
    disk_util_pct: float = Field(..., ge=0, le=100)


class ClassificationResponse(BaseModel):
    volume_id: str
    predicted_class: str
    confidence: float
    probabilities: dict[str, float]
    latency_ms: float


class HotspotResponse(BaseModel):
    volume_id: str
    is_hotspot: bool
    severity: str
    anomaly_score: float
    rule_triggered: str | None
    estimated_impact_pct: float
    latency_ms: float


class ForecastRequest(BaseModel):
    volume_id: str
    history: list[dict] = Field(..., description="List of historical telemetry rows")
    horizon_hours: int = Field(default=72, ge=1, le=720)


class ForecastResponse(BaseModel):
    volume_id: str
    days_to_fill: float | None
    capacity_warning: str
    p99_bandwidth_mbps: float
    latency_risk: str
    slo_breach_probability: float
    latency_ms: float


#  Model Registry 

class ModelRegistry:
    """
    Loads and holds references to all inference models.
    """

    def __init__(self, model_dir: str = "./models") -> None:
        self.model_dir = Path(model_dir)
        self.classifier = None
        self.label_encoder = None
        self.feature_names: list[str] = []
        self.hotspot_detector: HotspotDetector | None = None

    def load(self) -> None:
        # Classification model
        clf_path = self.model_dir / "workload_classifier_latest.pkl"
        if clf_path.exists():
            bundle = joblib.load(clf_path)
            self.classifier = bundle["model"]
            self.label_encoder = bundle["label_encoder"]
            self.feature_names = bundle["feature_names"]
            logger.info("Loaded classifier from %s (features=%d)",
                        clf_path, len(self.feature_names))
        else:
            logger.warning("Classifier model not found at %s — serving in stub mode", clf_path)

        # Hotspot detector (ML component optional)
        self.hotspot_detector = HotspotDetector(
            rule_detector=RuleBasedHotspotDetector(),
        )
        hotspot_ml_path = self.model_dir / "hotspot_detector_latest.pkl"
        if hotspot_ml_path.exists():
            self.hotspot_detector.load_ml(str(hotspot_ml_path))
            logger.info("Loaded hotspot ML model from %s", hotspot_ml_path)

    def is_ready(self) -> bool:
        return self.hotspot_detector is not None

    def classify(self, features: dict) -> tuple[str, float, dict[str, float]]:
        """Returns (predicted_class, confidence, {class: prob})."""
        if self.classifier is None:
            return "UNKNOWN", 0.0, {}

        X = np.array([[features.get(f, 0.0) for f in self.feature_names]])
        proba = self.classifier.predict_proba(X)[0]
        classes = self.label_encoder.classes_
        pred_idx = int(np.argmax(proba))

        return (
            str(classes[pred_idx]),
            float(proba[pred_idx]),
            {str(c): round(float(p), 4) for c, p in zip(classes, proba)},
        )


#  App Lifespan

registry = ModelRegistry(model_dir=os.getenv("MODEL_DIR", "./models"))


@asynccontextmanager
async def lifespan(app: FastAPI):
    logger.info("Loading models...")
    registry.load()
    logger.info("Models loaded. Server ready.")
    yield
    logger.info("Shutting down inference server.")


app = FastAPI(
    title="IO Workload Inference Hub",
    description="Real-time workload classification, hotspot detection, and forecasting.",
    version="1.0.0",
    lifespan=lifespan,
)


#  Middleware 

@app.middleware("http")
async def record_metrics(request: Request, call_next):
    start = time.perf_counter()
    response = await call_next(request)
    elapsed = time.perf_counter() - start
    endpoint = request.url.path
    REQUEST_COUNT.labels(endpoint=endpoint, status=str(response.status_code)).inc()
    REQUEST_LATENCY.labels(endpoint=endpoint).observe(elapsed)
    return response


#  Endpoints

@app.get("/health")
def health():
    return {"status": "ok", "model_ready": registry.is_ready()}


@app.get("/metrics", response_class=PlainTextResponse)
def metrics():
    return PlainTextResponse(
        generate_latest(),
        media_type=CONTENT_TYPE_LATEST,
    )


@app.post("/classify", response_model=ClassificationResponse)
def classify(input_data: TelemetryInput):
    t0 = time.perf_counter()

    raw = input_data.model_dump()
    features = prepare_feature_vector(raw)

    predicted_class, confidence, probabilities = registry.classify(features)
    CLASSIFICATION_DIST.labels(predicted_class=predicted_class).inc()

    return ClassificationResponse(
        volume_id=input_data.volume_id,
        predicted_class=predicted_class,
        confidence=round(confidence, 4),
        probabilities=probabilities,
        latency_ms=round((time.perf_counter() - t0) * 1000, 3),
    )


@app.post("/detect-hotspot", response_model=HotspotResponse)
def detect_hotspot(input_data: TelemetryInput):
    t0 = time.perf_counter()

    if registry.hotspot_detector is None:
        raise HTTPException(status_code=503, detail="Hotspot detector not loaded")

    metric = input_data.model_dump()
    features = prepare_feature_vector(metric)
    metric.update(features)

    event = registry.hotspot_detector.detect(metric)

    if event:
        HOTSPOT_EVENTS.labels(severity=event.severity).inc()
        return HotspotResponse(
            volume_id=input_data.volume_id,
            is_hotspot=True,
            severity=event.severity,
            anomaly_score=event.anomaly_score,
            rule_triggered=event.rule_triggered,
            estimated_impact_pct=event.estimated_impact_pct,
            latency_ms=round((time.perf_counter() - t0) * 1000, 3),
        )
    else:
        return HotspotResponse(
            volume_id=input_data.volume_id,
            is_hotspot=False,
            severity="NONE",
            anomaly_score=0.0,
            rule_triggered=None,
            estimated_impact_pct=0.0,
            latency_ms=round((time.perf_counter() - t0) * 1000, 3),
        )


@app.post("/forecast", response_model=ForecastResponse)
def forecast(request: ForecastRequest):
    t0 = time.perf_counter()

    from ml.forecasting.forecaster import ForecastingPipeline

    history_df = pd.DataFrame(request.history)
    if history_df.empty:
        raise HTTPException(status_code=400, detail="Empty history provided")

    pipeline = ForecastingPipeline(horizon_hours=request.horizon_hours)
    result = pipeline.run(volume_id=request.volume_id, history=history_df)
    summary = result["summary"]

    return ForecastResponse(
        volume_id=request.volume_id,
        days_to_fill=summary.get("days_to_fill"),
        capacity_warning=summary["capacity_warning"],
        p99_bandwidth_mbps=summary["p99_bandwidth_mbps"],
        latency_risk=summary["latency_risk"],
        slo_breach_probability=summary["slo_breach_probability"],
        latency_ms=round((time.perf_counter() - t0) * 1000, 3),
    )
