"""
tests/unit/test_rebalancer.py
"""

import pytest
from rebalancer.optimizer import (
    GreedyRebalancer,
    VolumeInfo,
    NodeState,
    MovePlan,
    tier_score,
)


def _nodes():
    return [
        NodeState("node-01", util_pct=88, free_capacity_gb=200,
                  iops_headroom=5_000, tier="nvme_low_latency",
                  volumes=["vol-001", "vol-002"]),
        NodeState("node-02", util_pct=40, free_capacity_gb=2_000,
                  iops_headroom=40_000, tier="nvme_high_throughput",
                  volumes=["vol-003"]),
        NodeState("node-03", util_pct=50, free_capacity_gb=1_000,
                  iops_headroom=20_000, tier="sas",
                  volumes=["vol-004"]),
    ]


def _vol(vol_id="vol-001", node_id="node-01", size_gb=50,
         workload_class="DB_OLTP", priority=2):
    return VolumeInfo(
        volume_id=vol_id, node_id=node_id, size_gb=size_gb,
        iops_demand=5_000, throughput_mbps=100,
        workload_class=workload_class, priority=priority,
    )


class TestTierScore:
    def test_db_oltp_prefers_nvme_low_latency(self):
        assert tier_score("DB_OLTP", "nvme_low_latency") == 1.0

    def test_backup_prefers_sas_as_top_tier(self):
        # TIER_AFFINITY["Backup"] = ["sas", "object", "nvme_high_throughput"]
        assert tier_score("Backup", "sas") == 1.0
        assert tier_score("Backup", "object") > 0.0
        assert tier_score("Backup", "sas") > tier_score("Backup", "object")

    def test_unknown_tier_returns_zero(self):
        assert tier_score("DB_OLTP", "tape") == 0.0

    def test_lower_preference_gets_lower_score(self):
        score_best  = tier_score("AI_Training", "nvme_high_throughput")
        score_worst = tier_score("AI_Training", "sas")
        assert score_best > score_worst


class TestGreedyRebalancer:
    def setup_method(self):
        self.rebalancer = GreedyRebalancer(
            max_target_util_pct=80.0,
            max_concurrent_moves=5,
            max_bytes_per_move_gb=500.0,
        )

    def test_returns_move_plan(self):
        plan = self.rebalancer.plan([_vol()], _nodes())
        assert isinstance(plan, MovePlan)

    def test_plan_is_feasible(self):
        plan = self.rebalancer.plan([_vol()], _nodes())
        assert plan.feasible

    def test_moves_away_from_overloaded_node(self):
        plan = self.rebalancer.plan([_vol(node_id="node-01")], _nodes())
        assert len(plan.moves) > 0
        assert all(m.source_node == "node-01" for m in plan.moves)
        assert all(m.target_node != "node-01" for m in plan.moves)

    def test_does_not_move_to_overloaded_target(self):
        nodes = _nodes()
        # Make all nodes overloaded except one
        nodes[1].util_pct = 82.0
        nodes[2].util_pct = 82.0
        plan = self.rebalancer.plan([_vol()], nodes)
        for m in plan.moves:
            target = next(n for n in nodes if n.node_id == m.target_node)
            assert target.util_pct < self.rebalancer.max_target_util

    def test_respects_capacity_constraint(self):
        # Vol is 300 GB but target only has 100 GB free
        nodes = _nodes()
        nodes[1].free_capacity_gb = 100.0
        nodes[2].free_capacity_gb = 100.0
        plan = self.rebalancer.plan([_vol(size_gb=300)], nodes)
        # No target has enough capacity — should produce 0 moves
        assert len(plan.moves) == 0

    def test_respects_max_concurrent_moves(self):
        rebalancer = GreedyRebalancer(max_concurrent_moves=2)
        vols = [_vol(f"vol-{i:03d}") for i in range(5)]
        plan = rebalancer.plan(vols, _nodes())
        assert len(plan.moves) <= 2

    def test_empty_inputs_returns_empty_plan(self):
        plan = self.rebalancer.plan([], _nodes())
        assert plan.moves == []
        assert plan.feasible

    def test_db_oltp_prefers_nvme_low_latency_target(self):
        """DB_OLTP volumes should prefer nvme_low_latency over sas."""
        plan = self.rebalancer.plan(
            [_vol(workload_class="DB_OLTP", node_id="node-01")],
            _nodes(),
        )
        if plan.moves:
            # node-02 is nvme_high_throughput, node-03 is sas
            # DB_OLTP prefers nvme_low_latency first, then nvme_high_throughput
            assert plan.moves[0].target_node == "node-02"

    def test_total_data_gb_is_sum_of_moves(self):
        vols = [_vol("vol-001", size_gb=50), _vol("vol-002", size_gb=80)]
        plan = self.rebalancer.plan(vols, _nodes())
        expected = sum(m.size_gb for m in plan.moves)
        assert abs(plan.total_data_gb - expected) < 0.01
