"""
execution_monitor/monitor.py

Execution Monitor.

Tracks in-flight rebalance/migration operations, enforces rate limits,
detects stalled or failed moves, and triggers rollback when needed.

This is the safety layer between the decision engine and the actuators.
Every action passes through here before and after execution.
"""

from __future__ import annotations

import logging
import threading
import time
import uuid
from dataclasses import asdict, dataclass, field
from datetime import datetime, timezone
from enum import Enum
from typing import Callable

logger = logging.getLogger(__name__)


class MovePhase(str, Enum):
    QUEUED      = "QUEUED"
    PRE_CHECK   = "PRE_CHECK"
    EXECUTING   = "EXECUTING"
    VERIFYING   = "VERIFYING"
    COMPLETED   = "COMPLETED"
    FAILED      = "FAILED"
    ROLLING_BACK = "ROLLING_BACK"
    ROLLED_BACK = "ROLLED_BACK"


@dataclass
class MoveRecord:
    op_id: str
    volume_id: str
    source_node: str
    target_node: str
    size_gb: float
    phase: str = MovePhase.QUEUED.value
    started_at: float | None = None
    completed_at: float | None = None
    bytes_moved_gb: float = 0.0
    error: str | None = None
    rollback_attempted: bool = False

    @property
    def duration_s(self) -> float | None:
        if self.started_at and self.completed_at:
            return self.completed_at - self.started_at
        return None

    @property
    def progress_pct(self) -> float:
        if self.size_gb == 0:
            return 100.0
        return min(100.0, (self.bytes_moved_gb / self.size_gb) * 100)


class ExecutionMonitor:
    """
    Tracks active and historical move operations.

    Thread-safe: multiple actuators can report progress concurrently.
    """

    def __init__(
        self,
        max_concurrent_moves: int = 5,
        stall_timeout_s: float = 600.0,      # 10 min without progress → stalled
        max_rollback_rate: float = 0.01,      # >1% rollback rate triggers alert
        on_completion: Callable | None = None,
        on_failure: Callable | None = None,
    ) -> None:
        self.max_concurrent = max_concurrent_moves
        self.stall_timeout = stall_timeout_s
        self.max_rollback_rate = max_rollback_rate
        self._on_completion = on_completion
        self._on_failure = on_failure

        self._active: dict[str, MoveRecord] = {}        # op_id → record
        self._history: list[MoveRecord] = []
        self._lock = threading.Lock()
        self._last_progress: dict[str, float] = {}      # op_id → epoch of last progress

        # Start watchdog thread
        self._watchdog_thread = threading.Thread(
            target=self._watchdog_loop, daemon=True
        )
        self._watchdog_thread.start()

    # ─── Public API ──────────────────────────────────────────────────────────

    def can_accept(self, volume_id: str) -> bool:
        """True if the monitor can accept a new move for this volume."""
        with self._lock:
            in_flight = len(self._active)
            already_moving = any(r.volume_id == volume_id
                                  for r in self._active.values())
            return in_flight < self.max_concurrent and not already_moving

    def register(self, op_id: str, volume_id: str,
                 source_node: str, target_node: str, size_gb: float) -> MoveRecord:
        """Register a new move operation. Returns the tracking record."""
        record = MoveRecord(
            op_id=op_id,
            volume_id=volume_id,
            source_node=source_node,
            target_node=target_node,
            size_gb=size_gb,
        )
        with self._lock:
            self._active[op_id] = record
            self._last_progress[op_id] = time.time()
        logger.info("Registered move: op_id=%s vol=%s %s→%s size=%.1fGB",
                    op_id, volume_id, source_node, target_node, size_gb)
        return record

    def update_phase(self, op_id: str, phase: MovePhase,
                     bytes_moved_gb: float | None = None) -> None:
        """Called by actuators to report phase transitions and progress."""
        with self._lock:
            record = self._active.get(op_id)
            if record is None:
                logger.warning("update_phase: unknown op_id %s", op_id)
                return

            record.phase = phase.value
            if bytes_moved_gb is not None:
                record.bytes_moved_gb = bytes_moved_gb
            self._last_progress[op_id] = time.time()

            if phase == MovePhase.EXECUTING and record.started_at is None:
                record.started_at = time.time()

            if phase in (MovePhase.COMPLETED, MovePhase.ROLLED_BACK, MovePhase.FAILED):
                record.completed_at = time.time()
                self._finalise(op_id, record)

        logger.debug("op_id=%s vol=%s phase=%s progress=%.1f%%",
                     op_id, record.volume_id if record else "?", phase.value,
                     record.progress_pct if record else 0)

    def mark_failed(self, op_id: str, error: str) -> None:
        """Mark a move as failed (called by actuator on error)."""
        with self._lock:
            record = self._active.get(op_id)
            if record:
                record.error = error
                record.phase = MovePhase.FAILED.value
                record.completed_at = time.time()
                self._finalise(op_id, record)
        logger.error("Move failed: op_id=%s error=%s", op_id, error)

    def get_active(self) -> list[MoveRecord]:
        with self._lock:
            return list(self._active.values())

    def get_stats(self) -> dict:
        with self._lock:
            total = len(self._history)
            completed = sum(1 for r in self._history
                            if r.phase == MovePhase.COMPLETED.value)
            rolled_back = sum(1 for r in self._history
                              if r.phase == MovePhase.ROLLED_BACK.value)
            failed = sum(1 for r in self._history
                         if r.phase == MovePhase.FAILED.value)
            rollback_rate = rolled_back / max(total, 1)

        return {
            "active_moves": len(self._active),
            "total_historical": total,
            "completed": completed,
            "failed": failed,
            "rolled_back": rolled_back,
            "rollback_rate": round(rollback_rate, 4),
            "slo_rollback_breach": rollback_rate > self.max_rollback_rate,
        }

    # ─── Internal ────────────────────────────────────────────────────────────

    def _finalise(self, op_id: str, record: MoveRecord) -> None:
        """Move from active to history. Must be called under lock."""
        self._history.append(record)
        self._active.pop(op_id, None)
        self._last_progress.pop(op_id, None)

        success = record.phase == MovePhase.COMPLETED.value
        if success and self._on_completion:
            threading.Thread(
                target=self._on_completion, args=(op_id, True), daemon=True
            ).start()
        elif not success and self._on_failure:
            threading.Thread(
                target=self._on_failure, args=(op_id, False), daemon=True
            ).start()

    def _watchdog_loop(self) -> None:
        """Periodically checks for stalled moves."""
        while True:
            time.sleep(30)
            now = time.time()
            with self._lock:
                stalled = [
                    op_id for op_id, last in self._last_progress.items()
                    if (now - last) > self.stall_timeout
                    and self._active.get(op_id, MoveRecord("", "", "", "", 0)).phase
                       == MovePhase.EXECUTING.value
                ]

            for op_id in stalled:
                logger.warning("Stalled move detected: op_id=%s (no progress for %.0fs)",
                               op_id, self.stall_timeout)
                self.mark_failed(op_id, f"Stalled: no progress for {self.stall_timeout}s")

            # Log stats periodically
            stats = self.get_stats()
            if stats["active_moves"] > 0 or stats["total_historical"] > 0:
                logger.info("ExecutionMonitor stats: %s", stats)

            if stats["slo_rollback_breach"]:
                logger.critical(
                    "ALERT: Rollback rate %.1f%% exceeds SLO threshold %.1f%%",
                    stats["rollback_rate"] * 100,
                    self.max_rollback_rate * 100,
                )
