<file path="decision_engine/engine.py">
"""
decision_engine/engine.py

Decision & Policy Engine.

Receives classification results, hotspot events, and forecasts,
applies SLO policies and constraints, and emits rebalance/QoS actions.

This is the "brain" of the control plane — it decides WHAT to do,
not how to physically move data (that's the rebalancer/actuators).
"""

from __future__ import annotations

import json
import logging
import time
import uuid
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from enum import Enum
from typing import Any

logger = logging.getLogger(__name__)


class ActionType(str, Enum):
    REBALANCE_VOLUME = "REBALANCE_VOLUME"
    APPLY_QOS        = "APPLY_QOS"
    TIER_MIGRATE     = "TIER_MIGRATE"
    SCALE_OUT        = "SCALE_OUT"
    NO_OP            = "NO_OP"


class ActionStatus(str, Enum):
    PENDING   = "PENDING"
    APPROVED  = "APPROVED"
    EXECUTING = "EXECUTING"
    COMPLETED = "COMPLETED"
    FAILED    = "FAILED"
    ROLLED_BACK = "ROLLED_BACK"


@dataclass
class PolicyConstraints:
    max_p99_latency_us: float = 5000.0
    max_node_util_pct: float = 85.0
    min_free_tier_headroom_pct: float = 15.0
    max_concurrent_moves: int = 5
    max_bytes_per_move_gb: float = 100.0
    cooldown_seconds: int = 300
    approval_required_above_gb: float = 500.0
    dry_run: bool = False


@dataclass
class Action:
    action_id: str
    action_type: str
    timestamp_utc: str
    volume_id: str
    node_id: str
    priority: int                        # 1 (highest) – 5 (lowest)
    status: str
    reason: str
    payload: dict                        # action-specific parameters
    requires_approval: bool = False
    estimated_bytes_gb: float = 0.0
    slo_violated: bool = False

    def to_json(self) -> str:
        return json.dumps(asdict(self))


class CooldownTracker:
    """Tracks per-volume cooldown periods to prevent action thrashing."""

    def __init__(self, default_cooldown_s: int = 300) -> None:
        self.default_cooldown = default_cooldown_s
        self._last_action: dict[str, float] = {}   # volume_id → epoch

    def can_act(self, volume_id: str) -> bool:
        last = self._last_action.get(volume_id, 0)
        return (time.time() - last) >= self.default_cooldown

    def record_action(self, volume_id: str) -> None:
        self._last_action[volume_id] = time.time()

    def seconds_until_ready(self, volume_id: str) -> float:
        last = self._last_action.get(volume_id, 0)
        remaining = self.default_cooldown - (time.time() - last)
        return max(0.0, remaining)


class DecisionEngine:
    """
    Applies SLO policies to incoming signals and generates actions.

    Inputs:
      - Workload classification results
      - Hotspot events
      - Forecast results

    Outputs:
      - Action objects published to Kafka (io.rebalance.actions)
    """

    def __init__(
        self,
        constraints: PolicyConstraints | None = None,
        publisher=None,          # KafkaMetricPublisher or None in tests
    ) -> None:
        self.constraints = constraints or PolicyConstraints()
        self._publisher = publisher
        self._cooldown = CooldownTracker(
            default_cooldown_s=self.constraints.cooldown_seconds
        )
        self._active_moves: dict[str, Action] = {}   # volume_id → active action

    #  Signal Handlers 

    def on_hotspot_event(self, event: dict) -> Action | None:
        """
        Called when a hotspot event is detected.
        Decides whether to rebalance, apply QoS, or wait.
        """
        volume_id = event.get("volume_id", "unknown")
        node_id = event.get("node_id", "unknown")
        severity = event.get("severity", "LOW")

        if not self._cooldown.can_act(volume_id):
            wait = self._cooldown.seconds_until_ready(volume_id)
            logger.debug("Volume %s in cooldown, %.0fs remaining", volume_id, wait)
            return None

        if len(self._active_moves) >= self.constraints.max_concurrent_moves:
            logger.warning("Max concurrent moves reached (%d), queuing %s",
                           self.constraints.max_concurrent_moves, volume_id)
            return None

        metrics = event.get("metrics_snapshot", {})
        util = metrics.get("disk_util_pct", 0)
        latency = metrics.get("latency_us", 0)

        # Determine action type and priority
        if severity == "CRITICAL" or latency > self.constraints.max_p99_latency_us:
            action_type = ActionType.REBALANCE_VOLUME
            priority = 1
            reason = f"CRITICAL hotspot: util={util:.1f}% latency={latency:.0f}µs"
        elif severity == "HIGH" and util > self.constraints.max_node_util_pct:
            action_type = ActionType.REBALANCE_VOLUME
            priority = 2
            reason = f"HIGH hotspot: util={util:.1f}% exceeds SLO {self.constraints.max_node_util_pct}%"
        elif severity in ("HIGH", "MEDIUM"):
            action_type = ActionType.APPLY_QOS
            priority = 3
            reason = f"{severity} hotspot: applying QoS throttle"
        else:
            return None

        action = self._build_action(
            action_type=action_type,
            volume_id=volume_id,
            node_id=node_id,
            priority=priority,
            reason=reason,
            payload={
                "hotspot_severity": severity,
                "current_util_pct": util,
                "current_latency_us": latency,
                "estimated_impact_pct": event.get("estimated_impact_pct", 0),
            },
            slo_violated=(latency > self.constraints.max_p99_latency_us),
        )

        self._emit(action)
        return action

    def on_forecast_result(self, forecast: dict) -> Action | None:
        """
        Called with capacity/performance forecast results.
        Generates proactive actions before SLOs are breached.
        """
        volume_id = forecast.get("volume_id", "unknown")
        summary = forecast.get("summary", {})

        capacity_warning = summary.get("capacity_warning", "OK")
        latency_risk = summary.get("latency_risk", "LOW")
        dtf = summary.get("days_to_fill")
        breach_prob = summary.get("slo_breach_probability", 0.0)

        if capacity_warning == "CRITICAL" or (dtf is not None and dtf < 7):
            action = self._build_action(
                action_type=ActionType.TIER_MIGRATE,
                volume_id=volume_id,
                node_id=forecast.get("node_id", "unknown"),
                priority=2,
                reason=f"Capacity critical: days_to_fill={dtf}",
                payload={"days_to_fill": dtf, "capacity_warning": capacity_warning},
            )
            self._emit(action)
            return action

        if latency_risk in ("HIGH", "CRITICAL") and breach_prob > 0.5:
            action = self._build_action(
                action_type=ActionType.REBALANCE_VOLUME,
                volume_id=volume_id,
                node_id=forecast.get("node_id", "unknown"),
                priority=2,
                reason=f"Forecast latency risk={latency_risk}, breach_prob={breach_prob:.0%}",
                payload={"latency_risk": latency_risk, "breach_probability": breach_prob},
            )
            self._emit(action)
            return action

        return None

    def on_classification_result(self, result: dict) -> Action | None:
        """
        Called with workload classification result.
        Checks if the classified workload type implies a tier/QoS change.
        """
        volume_id = result.get("volume_id", "unknown")
        predicted_class = result.get("predicted_class", "UNKNOWN")
        confidence = result.get("confidence", 0.0)

        if confidence < 0.80:
            return None   # Low-confidence predictions don't trigger actions

        # AI Training workloads benefit from high-throughput tier placement
        if predicted_class == "AI_Training":
            action = self._build_action(
                action_type=ActionType.TIER_MIGRATE,
                volume_id=volume_id,
                node_id=result.get("node_id", "unknown"),
                priority=4,
                reason=f"AI_Training workload detected (conf={confidence:.0%}): prefer high-throughput tier",
                payload={"target_tier": "nvme_high_throughput", "predicted_class": predicted_class},
            )
            self._emit(action)
            return action

        # DB_OLTP benefits from low-latency tier
        if predicted_class == "DB_OLTP":
            action = self._build_action(
                action_type=ActionType.TIER_MIGRATE,
                volume_id=volume_id,
                node_id=result.get("node_id", "unknown"),
                priority=4,
                reason=f"DB_OLTP workload detected (conf={confidence:.0%}): prefer low-latency tier",
                payload={"target_tier": "nvme_low_latency", "predicted_class": predicted_class},
            )
            self._emit(action)
            return action

        return None

    def complete_action(self, action_id: str, success: bool) -> None:
        """Called by execution monitor when an action finishes."""
        for vol_id, action in list(self._active_moves.items()):
            if action.action_id == action_id:
                action.status = (ActionStatus.COMPLETED.value if success
                                  else ActionStatus.FAILED.value)
                self._cooldown.record_action(vol_id)
                del self._active_moves[vol_id]
                logger.info("Action %s %s for volume %s",
                             action_id,
                             "completed" if success else "FAILED",
                             vol_id)
                break

    #  Internal 

    def _build_action(
        self,
        action_type: ActionType,
        volume_id: str,
        node_id: str,
        priority: int,
        reason: str,
        payload: dict,
        slo_violated: bool = False,
        estimated_bytes_gb: float = 0.0,
    ) -> Action:
        requires_approval = (
            estimated_bytes_gb > self.constraints.approval_required_above_gb
        )

        return Action(
            action_id=str(uuid.uuid4()),
            action_type=action_type.value,
            timestamp_utc=datetime.now(timezone.utc).isoformat(),
            volume_id=volume_id,
            node_id=node_id,
            priority=priority,
            status=(ActionStatus.PENDING.value if not self.constraints.dry_run
                    else "DRY_RUN"),
            reason=reason,
            payload=payload,
            requires_approval=requires_approval,
            estimated_bytes_gb=estimated_bytes_gb,
            slo_violated=slo_violated,
        )

    def _emit(self, action: Action) -> None:
        if self.constraints.dry_run:
            logger.info("[DRY RUN] Action: %s", action.to_json())
            return

        self._active_moves[action.volume_id] = action
        self._cooldown.record_action(action.volume_id)

        if self._publisher:
            self._publisher.publish_raw(
                topic="io.rebalance.actions",
                key=action.volume_id,
                value=action.to_json(),
            )

        logger.info("Emitted action: type=%s volume=%s priority=%d reason='%s'",
                    action.action_type, action.volume_id, action.priority, action.reason)
</file>

<file path="deploy/docker/docker-compose.yml">
version: "3.9"

# IO Workload Platform — Local Development Stack
#
# Services:
#   - Kafka + Zookeeper      (message bus)
#   - Redis                  (online feature store)
#   - Postgres               (MLflow backend store)
#   - MLflow                 (experiment tracking)
#   - Prometheus             (metrics scraping)
#   - Grafana                (dashboards)
#
# Usage:
#   docker compose -f deploy/docker/docker-compose.yml up -d

networks:
  io-platform:
    driver: bridge

volumes:
  kafka-data:
  zookeeper-data:
  redis-data:
  postgres-data:
  mlflow-data:
  prometheus-data:
  grafana-data:

services:

  # Zookeeper
  zookeeper:
    image: confluentinc/cp-zookeeper:7.6.0
    container_name: io-zookeeper
    networks: [io-platform]
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    volumes:
      - zookeeper-data:/var/lib/zookeeper/data
    healthcheck:
      test: ["CMD", "echo", "ruok", "|", "nc", "localhost", "2181"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Kafka
  kafka:
    image: confluentinc/cp-kafka:7.6.0
    container_name: io-kafka
    networks: [io-platform]
    depends_on:
      zookeeper:
        condition: service_healthy
    ports:
      - "9092:9092"        # external (host → kafka)
      - "9093:9093"        # internal (container → container)
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9093,PLAINTEXT_HOST://0.0.0.0:9092
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9093,PLAINTEXT_HOST://localhost:9092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "false"
      KAFKA_LOG_RETENTION_HOURS: 168
      KAFKA_COMPRESSION_TYPE: snappy
    volumes:
      - kafka-data:/var/lib/kafka/data
    healthcheck:
      test: ["CMD", "kafka-broker-api-versions", "--bootstrap-server", "localhost:9092"]
      interval: 15s
      timeout: 10s
      retries: 10

  # Kafka UI (optional convenience)
  kafka-ui:
    image: provectuslabs/kafka-ui:latest
    container_name: io-kafka-ui
    networks: [io-platform]
    depends_on:
      kafka:
        condition: service_healthy
    ports:
      - "8090:8080"
    environment:
      KAFKA_CLUSTERS_0_NAME: local
      KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: kafka:9093

  # Redis
  redis:
    image: redis:7.2-alpine
    container_name: io-redis
    networks: [io-platform]
    ports:
      - "6379:6379"
    command: ["redis-server", "--save", "60", "1", "--loglevel", "warning"]
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Postgres
  postgres:
    image: postgres:16-alpine
    container_name: io-postgres
    networks: [io-platform]
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: io_platform
      POSTGRES_USER: io_user
      POSTGRES_PASSWORD: io_password
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U io_user -d io_platform"]
      interval: 10s
      timeout: 5s
      retries: 5

  # MLflow Tracking Server
  mlflow:
    # image: ghcr.io/mlflow/mlflow:v2.13.0
    build:
      context: ../..
      dockerfile: deploy/docker/Dockerfile.mlflow
    container_name: io-mlflow
    networks: [io-platform]
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "5000:5000"
    environment:
      BACKEND_STORE_URI: postgresql://io_user:io_password@postgres:5432/io_platform
      ARTIFACT_ROOT: /mlflow/artifacts
    volumes:
      - mlflow-data:/mlflow/artifacts
    command: >
      mlflow server
      --backend-store-uri postgresql://io_user:io_password@postgres:5432/io_platform
      --default-artifact-root file:///mlflow/artifacts
      --host 0.0.0.0
      --port 5000
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:5000/health"]
      interval: 15s
      timeout: 10s
      retries: 10

  # Prometheus
  prometheus:
    image: prom/prometheus:v2.52.0
    container_name: io-prometheus
    networks: [io-platform]
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.console.libraries=/usr/share/prometheus/console_libraries
      - --web.console.templates=/usr/share/prometheus/consoles
      - --storage.tsdb.retention.time=30d

  # Grafana
  grafana:
    image: grafana/grafana:10.4.2
    container_name: io-grafana
    networks: [io-platform]
    depends_on: [prometheus]
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_PASSWORD: admin
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
</file>

