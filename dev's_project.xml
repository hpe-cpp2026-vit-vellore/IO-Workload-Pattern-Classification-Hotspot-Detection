"""
tests/unit/test_hotspot_detector.py

Unit tests for ml.hotspot_detection.detector
"""

import pytest

from ml.hotspot_detection.detector import (
    RuleBasedHotspotDetector,
    HotspotDetector,
    HotspotSeverity,
)


def _metric(**overrides):
    base = {
        "volume_id": "vol-001",
        "node_id": "node-01",
        "iops": 15000.0,
        "throughput_mbps": 200.0,
        "latency_us": 1000.0,
        "read_ratio": 0.6,
        "block_size_kb": 8.0,
        "queue_depth": 10,
        "disk_util_pct": 50.0,
        "iops_per_queue_depth": 1500.0,
        "latency_iops_product": 15.0,
        "util_per_iops": 3.3,
    }
    return {**base, **overrides}


class TestRuleBasedDetector:
    def setup_method(self):
        self.detector = RuleBasedHotspotDetector()

    def test_normal_traffic_no_hotspot(self):
        is_hot, rule, severity = self.detector.detect(_metric())
        assert not is_hot
        assert rule is None

    def test_critical_utilization(self):
        is_hot, rule, severity = self.detector.detect(_metric(disk_util_pct=96.0))
        assert is_hot
        assert severity == HotspotSeverity.CRITICAL

    def test_critical_latency(self):
        is_hot, rule, severity = self.detector.detect(_metric(latency_us=20000.0))
        assert is_hot
        assert severity == HotspotSeverity.CRITICAL

    def test_high_utilization_only(self):
        is_hot, rule, severity = self.detector.detect(_metric(disk_util_pct=90.0))
        assert is_hot
        assert severity == HotspotSeverity.MEDIUM

    def test_combined_high_util_and_latency(self):
        is_hot, rule, severity = self.detector.detect(
            _metric(disk_util_pct=88.0, latency_us=9000.0)
        )
        assert is_hot
        assert severity == HotspotSeverity.HIGH

    def test_throughput_saturation(self):
        is_hot, rule, severity = self.detector.detect(_metric(throughput_mbps=1200.0))
        assert is_hot
        assert rule == "throughput_saturation"

    def test_boundary_exactly_at_high_threshold(self):
        # At exactly the threshold: 85.0 util triggers MEDIUM
        is_hot, rule, severity = self.detector.detect(_metric(disk_util_pct=85.0))
        assert is_hot
        assert severity == HotspotSeverity.MEDIUM


class TestCompositeHotspotDetector:
    def setup_method(self):
        self.detector = HotspotDetector()

    def test_no_event_for_normal_traffic(self):
        event = self.detector.detect(_metric())
        assert event is None

    def test_event_returned_for_hotspot(self):
        event = self.detector.detect(_metric(disk_util_pct=96.0))
        assert event is not None
        assert event.volume_id == "vol-001"
        assert event.severity == HotspotSeverity.CRITICAL.value

    def test_event_has_required_fields(self):
        event = self.detector.detect(_metric(disk_util_pct=96.0))
        assert event is not None
        assert event.event_id
        assert event.timestamp_utc
        assert event.metrics_snapshot
        assert isinstance(event.estimated_impact_pct, float)

    def test_estimated_impact_zero_for_low_util(self):
        event = self.detector.detect(_metric(disk_util_pct=85.0))
        # util=85 is above high threshold but below 80 impact start
        # impact formula: max(0, (util-80)/20*30)
        if event:
            assert event.estimated_impact_pct >= 0.0
