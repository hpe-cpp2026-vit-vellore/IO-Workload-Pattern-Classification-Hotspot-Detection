"""
observability/metrics.py

Centralised observability for the IO Workload Platform.

Exports:
  - Prometheus metrics (counters, gauges, histograms)
  - Structured logging helpers
  - Model drift detection signals
  - MAPE loop KPI tracking (Monitor → Analyse → Plan → Execute)
"""

from __future__ import annotations

import logging
import threading
import time
from collections import deque
from dataclasses import dataclass
from typing import Any

from prometheus_client import (
    Counter, Gauge, Histogram, Summary,
    CollectorRegistry, generate_latest,
    CONTENT_TYPE_LATEST,
)

logger = logging.getLogger(__name__)


#  Registry 

REGISTRY = CollectorRegistry()


def _counter(name: str, doc: str, labels: list[str] | None = None) -> Counter:
    return Counter(name, doc, labels or [], registry=REGISTRY)


def _gauge(name: str, doc: str, labels: list[str] | None = None) -> Gauge:
    return Gauge(name, doc, labels or [], registry=REGISTRY)


def _histogram(name: str, doc: str, labels: list[str] | None = None,
               buckets=None) -> Histogram:
    kwargs = {"registry": REGISTRY, "labelnames": labels or []}
    if buckets:
        kwargs["buckets"] = buckets
    return Histogram(name, doc, **kwargs)


#  Platform Metrics 

class PlatformMetrics:
    """
    All Prometheus metrics for the IO Workload Platform.
    Instantiate once and share across components.
    """

    def __init__(self) -> None:
        prefix = "io_platform"

        #  Ingestion 
