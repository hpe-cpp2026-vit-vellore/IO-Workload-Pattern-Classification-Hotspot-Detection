"""
agents/telemetry_agent/agent.py

Telemetry agent that runs on each storage controller/node.
Collects per-volume I/O metrics at configurable intervals and publishes
them to the Kafka message bus.

In production this would hook into the storage array's internal stats APIs
(e.g., via /proc/diskstats, NVMe CLI, or proprietary array SDKs).
For POC/dev this reads from a CSV or generates synthetic metrics.
"""

from __future__ import annotations

import json
import logging
import os
import time
import uuid
from dataclasses import asdict, dataclass, field
from datetime import datetime, timezone
from typing import Iterator

import click
from confluent_kafka import Producer, KafkaException

logger = logging.getLogger(__name__)


#  Data Models 

@dataclass
class VolumeMetric:
    """Single telemetry sample for one volume at one point in time."""
    event_id: str
    timestamp_utc: str
    node_id: str
    volume_id: str
    iops: float
    throughput_mbps: float
    latency_us: float
    read_ratio: float           # 0.0 = all writes, 1.0 = all reads
    block_size_kb: float
    queue_depth: int
    disk_util_pct: float
    workload_label: str | None = None   # ground truth label when known (POC)

    @classmethod
    def new(
        cls,
        node_id: str,
        volume_id: str,
        iops: float,
        throughput_mbps: float,
        latency_us: float,
        read_ratio: float,
        block_size_kb: float,
        queue_depth: int,
        disk_util_pct: float,
        workload_label: str | None = None,
    ) -> "VolumeMetric":
        return cls(
            event_id=str(uuid.uuid4()),
            timestamp_utc=datetime.now(timezone.utc).isoformat(),
            node_id=node_id,
            volume_id=volume_id,
            iops=iops,
            throughput_mbps=throughput_mbps,
            latency_us=latency_us,
            read_ratio=read_ratio,
            block_size_kb=block_size_kb,
            queue_depth=queue_depth,
            disk_util_pct=disk_util_pct,
            workload_label=workload_label,
        )

    def to_json(self) -> str:
        return json.dumps(asdict(self))


#  Metric Collectors 

class CSVReplayCollector:
    """
    Replays rows from a CSV file as if they were live telemetry.
    Used in dev / POC mode to feed the pipeline with sample data.
    """

    def __init__(self, csv_path: str, node_id: str, volume_prefix: str = "vol") -> None:
        import pandas as pd
        self.df = pd.read_csv(csv_path)
        self.node_id = node_id
        self.volume_prefix = volume_prefix
        self._index = 0

    def collect(self) -> Iterator[VolumeMetric]:
        row = self.df.iloc[self._index % len(self.df)]
        self._index += 1
        yield VolumeMetric.new(
            node_id=self.node_id,
            volume_id=f"{self.volume_prefix}-{self._index:04d}",
            iops=float(row["iops"]),
            throughput_mbps=float(row["throughput_mbps"]),
            latency_us=float(row["latency_us"]),
            read_ratio=float(row["read_ratio"]),
            block_size_kb=float(row["block_size_kb"]),
            queue_depth=int(row["queue_depth"]),
            disk_util_pct=float(row["disk_util_pct"]),
            workload_label=str(row.get("workload_type", "")),
        )


class SyntheticCollector:
    """
    Generates synthetic metrics in-process.
    Useful for load testing the pipeline without real hardware.
    """

    import random as _random

    PROFILES = {
        "DB_OLTP":      dict(iops=(30000, 60000), tp=(100, 250),  lat=(200, 600),   rr=(0.6, 0.9),  bs=(4, 8),    qd=(10, 30), util=(50, 85)),
        "VM":           dict(iops=(5000, 20000),  tp=(50, 200),   lat=(800, 2000),  rr=(0.4, 0.7),  bs=(8, 64),   qd=(5, 25),  util=(30, 80)),
        "Backup":       dict(iops=(500, 2000),    tp=(700, 1200), lat=(5000, 12000),rr=(0.0, 0.2),  bs=(256, 512),qd=(1, 8),   util=(70, 95)),
        "AI_Training":  dict(iops=(3000, 8000),   tp=(1500, 3000),lat=(2000, 5000), rr=(0.85, 1.0), bs=(256, 1024),qd=(30, 64),util=(80, 95)),
        "AI_Inference": dict(iops=(10000, 40000), tp=(250, 600),  lat=(300, 1000),  rr=(0.75, 0.95),bs=(4, 16),   qd=(3, 15),  util=(30, 80)),
    }

    def __init__(self, node_id: str, workload_type: str = "DB_OLTP") -> None:
        import random
        self._rng = random.Random()
        self.node_id = node_id
        self.workload_type = workload_type
        self._vol_counter = 0

    def collect(self) -> Iterator[VolumeMetric]:
        import random
        profile = self.PROFILES[self.workload_type]
        self._vol_counter += 1
        yield VolumeMetric.new(
            node_id=self.node_id,
            volume_id=f"synth-vol-{self._vol_counter:04d}",
            iops=random.uniform(*profile["iops"]),
            throughput_mbps=random.uniform(*profile["tp"]),
            latency_us=random.uniform(*profile["lat"]),
            read_ratio=random.uniform(*profile["rr"]),
            block_size_kb=random.choice(
                [b for b in [4, 8, 16, 64, 256, 512, 1024]
                 if profile["bs"][0] <= b <= profile["bs"][1]]
            ),
            queue_depth=random.randint(*profile["qd"]),
            disk_util_pct=random.uniform(*profile["util"]),
            workload_label=self.workload_type,
        )


#  Kafka Publisher 

class KafkaMetricPublisher:
    def __init__(self, bootstrap_servers: str, topic: str) -> None:
        self.topic = topic
        self._producer = Producer({
            "bootstrap.servers": bootstrap_servers,
            "acks": "all",
            "retries": 5,
            "retry.backoff.ms": 200,
            "linger.ms": 5,
            "compression.type": "snappy",
        })

    def publish(self, metric: VolumeMetric) -> None:
        self._producer.produce(
            topic=self.topic,
            key=metric.volume_id.encode(),
            value=metric.to_json().encode(),
            on_delivery=self._delivery_report,
        )
        self._producer.poll(0)

    def flush(self) -> None:
        self._producer.flush()

    @staticmethod
    def _delivery_report(err, msg) -> None:
        if err:
            logger.error("Kafka delivery failed: %s", err)
        else:
            logger.debug("Delivered to %s [%d]", msg.topic(), msg.partition())


#  Agent Loop 

class TelemetryAgent:
    """
    Main agent loop. Collects metrics and publishes to Kafka.
    """

    def __init__(
        self,
        collector,
        publisher: KafkaMetricPublisher,
        interval_seconds: float = 5.0,
    ) -> None:
        self.collector = collector
        self.publisher = publisher
        self.interval = interval_seconds
        self._running = False

    def run(self) -> None:
        self._running = True
        logger.info("Telemetry agent started (interval=%.1fs)", self.interval)
        try:
            while self._running:
                for metric in self.collector.collect():
                    self.publisher.publish(metric)
                    logger.debug("Published: volume=%s iops=%.0f lat=%.0f",
                                 metric.volume_id, metric.iops, metric.latency_us)
                time.sleep(self.interval)
        except KeyboardInterrupt:
            logger.info("Shutting down telemetry agent")
        finally:
            self.publisher.flush()

    def stop(self) -> None:
        self._running = False


#  CLI 

@click.command()
@click.option("--mode", type=click.Choice(["csv", "synthetic"]), default="csv")
@click.option("--csv-file", default="data/sample/io_workload_data_sample.csv")
@click.option("--node-id", default="node-01")
@click.option("--bootstrap-servers", default="localhost:9092")
@click.option("--topic", default="io.telemetry.raw")
@click.option("--interval", default=5.0, type=float, help="Seconds between collections")
@click.option("--workload-type", default="DB_OLTP",
              type=click.Choice(list(SyntheticCollector.PROFILES.keys())),
              help="Workload type for synthetic mode")
def main(mode, csv_file, node_id, bootstrap_servers, topic, interval, workload_type):
    """Run the IO telemetry agent."""
    logging.basicConfig(
        level=os.getenv("LOG_LEVEL", "INFO"),
        format="%(asctime)s %(levelname)s %(name)s %(message)s",
    )

    if mode == "csv":
        collector = CSVReplayCollector(csv_path=csv_file, node_id=node_id)
    else:
        collector = SyntheticCollector(node_id=node_id, workload_type=workload_type)

    publisher = KafkaMetricPublisher(
        bootstrap_servers=bootstrap_servers,
        topic=topic,
    )

    agent = TelemetryAgent(collector=collector, publisher=publisher,
                           interval_seconds=interval)
    agent.run()


if __name__ == "__main__":
    main()
