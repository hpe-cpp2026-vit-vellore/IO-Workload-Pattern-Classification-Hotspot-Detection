"""
tests/unit/test_execution_monitor.py
"""

import time
import pytest

from execution_monitor.monitor import ExecutionMonitor, MovePhase, MoveRecord


def _register(monitor, op_id="op-001", volume_id="vol-001",
              source="node-01", target="node-02", size_gb=50.0):
    return monitor.register(op_id, volume_id, source, target, size_gb)


class TestExecutionMonitor:
    def setup_method(self):
        self.monitor = ExecutionMonitor(
            max_concurrent_moves=3,
            stall_timeout_s=9999,  # disable watchdog triggering in tests
            max_rollback_rate=0.01,
        )

    def test_register_creates_record(self):
        record = _register(self.monitor)
        assert record.op_id == "op-001"
        assert record.volume_id == "vol-001"
        assert record.phase == MovePhase.QUEUED.value

    def test_can_accept_within_limit(self):
        assert self.monitor.can_accept("vol-new") is True

    def test_cannot_accept_same_volume_twice(self):
        _register(self.monitor)
        assert self.monitor.can_accept("vol-001") is False

    def test_cannot_accept_at_max_capacity(self):
        monitor = ExecutionMonitor(max_concurrent_moves=2, stall_timeout_s=9999)
        _register(monitor, "op-1", "vol-1")
        _register(monitor, "op-2", "vol-2")
        assert monitor.can_accept("vol-3") is False

    def test_update_phase_transitions(self):
        record = _register(self.monitor)
        self.monitor.update_phase("op-001", MovePhase.EXECUTING)
        assert record.phase == MovePhase.EXECUTING.value
        assert record.started_at is not None

    def test_completed_moves_to_history(self):
        _register(self.monitor)
        self.monitor.update_phase("op-001", MovePhase.EXECUTING)
        self.monitor.update_phase("op-001", MovePhase.COMPLETED, bytes_moved_gb=50.0)

        assert "op-001" not in self.monitor._active
        stats = self.monitor.get_stats()
        assert stats["completed"] == 1

    def test_failed_moves_counted(self):
        _register(self.monitor)
        self.monitor.mark_failed("op-001", "Disk error")
        stats = self.monitor.get_stats()
        assert stats["failed"] == 1

    def test_progress_pct_computed(self):
        record = _register(self.monitor, size_gb=100.0)
        self.monitor.update_phase("op-001", MovePhase.EXECUTING, bytes_moved_gb=25.0)
        assert abs(record.progress_pct - 25.0) < 0.1

    def test_progress_pct_100_when_complete(self):
        record = _register(self.monitor, size_gb=50.0)
        self.monitor.update_phase("op-001", MovePhase.EXECUTING)
        self.monitor.update_phase("op-001", MovePhase.COMPLETED, bytes_moved_gb=50.0)
        assert record.progress_pct == 100.0

    def test_get_active_returns_in_flight_moves(self):
        _register(self.monitor, "op-1", "vol-1")
        _register(self.monitor, "op-2", "vol-2")
        active = self.monitor.get_active()
        assert len(active) == 2

    def test_duration_recorded_on_completion(self):
        record = _register(self.monitor)
        self.monitor.update_phase("op-001", MovePhase.EXECUTING)
        time.sleep(0.05)
        self.monitor.update_phase("op-001", MovePhase.COMPLETED, bytes_moved_gb=50.0)
        assert record.duration_s is not None
        assert record.duration_s >= 0.0

    def test_completion_callback_called(self):
        completed = []
        monitor = ExecutionMonitor(
            max_concurrent_moves=3,
            stall_timeout_s=9999,
            on_completion=lambda op_id, success: completed.append(op_id),
        )
        _register(monitor)
        monitor.update_phase("op-001", MovePhase.EXECUTING)
        monitor.update_phase("op-001", MovePhase.COMPLETED, bytes_moved_gb=50.0)

        time.sleep(0.1)  # callback runs in background thread
        assert "op-001" in completed

    def test_rollback_rate_computed(self):
        monitor = ExecutionMonitor(max_concurrent_moves=10, stall_timeout_s=9999)
        for i in range(10):
            _register(monitor, f"op-{i}", f"vol-{i}")
            monitor.update_phase(f"op-{i}", MovePhase.EXECUTING)
            if i < 2:
                monitor.update_phase(f"op-{i}", MovePhase.ROLLED_BACK, bytes_moved_gb=0.0)
            else:
                monitor.update_phase(f"op-{i}", MovePhase.COMPLETED, bytes_moved_gb=50.0)

        stats = monitor.get_stats()
        assert stats["rolled_back"] == 2
        assert abs(stats["rollback_rate"] - 0.2) < 0.01

    def test_unknown_op_id_update_is_safe(self):
        # Should not raise
        self.monitor.update_phase("nonexistent-op", MovePhase.EXECUTING)
