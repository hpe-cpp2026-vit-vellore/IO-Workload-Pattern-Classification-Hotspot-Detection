"""
feature_engineering/batch/backfill.py

Batch feature engineering job.
Reads raw telemetry from CSV/Parquet, computes derived features,
and writes enriched feature rows to the offline feature store (Parquet).

Usage:
    python -m feature_engineering.batch.backfill \
        --input data/sample/io_workload_data_sample.csv \
        --output data/offline_store
"""

from __future__ import annotations

import logging
from pathlib import Path

import click
import pandas as pd

from feature_engineering.features import (
    compute_derived_features,
    validate_features,
    ALL_FEATURES,
    RAW_FEATURES,
)

logger = logging.getLogger(__name__)


def run_backfill(
    input_path: str,
    output_dir: str,
    partition_cols: list[str] | None = None,
) -> pd.DataFrame:
    """
    Read raw telemetry, compute features, write to offline store.

    Args:
        input_path: Path to CSV or Parquet file of raw telemetry.
        output_dir: Root directory for the offline Parquet store.
        partition_cols: Hive-style partition columns.

    Returns:
        Enriched DataFrame (for testing / inspection).
    """
    path = Path(input_path)
    logger.info("Loading raw data from %s", path)

    if path.suffix == ".csv":
        df = pd.read_csv(path)
    elif path.suffix in (".parquet", ".pq"):
        df = pd.read_parquet(path)
    else:
        raise ValueError(f"Unsupported input format: {path.suffix}")

    logger.info("Loaded %d rows, columns: %s", len(df), list(df.columns))

    # Rename workload_type → workload_label if needed
    if "workload_type" in df.columns and "workload_label" not in df.columns:
        df = df.rename(columns={"workload_type": "workload_label"})

    # Add synthetic ids if missing (CSV replay data won't have them)
    if "volume_id" not in df.columns:
        df["volume_id"] = [f"vol-{i:06d}" for i in range(len(df))]
    if "node_id" not in df.columns:
        df["node_id"] = "node-00"
    if "timestamp_utc" not in df.columns:
        import uuid
        from datetime import datetime, timezone, timedelta
        base = datetime(2024, 1, 1, tzinfo=timezone.utc)
        df["timestamp_utc"] = [
            (base + timedelta(seconds=i * 5)).isoformat()
            for i in range(len(df))
        ]

    # Validate raw features present
    missing_raw = [c for c in RAW_FEATURES if c not in df.columns]
    if missing_raw:
        raise ValueError(f"Missing raw feature columns: {missing_raw}")

    # Compute derived features
    df = compute_derived_features(df)

    # Validate final feature set
    issues = validate_features(df, required=ALL_FEATURES)
    if issues:
        logger.warning("Feature validation issues: %s", issues)

    # Add date partition column if not present
    df["date"] = pd.to_datetime(df["timestamp_utc"], utc=True).dt.date.astype(str)

    # Write to offline store — partitioned layout matching OfflineFeatureStore.
    # Structure: output_dir/features/date=YYYY-MM-DD/part-<ts>.parquet
    import time as _time
    features_dir = Path(output_dir) / "features"

    for date_val, group in df.groupby("date"):
        part_dir = features_dir / f"date={date_val}"
        part_dir.mkdir(parents=True, exist_ok=True)
        out_file = part_dir / f"part-{int(_time.time_ns())}.parquet"
        group.drop(columns=["date"]).to_parquet(out_file, index=False)

    n_files = sum(1 for _ in features_dir.rglob("*.parquet"))
    logger.info("Wrote %d rows to %s (%d parquet files)", len(df), features_dir, n_files)

    return df


@click.command()
@click.option("--input", "input_path", required=True,
              default="data/sample/io_workload_data_sample.csv",
              help="Path to raw telemetry CSV or Parquet")
@click.option("--output", "output_dir",
              default="data/offline_store",
              help="Output directory for offline feature store")
@click.option("--log-level", default="INFO")
def main(input_path: str, output_dir: str, log_level: str) -> None:
    """Run batch feature backfill."""
    logging.basicConfig(
        level=log_level,
        format="%(asctime)s %(levelname)s %(name)s %(message)s",
    )
    df = run_backfill(input_path=input_path, output_dir=output_dir)
    logger.info("Backfill complete. Sample:\n%s", df[ALL_FEATURES].head(3).to_string())


if __name__ == "__main__":
    main()
