"""
ml/classification/evaluate.py

Standalone model evaluation script.

Loads a trained classifier and evaluates it against a test dataset.
Produces:
  - Per-class precision, recall, F1
  - Confusion matrix
  - Confidence calibration plot data
  - SHAP feature importance
  - Go/no-go decision against success criteria

Usage:
    python -m ml.classification.evaluate \
        --model models/workload_classifier_latest.pkl \
        --data data/sample/io_workload_data_sample.csv \
        --output reports/eval_latest.json
"""

from __future__ import annotations

import json
import logging
from pathlib import Path

import click
import joblib
import numpy as np
import pandas as pd
from sklearn.metrics import (
    classification_report,
    confusion_matrix,
    roc_auc_score,
    f1_score,
    precision_score,
    recall_score,
)
from sklearn.preprocessing import label_binarize

from feature_engineering.features import compute_derived_features, MODEL_FEATURES

logger = logging.getLogger(__name__)

CLASSES = ["DB_OLTP", "VM", "Backup", "AI_Training", "AI_Inference"]
LABEL_COL = "workload_label"


def load_model(model_path: str) -> tuple:
    """Returns (model, label_encoder, feature_names)."""
    bundle = joblib.load(model_path)
    if isinstance(bundle, dict):
        return bundle["model"], bundle["label_encoder"], bundle["feature_names"]
    raise ValueError(f"Unexpected model bundle format in {model_path}")


def load_test_data(data_path: str) -> pd.DataFrame:
    path = Path(data_path)
    df = pd.read_csv(path) if path.suffix == ".csv" else pd.read_parquet(path)
    if "workload_type" in df.columns and LABEL_COL not in df.columns:
        df = df.rename(columns={"workload_type": LABEL_COL})
    df = compute_derived_features(df)
    return df


def compute_shap_importance(
    model, X: pd.DataFrame, feature_names: list[str]
) -> dict[str, float]:
    """Returns feature → mean |SHAP value|."""
    try:
        import shap
        explainer = shap.TreeExplainer(model)
        shap_values = explainer.shap_values(X)
        # shap_values is list of arrays (one per class) for multi-class
        if isinstance(shap_values, list):
            mean_abs = np.mean([np.abs(sv) for sv in shap_values], axis=0)
            mean_per_feature = mean_abs.mean(axis=0)
        else:
            mean_per_feature = np.abs(shap_values).mean(axis=0)
        return {
            feat: round(float(val), 6)
            for feat, val in sorted(
                zip(feature_names, mean_per_feature),
                key=lambda x: -x[1],
            )
        }
    except Exception as exc:
        logger.warning("SHAP computation failed (non-fatal): %s", exc)
        # Fall back to sklearn feature_importances_
        if hasattr(model, "feature_importances_"):
            return {
                feat: round(float(imp), 6)
                for feat, imp in sorted(
                    zip(feature_names, model.feature_importances_),
                    key=lambda x: -x[1],
                )
            }
        return {}


def evaluate(
    model_path: str,
    data_path: str,
    output_path: str | None = None,
    success_criteria: dict | None = None,
) -> dict:
    """
    Full evaluation pipeline.

    Returns:
        Evaluation report dict.
    """
    model, le, feature_names = load_model(model_path)
    df = load_test_data(data_path)

    available_features = [f for f in feature_names if f in df.columns]
    missing_features = [f for f in feature_names if f not in df.columns]
    if missing_features:
        logger.warning("Missing features (using 0.0): %s", missing_features)

    X = df.reindex(columns=feature_names, fill_value=0.0).astype(float)
    y_true_labels = df[LABEL_COL].values

    # Filter to known classes
    mask = np.isin(y_true_labels, le.classes_)
    if mask.sum() < len(mask):
        logger.warning("Dropped %d rows with unknown labels", (~mask).sum())
    X, y_true_labels = X[mask], y_true_labels[mask]

    y_true_enc = le.transform(y_true_labels)
    y_pred_enc = model.predict(X)
    y_pred_labels = le.inverse_transform(y_pred_enc)
    y_proba = model.predict_proba(X)

    #  Core Metrics 
    f1_macro   = float(f1_score(y_true_enc, y_pred_enc, average="macro"))
    prec_macro = float(precision_score(y_true_enc, y_pred_enc, average="macro", zero_division=0))
    rec_macro  = float(recall_score(y_true_enc, y_pred_enc, average="macro", zero_division=0))

    # One-vs-rest AUC
    try:
        y_bin = label_binarize(y_true_enc, classes=list(range(len(le.classes_))))
        auc_macro = float(roc_auc_score(y_bin, y_proba, average="macro", multi_class="ovr"))
    except Exception:
        auc_macro = None

    per_class_report = classification_report(
        y_true_labels, y_pred_labels,
        target_names=le.classes_,
        output_dict=True,
        zero_division=0,
    )

    #  Confusion Matrix 
    cm = confusion_matrix(y_true_labels, y_pred_labels, labels=le.classes_)
    cm_dict = {
        "labels": list(le.classes_),
        "matrix": cm.tolist(),
    }

    #  Confidence Histogram 
    confidence_scores = y_proba.max(axis=1)
    confidence_hist, bin_edges = np.histogram(confidence_scores, bins=10, range=(0, 1))
    confidence_hist_data = {
        "bins": [round(float(e), 2) for e in bin_edges],
        "counts": confidence_hist.tolist(),
    }

    #  SHAP Feature Importance 
    shap_importance = compute_shap_importance(model, X, feature_names)

    #  Success Criteria 
    default_criteria = {
        "min_f1_macro": 0.95,
        "min_precision_macro": 0.95,
        "min_recall_macro": 0.95,
    }
    criteria = success_criteria or default_criteria
    gate_passed = (
        f1_macro   >= criteria.get("min_f1_macro", 0.95) and
        prec_macro >= criteria.get("min_precision_macro", 0.95) and
        rec_macro  >= criteria.get("min_recall_macro", 0.95)
    )

    #  Print Summary 
    logger.info("\n" + "=" * 60)
    logger.info("EVALUATION REPORT")
    logger.info("=" * 60)
    logger.info("  Dataset:          %s (%d rows)", data_path, len(df))
    logger.info("  Model:            %s", model_path)
    logger.info("  F1 (macro):       %.4f  %s", f1_macro,
                "✓" if f1_macro >= criteria.get("min_f1_macro", 0.95) else "✗")
    logger.info("  Precision (macro): %.4f  %s", prec_macro,
                "✓" if prec_macro >= criteria.get("min_precision_macro", 0.95) else "✗")
    logger.info("  Recall (macro):   %.4f  %s", rec_macro,
                "✓" if rec_macro >= criteria.get("min_recall_macro", 0.95) else "✗")
    if auc_macro:
        logger.info("  AUC (macro OvR):  %.4f", auc_macro)
    logger.info("  Gate PASSED:      %s", gate_passed)
    logger.info("\n" + classification_report(
        y_true_labels, y_pred_labels, target_names=le.classes_, zero_division=0
    ))
    logger.info("Top 5 features by SHAP importance:")
    for feat, val in list(shap_importance.items())[:5]:
        logger.info("  %-35s %.6f", feat, val)

    report = {
        "model_path": str(model_path),
        "data_path": str(data_path),
        "n_samples": int(len(df)),
        "metrics": {
            "f1_macro": round(f1_macro, 6),
            "precision_macro": round(prec_macro, 6),
            "recall_macro": round(rec_macro, 6),
            "auc_macro_ovr": round(auc_macro, 6) if auc_macro else None,
        },
        "per_class": per_class_report,
        "confusion_matrix": cm_dict,
        "confidence_histogram": confidence_hist_data,
        "feature_importance_shap": shap_importance,
        "success_criteria": criteria,
        "gate_passed": gate_passed,
    }

    if output_path:
        Path(output_path).parent.mkdir(parents=True, exist_ok=True)
        with open(output_path, "w") as f:
            json.dump(report, f, indent=2)
        logger.info("Report written to %s", output_path)

    return report


@click.command()
@click.option("--model", "model_path",
              default="models/workload_classifier_latest.pkl")
@click.option("--data", "data_path",
              default="data/sample/io_workload_data_sample.csv")
@click.option("--output", "output_path",
              default="reports/eval_latest.json")
@click.option("--log-level", default="INFO")
def main(model_path: str, data_path: str, output_path: str, log_level: str) -> None:
    """Evaluate a trained workload classifier."""
    logging.basicConfig(
        level=log_level,
        format="%(asctime)s %(levelname)s %(name)s %(message)s",
    )
    report = evaluate(
        model_path=model_path,
        data_path=data_path,
        output_path=output_path,
    )
    exit_code = 0 if report["gate_passed"] else 1
    raise SystemExit(exit_code)


if __name__ == "__main__":
    main()
