<file path="run.sh">
#!/usr/bin/env bash

set -e

COMPOSE_FILE="deploy/docker/docker-compose.yml"
TOPIC_NAME="io.telemetry.raw"

echo "=================================================="
echo " FULL PLATFORM RESET + REBUILD"
echo "=================================================="

# ──────────────────────────────────────────────────
# 1. Destroy existing stack
# ──────────────────────────────────────────────────

echo ""
echo "[1/9] Stopping and deleting containers, networks, volumes..."

docker compose -f $COMPOSE_FILE down -v

echo ""
echo "[+] Pruning dangling docker resources..."

docker system prune -f

# ──────────────────────────────────────────────────
# 2. Rebuild + restart
# ──────────────────────────────────────────────────

echo ""
echo "[2/9] Rebuilding docker stack..."

docker compose -f $COMPOSE_FILE up -d --build

echo ""
echo "[+] Waiting for services to stabilize..."

sleep 30

# ──────────────────────────────────────────────────
# 3. Verify MLflow
# ──────────────────────────────────────────────────

echo ""
echo "[3/9] Checking MLflow health..."

if curl -f http://localhost:5000 > /dev/null 2>&1; then
    echo "[+] MLflow is alive"
else
    echo "[!] MLflow is NOT responding"
    docker compose -f $COMPOSE_FILE logs mlflow
    exit 1
fi

# ──────────────────────────────────────────────────
# 4. Recreate Kafka topic
# ──────────────────────────────────────────────────

echo ""
echo "[4/9] Creating Kafka topic..."

docker exec -it io-kafka kafka-topics \
  --create \
  --if-not-exists \
  --topic $TOPIC_NAME \
  --bootstrap-server localhost:9092 \
  --partitions 1 \
  --replication-factor 1

echo ""
echo "[+] Kafka topics:"

docker exec -it io-kafka kafka-topics \
  --list \
  --bootstrap-server localhost:9092

# ──────────────────────────────────────────────────
# 5. Ingest sample data
# ──────────────────────────────────────────────────

echo ""
echo "[5/9] Running ingestion..."

python scripts/ingest_sample.py \
  --file data/sample/io_workload_data_sample.csv

# ──────────────────────────────────────────────────
# 6. Feature engineering
# ──────────────────────────────────────────────────

echo ""
echo "[6/9] Running feature engineering..."

python -m feature_engineering.batch.backfill \
  --input data/sample/io_workload_data_sample.csv

# ──────────────────────────────────────────────────
# 7. Train model
# ──────────────────────────────────────────────────

echo ""
echo "[7/9] Training classification model..."

python -m ml.classification.train \
  --config config/ml/classification.yaml

# ──────────────────────────────────────────────────
# 8. Evaluate model
# ──────────────────────────────────────────────────

echo ""
echo "[8/9] Evaluating model..."

python -m ml.classification.evaluate \
  --model models/workload_classifier_latest.pkl \
  --data data/sample/io_workload_data_sample.csv

# ──────────────────────────────────────────────────
# 9. Start services
# ──────────────────────────────────────────────────

echo ""
echo "[9/9] Starting inference + decision engine + UI..."

uvicorn inference.serving.app:app \
  --host 0.0.0.0 \
  --port 8080 &

INFERENCE_PID=$!

python -m decision_engine.engine \
  --config config/decision_engine.yaml &

ENGINE_PID=$!

streamlit run ui/Home.py &

STREAMLIT_PID=$!

echo ""
echo "=================================================="
echo " PLATFORM READY"
echo "=================================================="

echo ""
echo "MLflow:      http://localhost:5000"
echo "FastAPI:     http://localhost:8080/docs"
echo "Grafana:     http://localhost:3000"
echo "Kafka UI:    http://localhost:8090"
echo "Streamlit:   http://localhost:8501"

echo ""
echo "Running PIDs:"
echo "Inference:   $INFERENCE_PID"
echo "Engine:      $ENGINE_PID"
echo "Streamlit:   $STREAMLIT_PID"

wait
</file>

