    def test_returns_dataframe(self):
        df = pd.DataFrame([SAMPLE_ROW])
        result = compute_derived_features(df)
        assert isinstance(result, pd.DataFrame)

    def test_all_derived_columns_added(self):
        df = pd.DataFrame([SAMPLE_ROW])
        result = compute_derived_features(df)
        for col in DERIVED_FEATURES:
            assert col in result.columns, f"Missing column: {col}"

    def test_original_columns_preserved(self):
        df = pd.DataFrame([SAMPLE_ROW])
        result = compute_derived_features(df)
        for col in RAW_FEATURES:
            assert col in result.columns

    def test_iops_per_queue_depth_correct(self):
        df = pd.DataFrame([SAMPLE_ROW])
        result = compute_derived_features(df)
        expected = SAMPLE_ROW["iops"] / (SAMPLE_ROW["queue_depth"] + 1e-9)
        assert abs(result["iops_per_queue_depth"].iloc[0] - expected) < 0.01

    def test_no_division_by_zero_with_zero_queue_depth(self):
        row = {**SAMPLE_ROW, "queue_depth": 0}
