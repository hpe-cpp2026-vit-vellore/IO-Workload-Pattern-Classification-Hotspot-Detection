"""
ml/mlops/drift_monitor.py

MLOps: Model drift monitoring and retraining trigger.

Implements the feedback loop in the MAPE (Monitor–Analyse–Plan–Execute)
control plane architecture:

  1. Monitor   — collect live prediction distributions from Redis
  2. Analyse   — compute KL-divergence vs. training distribution
  3. Plan      — decide if retraining is needed
  4. Execute   — submit a retraining job (or alert a human)

Drift types detected:
  - Prediction drift    (distribution of predicted classes shifted)
  - Feature drift       (input feature statistics shifted — covariate shift)
  - Label drift         (ground truth distribution changed — concept drift)
    ^ requires periodic ground-truth labelling pipeline

Runs as a standalone daemon process.
"""

from __future__ import annotations

import json
import logging
import time
from collections import deque
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import numpy as np

logger = logging.getLogger(__name__)


@dataclass
class DriftReport:
    model_name: str
    timestamp_utc: str
    prediction_kl_divergence: float
    feature_drift_scores: dict[str, float]   # feature_name → PSI score
    overall_drift_detected: bool
    drift_type: str | None                   # "prediction" | "feature" | "both" | None
    recommendation: str


#  Population Stability Index (PSI) 

def compute_psi(expected: np.ndarray, actual: np.ndarray, bins: int = 10) -> float:
    """
    Population Stability Index between expected (training) and actual (production).
    PSI < 0.1  → no significant change
    PSI 0.1–0.2 → moderate change, monitor closely
    PSI > 0.2  → significant change, retrain

    Args:
        expected: 1-D array from training distribution
        actual:   1-D array from production distribution
        bins:     Number of histogram bins

    Returns:
        PSI score (float)
    """
    eps = 1e-6
    min_val = min(expected.min(), actual.min())
    max_val = max(expected.max(), actual.max())

    if max_val == min_val:
        return 0.0

    breaks = np.linspace(min_val, max_val, bins + 1)

    expected_hist, _ = np.histogram(expected, bins=breaks)
    actual_hist, _   = np.histogram(actual,   bins=breaks)

    expected_pct = (expected_hist + eps) / (expected_hist.sum() + eps * bins)
    actual_pct   = (actual_hist   + eps) / (actual_hist.sum()   + eps * bins)

    psi = np.sum((actual_pct - expected_pct) * np.log(actual_pct / expected_pct))
    return float(psi)


def compute_kl_divergence(
    reference: dict[str, float],
    observed: dict[str, float],
) -> float:
    """KL(observed || reference) over class distributions."""
    classes = sorted(reference.keys())
    ref_total = sum(reference.values()) or 1
    obs_total = sum(observed.values()) or 1

    eps = 1e-9
    kl = 0.0
    for c in classes:
        p = (observed.get(c, 0) + eps) / (obs_total + eps * len(classes))
        q = (reference.get(c, 0) + eps) / (ref_total + eps * len(classes))
        kl += p * np.log(p / q)
    return float(kl)


#  Feature Drift Monitor 

class FeatureDriftMonitor:
    """
    Tracks feature statistics over a sliding window and
    computes PSI against training-time statistics.
    """

    def __init__(
        self,
        training_stats: dict[str, dict[str, float]],   # feature → {"mean", "std", "min", "max", samples...}
        window_size: int = 5000,
        psi_threshold: float = 0.2,
    ) -> None:
        self.training_stats = training_stats
        self.psi_threshold = psi_threshold
        # Sliding window per feature: deque of recent values
        self._windows: dict[str, deque] = {
            feat: deque(maxlen=window_size)
            for feat in training_stats
        }

    def record(self, feature_vector: dict[str, float]) -> None:
        for feat, val in feature_vector.items():
            if feat in self._windows:
                self._windows[feat].append(float(val))

    def compute_psi_scores(self) -> dict[str, float]:
        scores = {}
        for feat, window in self._windows.items():
            if len(window) < 100:
                continue
            train_stats = self.training_stats.get(feat)
            if not train_stats:
                continue
            # Reconstruct approximate training distribution via normal samples
            train_samples = np.random.normal(
                loc=train_stats.get("mean", 0),
                scale=max(train_stats.get("std", 1), 1e-6),
                size=len(window),
            )
            psi = compute_psi(train_samples, np.array(window))
            scores[feat] = round(psi, 4)
        return scores

    def drifted_features(self) -> list[str]:
        return [f for f, s in self.compute_psi_scores().items()
                if s > self.psi_threshold]


#  Prediction Drift Monitor 

class PredictionDriftMonitor:
    """
    Tracks the live distribution of predicted workload classes
    and compares against the training-set label distribution.
    """

    def __init__(
        self,
        reference_distribution: dict[str, float],
        window_size: int = 2000,
        kl_threshold: float = 0.10,
    ) -> None:
        self.reference = reference_distribution
        self.kl_threshold = kl_threshold
        self._window: deque[str] = deque(maxlen=window_size)

    def record(self, predicted_class: str) -> None:
        self._window.append(predicted_class)

    def current_distribution(self) -> dict[str, float]:
        if not self._window:
            return {}
        from collections import Counter
        counts = Counter(self._window)
        total = len(self._window)
        return {k: v / total for k, v in counts.items()}

    def kl_divergence(self) -> float:
        if len(self._window) < 50:
            return 0.0
        observed = self.current_distribution()
        return compute_kl_divergence(self.reference, observed)

    def is_drifted(self) -> bool:
        return self.kl_divergence() > self.kl_threshold


#  Retraining Trigger 

class RetrainingTrigger:
    """
    Decides whether to trigger a retraining job based on drift signals.

    In production this would submit a job to an orchestrator (Airflow, Argo, etc.).
    For now it logs the trigger and writes a flag file.
    """

    def __init__(
        self,
        flag_dir: str = "./models",
        cooldown_hours: float = 24.0,
    ) -> None:
        self.flag_dir = Path(flag_dir)
        self.cooldown_s = cooldown_hours * 3600
        self._last_trigger: float = 0.0

    def should_retrain(self, report: DriftReport) -> bool:
        if not report.overall_drift_detected:
            return False
        if (time.time() - self._last_trigger) < self.cooldown_s:
            logger.info("Retraining suppressed by cooldown (%.1f hours remaining)",
                        (self.cooldown_s - (time.time() - self._last_trigger)) / 3600)
            return False
        return True

    def trigger(self, report: DriftReport) -> None:
        self._last_trigger = time.time()
        self.flag_dir.mkdir(parents=True, exist_ok=True)

        flag_path = self.flag_dir / "retrain_requested.json"
        payload = {
            "requested_at": datetime.now(timezone.utc).isoformat(),
            "model_name": report.model_name,
            "drift_type": report.drift_type,
            "kl_divergence": report.prediction_kl_divergence,
            "recommendation": report.recommendation,
        }
        with open(flag_path, "w") as f:
            json.dump(payload, f, indent=2)

        logger.warning(
            "RETRAINING TRIGGERED for %s — drift_type=%s kl=%.4f",
            report.model_name, report.drift_type, report.prediction_kl_divergence,
        )


#  Drift Monitor Daemon 

class DriftMonitorDaemon:
    """
    Long-running daemon that polls Redis for recent predictions,
    computes drift, and triggers retraining if needed.

    Runs in a background thread as part of the inference server
    or as a standalone sidecar process.
    """

    def __init__(
        self,
        prediction_monitor: PredictionDriftMonitor,
        feature_monitor: FeatureDriftMonitor | None,
        retrain_trigger: RetrainingTrigger,
        model_name: str,
        check_interval_s: float = 60.0,
    ) -> None:
        self.prediction_monitor = prediction_monitor
        self.feature_monitor = feature_monitor
        self.retrain_trigger = retrain_trigger
        self.model_name = model_name
        self.check_interval_s = check_interval_s
        self._running = False

    def record_prediction(self, predicted_class: str, features: dict | None = None) -> None:
        """Called by the inference server on every prediction."""
        self.prediction_monitor.record(predicted_class)
        if features and self.feature_monitor:
            self.feature_monitor.record(features)

    def check(self) -> DriftReport:
        """Run a drift check and return a report."""
        kl = self.prediction_monitor.kl_divergence()
        feature_scores = (
            self.feature_monitor.compute_psi_scores()
            if self.feature_monitor else {}
        )
        drifted_feats = (
            self.feature_monitor.drifted_features()
            if self.feature_monitor else []
        )

        pred_drifted = self.prediction_monitor.is_drifted()
        feat_drifted = len(drifted_feats) > 0

        if pred_drifted and feat_drifted:
            drift_type = "both"
            recommendation = (
                f"Both prediction and feature drift detected. "
                f"Drifted features: {drifted_feats}. "
                f"Retrain immediately."
            )
        elif pred_drifted:
            drift_type = "prediction"
            recommendation = (
                f"Prediction distribution shifted (KL={kl:.4f}). "
                f"Check for workload pattern changes. Retrain recommended."
            )
        elif feat_drifted:
            drift_type = "feature"
            recommendation = (
                f"Feature drift in: {drifted_feats}. "
                f"Monitor; retrain if trend continues."
            )
        else:
            drift_type = None
            recommendation = "No significant drift detected."

        report = DriftReport(
            model_name=self.model_name,
            timestamp_utc=datetime.now(timezone.utc).isoformat(),
            prediction_kl_divergence=round(kl, 6),
            feature_drift_scores=feature_scores,
            overall_drift_detected=pred_drifted or feat_drifted,
            drift_type=drift_type,
            recommendation=recommendation,
        )

        if self.retrain_trigger.should_retrain(report):
            self.retrain_trigger.trigger(report)

        return report

    def run(self) -> None:
        """Blocking run loop."""
        self._running = True
        logger.info("Drift monitor daemon started (interval=%.0fs)", self.check_interval_s)
        while self._running:
            try:
                report = self.check()
                if report.overall_drift_detected:
                    logger.warning("Drift detected: %s", report.recommendation)
                else:
                    logger.debug("Drift check OK (KL=%.4f)",
                                 report.prediction_kl_divergence)
            except Exception as exc:
                logger.error("Drift monitor error: %s", exc)
            time.sleep(self.check_interval_s)

    def stop(self) -> None:
        self._running = False
