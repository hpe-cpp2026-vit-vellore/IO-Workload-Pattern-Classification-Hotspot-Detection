"""
ml/model_registry/registry.py

Model Registry layer.

Wraps MLflow's model registry with platform-specific conventions:
  - Enforces model naming standards
  - Adds canary validation before production promotion
  - Tracks which model version is live in each environment
  - Provides a load_model() shortcut that fetches the current prod version

Model lifecycle:
  Staging → Canary → Production → Archived

Naming conventions:
  - io-workload-classifier
  - io-hotspot-detector
  - io-capacity-forecaster
  - io-bandwidth-forecaster
"""

from __future__ import annotations

import json
import logging
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

logger = logging.getLogger(__name__)


# ── Registered Model Names ────────────────────────────────────────────────────

MODEL_CLASSIFIER         = "io-workload-classifier"
MODEL_HOTSPOT_DETECTOR   = "io-hotspot-detector"
MODEL_CAPACITY_FORECASTER = "io-capacity-forecaster"
MODEL_BANDWIDTH_FORECASTER = "io-bandwidth-forecaster"

ALL_MODELS = [
    MODEL_CLASSIFIER,
    MODEL_HOTSPOT_DETECTOR,
    MODEL_CAPACITY_FORECASTER,
    MODEL_BANDWIDTH_FORECASTER,
]


@dataclass
class ModelVersion:
    name: str
    version: str
    stage: str          # Staging | Production | Archived
    run_id: str
    artifact_uri: str
    metrics: dict[str, float]
    registered_at: str
    description: str = ""


class ModelRegistry:
    """
    Platform model registry backed by MLflow.

    If MLflow is unavailable (e.g., in tests), falls back to a local
    JSON file registry at ./models/registry.json.
    """

    def __init__(
        self,
        tracking_uri: str = "http://localhost:5000",
        local_fallback_dir: str = "./models",
    ) -> None:
        self.tracking_uri = tracking_uri
        self.fallback_dir = Path(local_fallback_dir)
        self._client = None

    def _get_client(self):
        if self._client is None:
            import mlflow
            mlflow.set_tracking_uri(self.tracking_uri)
            self._client = mlflow.tracking.MlflowClient()
        return self._client

    # ── Registration ──────────────────────────────────────────────────────

    def register_model(
        self,
        model_name: str,
        run_id: str,
        artifact_path: str = "model",
        description: str = "",
    ) -> ModelVersion | None:
        """
        Register a trained model from an MLflow run into the registry.

        Args:
            model_name:     One of the MODEL_* constants above.
            run_id:         MLflow run ID containing the model artifact.
            artifact_path:  Path within the run's artifact store.
            description:    Human-readable description of this version.

        Returns:
            ModelVersion if successful, None on failure.
        """
        try:
            client = self._get_client()

            # Ensure registered model exists
            try:
                client.create_registered_model(
                    model_name,
                    description=f"IO Workload Platform: {model_name}",
                )
            except Exception:
                pass  # Already exists

            mv = client.create_model_version(
                name=model_name,
                source=f"runs:/{run_id}/{artifact_path}",
                run_id=run_id,
                description=description,
            )

            run = client.get_run(run_id)
            metrics = run.data.metrics

            logger.info("Registered %s version %s from run %s",
                        model_name, mv.version, run_id)

            return ModelVersion(
                name=model_name,
                version=mv.version,
                stage="None",
                run_id=run_id,
                artifact_uri=mv.source,
                metrics=metrics,
                registered_at=datetime.now(timezone.utc).isoformat(),
                description=description,
            )

        except Exception as exc:
            logger.error("Failed to register model %s: %s", model_name, exc)
            return None

    # ── Promotion ─────────────────────────────────────────────────────────

    def promote_to_staging(self, model_name: str, version: str) -> bool:
        return self._transition(model_name, version, "Staging")

    def promote_to_production(
        self,
        model_name: str,
        version: str,
        min_metrics: dict[str, float] | None = None,
    ) -> bool:
        """
        Promote a model version to Production.
        Optionally validates against minimum metric thresholds (canary gate).

        Args:
            model_name:  Registered model name.
            version:     Version string to promote.
            min_metrics: e.g. {"f1_macro": 0.95, "precision_macro": 0.95}

        Returns:
            True if promoted successfully; False if gate check failed.
        """
        if min_metrics:
            passed = self._validate_metrics(model_name, version, min_metrics)
            if not passed:
                logger.warning(
                    "Canary gate FAILED for %s v%s — not promoting to production",
                    model_name, version,
                )
                return False

        # Archive current production version
        try:
            client = self._get_client()
            prod_versions = client.get_latest_versions(model_name, stages=["Production"])
            for old_v in prod_versions:
                if old_v.version != version:
                    client.transition_model_version_stage(
                        name=model_name,
                        version=old_v.version,
                        stage="Archived",
                    )
                    logger.info("Archived previous production version: %s v%s",
                                model_name, old_v.version)
        except Exception as exc:
            logger.warning("Could not archive old production version: %s", exc)

        return self._transition(model_name, version, "Production")

    def _transition(self, model_name: str, version: str, stage: str) -> bool:
        try:
            client = self._get_client()
            client.transition_model_version_stage(
                name=model_name, version=version, stage=stage
            )
            logger.info("Transitioned %s v%s → %s", model_name, version, stage)
            return True
        except Exception as exc:
            logger.error("Failed to transition %s v%s to %s: %s",
                         model_name, version, stage, exc)
            return False

    def _validate_metrics(
        self,
        model_name: str,
        version: str,
        min_metrics: dict[str, float],
    ) -> bool:
        try:
            client = self._get_client()
            mv = client.get_model_version(model_name, version)
            run = client.get_run(mv.run_id)
            actual = run.data.metrics

            failed = []
            for metric, threshold in min_metrics.items():
                actual_val = actual.get(metric, 0.0)
                if actual_val < threshold:
                    failed.append(
                        f"{metric}={actual_val:.4f} < required {threshold:.4f}"
                    )
            if failed:
                logger.warning("Canary gate failures: %s", failed)
                return False
            return True
        except Exception as exc:
            logger.error("Metric validation error: %s", exc)
            return False

    # ── Loading ───────────────────────────────────────────────────────────

    def get_latest_production_version(self, model_name: str) -> ModelVersion | None:
        """Return the currently active Production version."""
        try:
            client = self._get_client()
            versions = client.get_latest_versions(model_name, stages=["Production"])
            if not versions:
                return None
            mv = versions[0]
            run = client.get_run(mv.run_id)
            return ModelVersion(
                name=model_name,
                version=mv.version,
                stage="Production",
                run_id=mv.run_id,
                artifact_uri=mv.source,
                metrics=run.data.metrics,
                registered_at=str(mv.creation_timestamp),
            )
        except Exception as exc:
            logger.error("get_latest_production_version failed for %s: %s",
                         model_name, exc)
            return None

    def load_production_model(self, model_name: str) -> Any | None:
        """
        Load the production sklearn/XGBoost model object for local inference.

        Returns:
            Deserialized model object, or None if unavailable.
        """
        try:
            import mlflow.sklearn
            model_uri = f"models:/{model_name}/Production"
            model = mlflow.sklearn.load_model(model_uri)
            logger.info("Loaded production model: %s", model_name)
            return model
        except Exception as exc:
            logger.warning("Could not load %s from MLflow (%s); "
                           "falling back to local file", model_name, exc)
            return self._load_local_fallback(model_name)

    def _load_local_fallback(self, model_name: str) -> Any | None:
        """Load model from local ./models/ directory when MLflow is unavailable."""
        import joblib
        stem = model_name.replace("io-", "").replace("-", "_")
        candidates = [
            self.fallback_dir / f"{stem}_latest.pkl",
            self.fallback_dir / "workload_classifier_latest.pkl",  # for classifier
        ]
        for path in candidates:
            if path.exists():
                try:
                    bundle = joblib.load(path)
                    logger.info("Loaded model from local fallback: %s", path)
                    return bundle
                except Exception as exc:
                    logger.warning("Failed to load %s: %s", path, exc)
        return None

    # ── Listing ───────────────────────────────────────────────────────────

    def list_versions(
        self,
        model_name: str,
        stage: str | None = None,
    ) -> list[ModelVersion]:
        """List all versions (optionally filtered by stage)."""
        try:
            client = self._get_client()
            stages = [stage] if stage else None
            versions = (
                client.get_latest_versions(model_name, stages=stages)
                if stages else
                client.search_model_versions(f"name='{model_name}'")
            )
            result = []
            for mv in versions:
                try:
                    run = client.get_run(mv.run_id)
                    metrics = run.data.metrics
                except Exception:
                    metrics = {}
                result.append(ModelVersion(
                    name=model_name,
                    version=mv.version,
                    stage=mv.current_stage,
                    run_id=mv.run_id,
                    artifact_uri=mv.source,
                    metrics=metrics,
                    registered_at=str(mv.creation_timestamp),
                ))
            return result
        except Exception as exc:
            logger.error("list_versions failed for %s: %s", model_name, exc)
            return []
