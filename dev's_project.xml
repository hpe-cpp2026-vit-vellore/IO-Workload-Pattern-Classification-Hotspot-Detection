<file path="ml/hotspot_detection/detector.py">
"""
ml/hotspot_detection/detector.py

Hotspot and noisy-neighbor detection.

Strategy:
  1. Rule-based fast-path  — fires within the same sample interval (seconds)
  2. ML anomaly detection  — Isolation Forest on rolling window features (minutes)
  3. Threshold learning    — per-volume adaptive baselines (hours)

A "hotspot" is defined as a volume whose resource consumption is abnormally
high AND is causing measurable degradation to co-located volumes (noisy neighbor).
"""

from __future__ import annotations

import json
import logging
import os
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from enum import Enum
from typing import Any

import joblib
import numpy as np
import pandas as pd
from sklearn.ensemble import IsolationForest
from sklearn.preprocessing import StandardScaler

logger = logging.getLogger(__name__)


class HotspotSeverity(str, Enum):
    LOW = "LOW"
    MEDIUM = "MEDIUM"
    HIGH = "HIGH"
    CRITICAL = "CRITICAL"


@dataclass
class HotspotEvent:
    event_id: str
    timestamp_utc: str
    volume_id: str
    node_id: str
    severity: str
    anomaly_score: float
    rule_triggered: str | None
    metrics_snapshot: dict
    estimated_impact_pct: float   # estimated % degradation to neighbours

    def to_json(self) -> str:
        return json.dumps(asdict(self))


#  Rule-Based Fast Path 

class RuleBasedHotspotDetector:
    """
    Stateless, deterministic rules for immediate hotspot flagging.
    Runs on every telemetry sample. Zero latency.
    """

    def __init__(
        self,
        util_high_pct: float = 85.0,
        util_critical_pct: float = 95.0,
        latency_high_us: float = 8_000.0,
        latency_critical_us: float = 15_000.0,
        throughput_saturation_mbps: float = 1_100.0,
    ) -> None:
        self.util_high = util_high_pct
        self.util_critical = util_critical_pct
        self.latency_high = latency_high_us
        self.latency_critical = latency_critical_us
        self.throughput_sat = throughput_saturation_mbps

    def detect(self, metric: dict) -> tuple[bool, str | None, HotspotSeverity]:
        """
        Returns (is_hotspot, rule_name, severity).
        """
        util = metric.get("disk_util_pct", 0)
        latency = metric.get("latency_us", 0)
        throughput = metric.get("throughput_mbps", 0)

        if util >= self.util_critical or latency >= self.latency_critical:
            return True, "critical_threshold", HotspotSeverity.CRITICAL

        if util >= self.util_high and latency >= self.latency_high:
            return True, "combined_high_util_latency", HotspotSeverity.HIGH

        if util >= self.util_high:
            return True, "high_utilization", HotspotSeverity.MEDIUM

        if latency >= self.latency_high:
            return True, "high_latency", HotspotSeverity.MEDIUM

        if throughput >= self.throughput_sat:
            return True, "throughput_saturation", HotspotSeverity.MEDIUM

        return False, None, HotspotSeverity.LOW


#  ML-Based Anomaly Detector 

HOTSPOT_FEATURES = [
    "iops",
    "throughput_mbps",
    "latency_us",
    "disk_util_pct",
    "queue_depth",
    "iops_per_queue_depth",
    "latency_iops_product",
    "util_per_iops",
]


class IsolationForestDetector:
    """
    Isolation Forest for unsupervised anomaly detection.
    Trained on normal (non-hotspot) operational data.
    """

    def __init__(
        self,
        contamination: float = 0.05,
        n_estimators: int = 200,
        random_state: int = 42,
    ) -> None:
        self.contamination = contamination
        self.n_estimators = n_estimators
        self.random_state = random_state
        self._model: IsolationForest | None = None
        self._scaler = StandardScaler()
        self._feature_names: list[str] = HOTSPOT_FEATURES

    def fit(self, df: pd.DataFrame) -> "IsolationForestDetector":
        features = [f for f in self._feature_names if f in df.columns]
        X = df[features].dropna().astype(float)
        X_scaled = self._scaler.fit_transform(X)
        self._model = IsolationForest(
            contamination=self.contamination,
            n_estimators=self.n_estimators,
            random_state=self.random_state,
            n_jobs=-1,
        )
        self._model.fit(X_scaled)
        self._feature_names = features
        logger.info("IsolationForest trained on %d samples", len(X))
        return self

    def score(self, row: dict) -> float:
        """
        Returns anomaly score in [0, 1].
        Higher = more anomalous. 0.5 is the decision boundary.
        """
        if self._model is None:
            raise RuntimeError("Model not trained. Call fit() first.")
        features = [row.get(f, 0.0) for f in self._feature_names]
        X = np.array(features).reshape(1, -1)
        X_scaled = self._scaler.transform(X)
        # decision_function: negative = anomaly; flip and normalize to [0,1]
        raw_score = self._model.decision_function(X_scaled)[0]
        # Normalize: score < 0 → anomaly
        anomaly_score = max(0.0, min(1.0, 0.5 - raw_score))
        return float(anomaly_score)

    def predict(self, row: dict) -> bool:
        """True if anomalous."""
        if self._model is None:
            raise RuntimeError("Model not trained.")
        features = [row.get(f, 0.0) for f in self._feature_names]
        X = np.array(features).reshape(1, -1)
        X_scaled = self._scaler.transform(X)
        return bool(self._model.predict(X_scaled)[0] == -1)

    def save(self, path: str) -> None:
        joblib.dump({
            "model": self._model,
            "scaler": self._scaler,
            "feature_names": self._feature_names,
        }, path)

    @classmethod
    def load(cls, path: str) -> "IsolationForestDetector":
        detector = cls()
        data = joblib.load(path)
        detector._model = data["model"]
        detector._scaler = data["scaler"]
        detector._feature_names = data["feature_names"]
        return detector


#  Composite Detector 

class HotspotDetector:
    """
    Combines rule-based and ML-based detection.
    Both paths run in parallel; the higher severity wins.
    """

    def __init__(
        self,
        rule_detector: RuleBasedHotspotDetector | None = None,
        ml_detector: IsolationForestDetector | None = None,
        ml_anomaly_threshold: float = 0.65,
    ) -> None:
        self._rules = rule_detector or RuleBasedHotspotDetector()
        self._ml = ml_detector  # may be None until trained
        self.ml_threshold = ml_anomaly_threshold
        self._event_counter = 0

    def detect(self, metric: dict) -> HotspotEvent | None:
        import uuid

        rule_hotspot, rule_name, rule_severity = self._rules.detect(metric)

        ml_anomaly_score = 0.0
        ml_hotspot = False
        if self._ml is not None:
            try:
                ml_anomaly_score = self._ml.score(metric)
                ml_hotspot = ml_anomaly_score >= self.ml_threshold
            except Exception as exc:
                logger.debug("ML detector error: %s", exc)

        is_hotspot = rule_hotspot or ml_hotspot

        if not is_hotspot:
            return None

        # Determine final severity
        if ml_hotspot and not rule_hotspot:
            severity = HotspotSeverity.MEDIUM  # ML-only detections start at MEDIUM
        else:
            severity = rule_severity

        # Estimate impact on neighbours (heuristic: proportional to excess utilization)
        util = metric.get("disk_util_pct", 0)
        impact = max(0.0, (util - 80.0) / 20.0 * 30.0)   # 0–30% impact range

        self._event_counter += 1
        return HotspotEvent(
            event_id=str(uuid.uuid4()),
            timestamp_utc=datetime.now(timezone.utc).isoformat(),
            volume_id=metric.get("volume_id", "unknown"),
            node_id=metric.get("node_id", "unknown"),
            severity=severity.value,
            anomaly_score=round(ml_anomaly_score, 4),
            rule_triggered=rule_name,
            metrics_snapshot={
                "iops": metric.get("iops"),
                "throughput_mbps": metric.get("throughput_mbps"),
                "latency_us": metric.get("latency_us"),
                "disk_util_pct": metric.get("disk_util_pct"),
            },
            estimated_impact_pct=round(impact, 1),
        )

    def train_ml(self, df: pd.DataFrame) -> None:
        if self._ml is None:
            self._ml = IsolationForestDetector()
        self._ml.fit(df)

    def save_ml(self, path: str) -> None:
        if self._ml:
            self._ml.save(path)

    def load_ml(self, path: str) -> None:
        self._ml = IsolationForestDetector.load(path)
