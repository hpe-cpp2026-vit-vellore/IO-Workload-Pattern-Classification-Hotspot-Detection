"""
feature_engineering/streaming/consumer.py

Streaming feature engineering worker.
Consumes raw telemetry from Kafka, computes derived features,
writes to the online feature store (Redis) and back to Kafka
(features topic) for downstream consumers.

Runs as a long-lived process on each processing node.

Usage:
    python -m feature_engineering.streaming.consumer
"""

from __future__ import annotations

import json
import logging
import os
import signal
import threading
import time
from collections import defaultdict, deque
from datetime import datetime, timezone

import click
from confluent_kafka import Consumer, Producer, KafkaError

from feature_engineering.features import (
    prepare_feature_vector,
    ALL_FEATURES,
)

logger = logging.getLogger(__name__)


#  In-Process Rolling Window Buffer

class VolumeWindowBuffer:
    """
    Maintains a time-based sliding window of recent telemetry per volume.
    Used to compute rolling statistics without a full Flink/Spark runtime.

    For production with high cardinality volumes, replace with Flink or
    Spark Structured Streaming.
    """

    def __init__(self, window_sizes_s: list[int] | None = None) -> None:
        self.window_sizes_s = window_sizes_s or [10, 60, 300]
        # volume_id → deque of (timestamp, metric_dict)
        self._buffers: dict[str, deque] = defaultdict(
            lambda: deque(maxlen=10_000)
        )

    def push(self, volume_id: str, timestamp_s: float, metrics: dict) -> None:
        self._buffers[volume_id].append((timestamp_s, metrics))

    def compute_rolling_stats(self, volume_id: str, now_s: float) -> dict:
        """Compute mean/std/max/p95 for each window size over IOPS, latency, throughput, util."""
        import numpy as np

        buf = self._buffers.get(volume_id, deque())
        stats = {}

        for w in self.window_sizes_s:
            cutoff = now_s - w
            window_rows = [m for ts, m in buf if ts >= cutoff]

            for metric in ["iops", "throughput_mbps", "latency_us", "disk_util_pct"]:
                vals = [r[metric] for r in window_rows if metric in r]
                arr = np.array(vals) if vals else np.array([0.0])

                stats[f"{metric}_mean_{w}s"] = float(arr.mean())
                stats[f"{metric}_std_{w}s"]  = float(arr.std()) if len(arr) > 1 else 0.0
                stats[f"{metric}_max_{w}s"]  = float(arr.max())
                stats[f"{metric}_p95_{w}s"]  = float(np.percentile(arr, 95))

        return stats


#  Online Feature Store Writer

class RedisFeatureWriter:
    """
    Writes enriched feature vectors to Redis for low-latency inference.
    Key format: feature:{volume_id}
    """

    def __init__(self, host: str = "localhost", port: int = 6379, ttl_s: int = 300) -> None:
        import redis
        self._r = redis.Redis(host=host, port=port, decode_responses=True)
        self.ttl_s = ttl_s

    def write(self, volume_id: str, features: dict) -> None:
        key = f"feature:{volume_id}"
        self._r.hset(key, mapping={k: str(v) for k, v in features.items()})
        self._r.expire(key, self.ttl_s)

    def read(self, volume_id: str) -> dict | None:
        key = f"feature:{volume_id}"
        data = self._r.hgetall(key)
        if not data:
            return None
        return {k: float(v) if _is_numeric(v) else v for k, v in data.items()}


def _is_numeric(s: str) -> bool:
    try:
        float(s)
        return True
    except ValueError:
        return False


#  Streaming Consumer ─

class FeatureEngineeringConsumer:
    """
    Kafka consumer that:
    1. Reads raw telemetry messages
    2. Computes derived + rolling window features
    3. Writes to Redis (online store)
    4. Publishes enriched feature events back to Kafka features topic
    """

    def __init__(
        self,
        bootstrap_servers: str,
        raw_topic: str,
        features_topic: str,
        redis_host: str = "localhost",
        redis_port: int = 6379,
        consumer_group: str = "feature-engineering",
    ) -> None:
        self._consumer = Consumer({
            "bootstrap.servers": bootstrap_servers,
            "group.id": consumer_group,
            "auto.offset.reset": "latest",
            "enable.auto.commit": True,
            "max.poll.interval.ms": 60_000,
        })
        self._producer = Producer({
            "bootstrap.servers": bootstrap_servers,
            "acks": "all",
            "compression.type": "snappy",
        })
        self.raw_topic = raw_topic
        self.features_topic = features_topic
        self._redis = RedisFeatureWriter(host=redis_host, port=redis_port)
        self._window_buffer = VolumeWindowBuffer()
        self._running = False
        self._msg_count = 0

    def run(self) -> None:
        self._consumer.subscribe([self.raw_topic])
        self._running = True
        logger.info("Feature engineering consumer started, topic=%s", self.raw_topic)

        try:
            while self._running:
                msg = self._consumer.poll(timeout=1.0)
                if msg is None:
                    continue
                if msg.error():
                    if msg.error().code() == KafkaError._PARTITION_EOF:
                        continue
                    logger.error("Kafka error: %s", msg.error())
                    continue

                self._process(msg)
        except KeyboardInterrupt:
            pass
        finally:
            self._consumer.close()
            self._producer.flush()
            logger.info("Consumer stopped. Processed %d messages.", self._msg_count)

    def _process(self, msg) -> None:
        try:
            raw = json.loads(msg.value().decode())
        except (json.JSONDecodeError, UnicodeDecodeError) as exc:
            logger.warning("Failed to decode message: %s", exc)
            return

        volume_id = raw.get("volume_id", "unknown")
        now_s = time.time()

        # Update rolling window buffer
        self._window_buffer.push(volume_id, now_s, raw)

        # Compute derived features
        features = prepare_feature_vector(raw)

        # Merge rolling stats
        rolling = self._window_buffer.compute_rolling_stats(volume_id, now_s)
        features.update(rolling)

        # Add metadata
        features["volume_id"] = volume_id
        features["node_id"] = raw.get("node_id", "unknown")
        features["timestamp_utc"] = raw.get("timestamp_utc",
                                             datetime.now(timezone.utc).isoformat())
        if raw.get("workload_label"):
            features["workload_label"] = raw["workload_label"]

        # Write to Redis
        try:
            self._redis.write(volume_id, features)
        except Exception as exc:
            logger.warning("Redis write failed for %s: %s", volume_id, exc)

        # Publish to features topic
        self._producer.produce(
            topic=self.features_topic,
            key=volume_id.encode(),
            value=json.dumps(features).encode(),
        )
        self._producer.poll(0)

        self._msg_count += 1
        if self._msg_count % 1000 == 0:
            logger.info("Processed %d messages", self._msg_count)

    def stop(self) -> None:
        self._running = False


#  CLI ─

@click.command()
@click.option("--bootstrap-servers", default="localhost:9092",
              envvar="KAFKA_BOOTSTRAP_SERVERS")
@click.option("--raw-topic", default="io.telemetry.raw")
@click.option("--features-topic", default="io.telemetry.features")
@click.option("--redis-host", default="localhost", envvar="REDIS_HOST")
@click.option("--redis-port", default=6379, type=int, envvar="REDIS_PORT")
@click.option("--consumer-group", default="feature-engineering")
@click.option("--log-level", default="INFO")
def main(bootstrap_servers, raw_topic, features_topic,
         redis_host, redis_port, consumer_group, log_level):
    """Run the streaming feature engineering consumer."""
    logging.basicConfig(
        level=log_level,
        format="%(asctime)s %(levelname)s %(name)s %(message)s",
    )
    consumer = FeatureEngineeringConsumer(
        bootstrap_servers=bootstrap_servers,
        raw_topic=raw_topic,
        features_topic=features_topic,
        redis_host=redis_host,
        redis_port=redis_port,
        consumer_group=consumer_group,
    )
    consumer.run()


if __name__ == "__main__":
    main()
