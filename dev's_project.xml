# ── Load data ──────────────────────────────────────────────────────────────────
DATA_PATH = Path("data/sample/io_workload_data_sample.csv")

uploaded = st.file_uploader("Upload CSV (or uses sample data)", type=["csv"])
if uploaded:
    df_raw = pd.read_csv(uploaded)
    st.success(f"Loaded uploaded file: {len(df_raw)} rows")
elif DATA_PATH.exists():
    df_raw = pd.read_csv(DATA_PATH)
    st.info(f"Using sample data: `{DATA_PATH}` ({len(df_raw)} rows)")
else:
    st.warning("No data found. Upload a CSV or run the pipeline first.")
    st.stop()

if "workload_type" in df_raw.columns and "workload_label" not in df_raw.columns:
    df_raw = df_raw.rename(columns={"workload_type": "workload_label"})

# Compute derived features
from feature_engineering.features import compute_derived_features, RAW_FEATURES, DERIVED_FEATURES
df = compute_derived_features(df_raw)

CLASS_COLORS = {
    "DB_OLTP":      "#00D4FF",
    "VM":           "#10B981",
    "Backup":       "#F59E0B",
    "AI_Training":  "#8B5CF6",
    "AI_Inference": "#EC4899",
}

# ── Summary stats ──────────────────────────────────────────────────────────────
st.markdown("<div class='section-header'>Dataset Summary</div>", unsafe_allow_html=True)
s1, s2, s3, s4 = st.columns(4)
s1.metric("Total Rows",    len(df))
s2.metric("Features",      len(RAW_FEATURES) + len(DERIVED_FEATURES))
s3.metric("Workload Classes", df["workload_label"].nunique() if "workload_label" in df.columns else "—")
s4.metric("Missing Values",   int(df[RAW_FEATURES].isnull().sum().sum()))

# ── Class distribution ─────────────────────────────────────────────────────────
if "workload_label" in df.columns:
    st.markdown("<div class='section-header'>Class Distribution</div>", unsafe_allow_html=True)
    dist = df["workload_label"].value_counts().reset_index()
    dist.columns = ["class", "count"]
    dist["pct"] = (dist["count"] / len(df) * 100).round(1)

    fig_dist = go.Figure(go.Bar(
        x=dist["class"], y=dist["count"],
        marker_color=[CLASS_COLORS.get(c, "#4B5563") for c in dist["class"]],
        text=[f'{r["count"]} ({r["pct"]}%)' for _, r in dist.iterrows()],
        textposition="outside",
    ))
    fig_dist.update_layout(
        paper_bgcolor="rgba(0,0,0,0)", plot_bgcolor="rgba(0,0,0,0)",
        font_color="#9CA3AF", height=280,
        yaxis=dict(gridcolor="#1F2937"),
        xaxis=dict(gridcolor="#1F2937"),
        margin=dict(l=0, r=0, t=10, b=0),
    )
    st.plotly_chart(fig_dist, use_container_width=True)

# ── Feature distributions ──────────────────────────────────────────────────────
st.markdown("<div class='section-header'>Feature Distributions by Workload Class</div>", unsafe_allow_html=True)

NUMERIC_FEATURES = RAW_FEATURES + DERIVED_FEATURES[:4]
feat_choice = st.selectbox("Feature", NUMERIC_FEATURES, index=0)

if "workload_label" in df.columns:
    fig_box = go.Figure()
    for cls in df["workload_label"].unique():
        vals = df[df["workload_label"] == cls][feat_choice].dropna()
        fig_box.add_trace(go.Box(
            y=vals, name=cls,
            marker_color=CLASS_COLORS.get(cls, "#4B5563"),
            boxmean=True,
        ))
    fig_box.update_layout(
        paper_bgcolor="rgba(0,0,0,0)", plot_bgcolor="rgba(0,0,0,0)",
        font_color="#9CA3AF", height=350,
        yaxis=dict(gridcolor="#1F2937"),
        margin=dict(l=0, r=0, t=10, b=0),
        legend=dict(bgcolor="rgba(0,0,0,0)"),
    )
    st.plotly_chart(fig_box, use_container_width=True)
else:
    fig_hist = px.histogram(df, x=feat_choice, nbins=30,
                            color_discrete_sequence=["#00D4FF"])
    fig_hist.update_layout(paper_bgcolor="rgba(0,0,0,0)", plot_bgcolor="rgba(0,0,0,0)",
                           font_color="#9CA3AF", height=300,
                           margin=dict(l=0,r=0,t=10,b=0))
    st.plotly_chart(fig_hist, use_container_width=True)

# ── Scatter explorer ───────────────────────────────────────────────────────────
st.markdown("<div class='section-header'>Scatter Explorer</div>", unsafe_allow_html=True)
sc1, sc2 = st.columns(2)
x_feat = sc1.selectbox("X axis", NUMERIC_FEATURES, index=0, key="sx")
y_feat = sc2.selectbox("Y axis", NUMERIC_FEATURES, index=2, key="sy")

color_col = "workload_label" if "workload_label" in df.columns else None
sample_df = df.sample(min(500, len(df)), random_state=42)

fig_scatter = go.Figure()
if color_col:
    for cls in sample_df[color_col].unique():
        sub = sample_df[sample_df[color_col] == cls]
        fig_scatter.add_trace(go.Scatter(
            x=sub[x_feat], y=sub[y_feat], mode="markers", name=cls,
            marker=dict(color=CLASS_COLORS.get(cls, "#4B5563"), size=6, opacity=0.7),
        ))
else:
    fig_scatter.add_trace(go.Scatter(
        x=sample_df[x_feat], y=sample_df[y_feat], mode="markers",
        marker=dict(color="#00D4FF", size=5, opacity=0.6),
    ))

fig_scatter.update_layout(
    paper_bgcolor="rgba(0,0,0,0)", plot_bgcolor="rgba(0,0,0,0)",
    font_color="#9CA3AF", height=380,
    xaxis=dict(title=x_feat, gridcolor="#1F2937"),
    yaxis=dict(title=y_feat, gridcolor="#1F2937"),
    margin=dict(l=0, r=0, t=10, b=0),
