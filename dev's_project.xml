#!/usr/bin/env python3
"""
scripts/ingest_sample.py

Quick-start script: reads the sample CSV and replays it to Kafka,
or (if --offline) just runs the batch backfill to the offline store.

Usage:
    # Offline only (no Kafka needed):
    python scripts/ingest_sample.py --offline

    # Stream to Kafka (requires Kafka running):
    python scripts/ingest_sample.py --file data/sample/io_workload_data_sample.csv
"""

import argparse
import logging
import sys
import time
from pathlib import Path

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
)
logger = logging.getLogger(__name__)


def run_offline(file: str, output_dir: str) -> None:
    """Batch backfill to offline store."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    from feature_engineering.batch.backfill import run_backfill

    logger.info("Running offline feature backfill...")
    df = run_backfill(input_path=file, output_dir=output_dir)
    logger.info("Backfill complete: %d rows written to %s", len(df), output_dir)


def run_streaming(file: str, bootstrap_servers: str, topic: str,
                  interval: float, limit: int) -> None:
    """Replay CSV rows to Kafka."""
    sys.path.insert(0, str(Path(__file__).parent.parent))
    from agents.telemetry_agent.agent import (
        CSVReplayCollector, KafkaMetricPublisher, TelemetryAgent
    )
    import pandas as pd

    # Count rows so we know when to stop
    total_rows = len(pd.read_csv(file))
    target = min(limit, total_rows) if limit > 0 else total_rows
    logger.info("Will send %d rows from %s to %s", target, file, topic)

    collector = CSVReplayCollector(csv_path=file, node_id="ingest-script")
    publisher = KafkaMetricPublisher(bootstrap_servers=bootstrap_servers, topic=topic)

    sent = 0
    try:
        while sent < target:
            for metric in collector.collect():
                publisher.publish(metric)
                sent += 1
                if sent % 100 == 0:
                    logger.info("Sent %d/%d messages", sent, target)
                if sent >= target:
                    break
            time.sleep(interval)
    finally:
        publisher.flush()
    logger.info("Ingestion complete: %d messages sent", sent)


def main():
    parser = argparse.ArgumentParser(description="Ingest sample data")
    parser.add_argument("--file", default="data/sample/io_workload_data_sample.csv")
    parser.add_argument("--offline", action="store_true",
                        help="Run batch backfill only (no Kafka required)")
    parser.add_argument("--output-dir", default="data/offline_store")
    parser.add_argument("--bootstrap-servers", default="localhost:9092")
    parser.add_argument("--topic", default="io.telemetry.raw")
    parser.add_argument("--interval", type=float, default=0.01,
                        help="Seconds between messages (streaming mode)")
    parser.add_argument("--limit", type=int, default=0,
                        help="Max messages to send (0 = all)")
    args = parser.parse_args()

    if args.offline:
        run_offline(file=args.file, output_dir=args.output_dir)
    else:
        run_streaming(
            file=args.file,
            bootstrap_servers=args.bootstrap_servers,
            topic=args.topic,
            interval=args.interval,
            limit=args.limit,
        )


if __name__ == "__main__":
    main()
