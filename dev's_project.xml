"""
feature_store/offline/client.py

Offline Feature Store client.

Wraps a Parquet-on-disk store (queryable via DuckDB) with a clean API
for training and batch scoring. Designed to be swapped out for
Apache Iceberg + Trino in production without changing call sites.

Responsibilities:
  - Read feature slices for model training (by label, by date range)
  - Write feature batches from the backfill pipeline
  - Point lookups for historical context (used by forecaster)
  - Simple schema evolution via append-only writes
"""

from __future__ import annotations

import logging
from pathlib import Path
from typing import Any

import pandas as pd

logger = logging.getLogger(__name__)


class OfflineFeatureStore:
    """
    Parquet + DuckDB offline feature store.

    All reads go through DuckDB for efficient predicate pushdown.
    All writes are append-only Parquet files partitioned by date.

    Directory layout:
        root/
          features/
            date=2024-01-01/
              part-000.parquet
            date=2024-01-02/
              part-000.parquet
          labels/
            date=2024-01-01/
              part-000.parquet
    """

    def __init__(self, root: str = "./data/offline_store") -> None:
        self.root = Path(root)
        self._features_dir = self.root / "features"
        self._labels_dir = self.root / "labels"
        self._conn = None   # lazy DuckDB connection

    def _db(self):
        if self._conn is None:
            import duckdb
            self._conn = duckdb.connect()
        return self._conn

    #  Write 

    def write_features(
        self,
        df: pd.DataFrame,
        partition_col: str = "date",
    ) -> None:
        """
        Append-write a DataFrame of feature rows.
        df must contain a 'date' column (string, YYYY-MM-DD).
        """
        if partition_col not in df.columns:
            if "timestamp_utc" in df.columns:
                df = df.copy()
                df["date"] = pd.to_datetime(df["timestamp_utc"], utc=True).dt.date.astype(str)
            else:
                df = df.copy()
                df["date"] = "1970-01-01"

        for date_val, group in df.groupby("date"):
            part_dir = self._features_dir / f"date={date_val}"
            part_dir.mkdir(parents=True, exist_ok=True)
            # Append-safe naming: use nanosecond timestamp to avoid collisions
            import time
            fname = part_dir / f"part-{int(time.time_ns())}.parquet"
            group.drop(columns=["date"]).to_parquet(fname, index=False)

        logger.info("Wrote %d rows to offline feature store", len(df))

    #  Read

    def read_features(
        self,
        start_date: str | None = None,
        end_date: str | None = None,
        columns: list[str] | None = None,
        label_col: str | None = None,
        label_values: list[str] | None = None,
        limit: int | None = None,
    ) -> pd.DataFrame:
        """
        Read features from the offline store.

        Args:
            start_date: ISO date string, inclusive (e.g. "2024-01-01")
            end_date:   ISO date string, inclusive
            columns:    Subset of columns to return (None = all)
            label_col:  Filter by this label column
            label_values: Keep only rows where label_col is in this list
            limit:      Row limit (for sampling / quick checks)

        Returns:
            DataFrame of feature rows.
        """
        if not self._features_dir.exists():
            logger.warning("Offline store not found at %s", self._features_dir)
            return pd.DataFrame()

        # Collect matching partition dirs
        parquet_files = self._collect_parquet_files(
            self._features_dir, start_date, end_date
        )
        if not parquet_files:
            logger.warning("No parquet files found for date range %s – %s",
                           start_date, end_date)
            return pd.DataFrame()

        # Build DuckDB query
        file_list = ", ".join(f"'{f}'" for f in parquet_files)
        col_expr = "*" if not columns else ", ".join(columns)
        query = f"SELECT {col_expr} FROM read_parquet([{file_list}])"

        filters = []
        if label_col and label_values:
            vals = ", ".join(f"'{v}'" for v in label_values)
            filters.append(f"{label_col} IN ({vals})")
        if filters:
            query += " WHERE " + " AND ".join(filters)
        if limit:
            query += f" LIMIT {limit}"

        try:
            df = self._db().execute(query).df()
            logger.debug("Read %d rows from offline store (query=%s...)", len(df), query[:80])
            return df
        except Exception as exc:
            logger.error("Offline store read failed: %s", exc)
            return pd.DataFrame()

    def read_training_set(
        self,
        label_col: str = "workload_label",
        start_date: str | None = None,
        end_date: str | None = None,
    ) -> pd.DataFrame:
        """
        Convenience method: read all labelled rows for model training.
        Filters out rows where the label column is null.
        """
        df = self.read_features(
            start_date=start_date,
            end_date=end_date,
            label_col=label_col,
            label_values=None,
        )
        if label_col in df.columns:
            df = df[df[label_col].notna()]
        return df

    def read_volume_history(
        self,
        volume_id: str,
        start_date: str | None = None,
        end_date: str | None = None,
        max_rows: int = 10_000,
    ) -> pd.DataFrame:
        """
        Read historical telemetry for a single volume.
        Used by the forecaster to build trend models.
        """
        parquet_files = self._collect_parquet_files(
            self._features_dir, start_date, end_date
        )
        if not parquet_files:
            return pd.DataFrame()

        file_list = ", ".join(f"'{f}'" for f in parquet_files)
        query = (
            f"SELECT * FROM read_parquet([{file_list}]) "
            f"WHERE volume_id = '{volume_id}' "
            f"ORDER BY timestamp_utc "
            f"LIMIT {max_rows}"
        )
        try:
            return self._db().execute(query).df()
        except Exception as exc:
            logger.error("read_volume_history failed: %s", exc)
            return pd.DataFrame()

    #  Schema / Stats 

    def schema(self) -> dict[str, str] | None:
        """Return column → dtype mapping from first available parquet file."""
        parquets = list(self._features_dir.rglob("*.parquet")) if self._features_dir.exists() else []
        if not parquets:
            return None
        try:
            df = pd.read_parquet(parquets[0], engine="pyarrow")
            return {c: str(t) for c, t in df.dtypes.items()}
        except Exception as exc:
            logger.error("schema() failed: %s", exc)
            return None

    def stats(self) -> dict[str, Any]:
        parquets = list(self._features_dir.rglob("*.parquet")) if self._features_dir.exists() else []
        total_size_mb = sum(p.stat().st_size for p in parquets) / 1024 / 1024
        dates = sorted(set(
            p.parent.name.replace("date=", "") for p in parquets
        ))
        return {
            "parquet_files": len(parquets),
            "total_size_mb": round(total_size_mb, 2),
            "date_partitions": len(dates),
            "date_range": f"{dates[0]} – {dates[-1]}" if dates else "empty",
        }

    #  Internal 

    def _collect_parquet_files(
        self,
        base_dir: Path,
        start_date: str | None,
        end_date: str | None,
    ) -> list[str]:
        if not base_dir.exists():
            return []
        files = []
        for part_dir in sorted(base_dir.iterdir()):
            if not part_dir.is_dir():
                continue
            date_str = part_dir.name.replace("date=", "")
            if start_date and date_str < start_date:
                continue
            if end_date and date_str > end_date:
                continue
            for pf in sorted(part_dir.glob("*.parquet")):
                files.append(str(pf))
        return files
