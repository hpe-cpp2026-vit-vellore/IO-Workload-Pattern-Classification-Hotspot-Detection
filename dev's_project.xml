"""
autoscaler/planner.py

Capacity Planning & Auto-Scale Engine.

Analyses cluster-wide capacity trends and produces:
  - Expansion recommendations (add nodes / expand pools)
  - Re-tiering recommendations (move cold data to cheaper tier)
  - QoS shaping recommendations (throttle noisy workloads)
  - Automated scale-out actions (under guardrails, when enabled)

Inputs (polled on schedule):
  - Offline feature store: historical utilization per node/pool
  - Forecast results from ForecastingPipeline

Output:
  - CapacityPlan with prioritised recommendations
  - Optional auto-scale action if guardrails permit
"""

from __future__ import annotations

import logging
from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import Enum
from typing import Any

logger = logging.getLogger(__name__)


class RecommendationType(str, Enum):
    ADD_NODES           = "ADD_NODES"
    EXPAND_POOL         = "EXPAND_POOL"
    TIER_COLD_DATA      = "TIER_COLD_DATA"
    QOS_SHAPE           = "QOS_SHAPE"
    RESCHEDULE_JOBS     = "RESCHEDULE_JOBS"
    NO_ACTION           = "NO_ACTION"


class Urgency(str, Enum):
    INFO     = "INFO"       # > 90 days headroom
    LOW      = "LOW"        # 30–90 days
    MEDIUM   = "MEDIUM"     # 7–30 days
    HIGH     = "HIGH"       # 3–7 days
    CRITICAL = "CRITICAL"   # < 3 days


@dataclass
class Recommendation:
    rec_id: str
    rec_type: str
    urgency: str
    title: str
    description: str
    estimated_headroom_gained_days: float
    estimated_cost_impact: str          # "low" | "medium" | "high"
    auto_actionable: bool               # can be done without human approval
    payload: dict = field(default_factory=dict)


@dataclass
class CapacityPlan:
    plan_id: str
    timestamp_utc: str
    cluster_id: str
    recommendations: list[Recommendation]
    overall_urgency: str
    summary: str
    auto_scale_triggered: bool = False


@dataclass
class NodeCapacityState:
    node_id: str
    tier: str
    total_capacity_gb: float
    used_capacity_gb: float
    util_pct: float
    days_to_fill: float | None          # from forecaster
    throughput_p99_mbps: float
    latency_p99_us: float
    workload_mix: dict[str, float] = field(default_factory=dict)  # class → fraction


@dataclass
class ClusterCapacityState:
    cluster_id: str
    nodes: list[NodeCapacityState]
    total_capacity_gb: float
    used_capacity_gb: float
    overall_util_pct: float
    min_days_to_fill: float | None      # worst node


class CapacityPlanner:
    """
    Analyses cluster state and produces a prioritised CapacityPlan.
    """

    def __init__(
        self,
        warning_util_pct: float = 80.0,
        critical_util_pct: float = 90.0,
        warning_dtf_days: float = 30.0,
        critical_dtf_days: float = 7.0,
        auto_scale_enabled: bool = False,
        auto_scale_max_nodes: int = 3,
    ) -> None:
        self.warning_util    = warning_util_pct
        self.critical_util   = critical_util_pct
        self.warning_dtf     = warning_dtf_days
        self.critical_dtf    = critical_dtf_days
        self.auto_scale_enabled  = auto_scale_enabled
        self.auto_scale_max_nodes = auto_scale_max_nodes
        self._rec_counter = 0

    def plan(self, cluster: ClusterCapacityState) -> CapacityPlan:
        import uuid

        recs: list[Recommendation] = []

        for node in sorted(cluster.nodes, key=lambda n: n.util_pct, reverse=True):
            node_recs = self._analyse_node(node)
            recs.extend(node_recs)

        # Cluster-level check: if multiple nodes critical, recommend expansion
        critical_nodes = [n for n in cluster.nodes
                          if n.util_pct >= self.critical_util
                          or (n.days_to_fill is not None and n.days_to_fill < self.critical_dtf)]
        if len(critical_nodes) >= 2:
            recs.append(Recommendation(
                rec_id=self._next_id(),
                rec_type=RecommendationType.ADD_NODES.value,
                urgency=Urgency.CRITICAL.value,
                title=f"Add storage nodes ({len(critical_nodes)} nodes critical)",
                description=(
                    f"{len(critical_nodes)} nodes are at critical capacity. "
                    f"Recommend adding {min(len(critical_nodes), self.auto_scale_max_nodes)} "
                    f"new nodes to the cluster."
                ),
                estimated_headroom_gained_days=60.0,
                estimated_cost_impact="high",
                auto_actionable=self.auto_scale_enabled,
                payload={"node_count_to_add": min(len(critical_nodes), self.auto_scale_max_nodes)},
            ))

        # Deduplicate and sort by urgency
        urgency_order = {
            Urgency.CRITICAL.value: 0,
            Urgency.HIGH.value: 1,
            Urgency.MEDIUM.value: 2,
            Urgency.LOW.value: 3,
            Urgency.INFO.value: 4,
        }
        recs.sort(key=lambda r: urgency_order.get(r.urgency, 9))

        # Determine overall urgency
        overall_urgency = recs[0].urgency if recs else Urgency.INFO.value

        # Auto-scale decision
        auto_triggered = False
        if self.auto_scale_enabled:
            for rec in recs:
                if rec.auto_actionable and rec.urgency in (
                    Urgency.CRITICAL.value, Urgency.HIGH.value
                ):
                    logger.warning(
                        "AUTO-SCALE triggered: %s", rec.title
                    )
                    auto_triggered = True
                    break

        summary = self._build_summary(cluster, recs)

        return CapacityPlan(
            plan_id=str(uuid.uuid4()),
            timestamp_utc=datetime.now(timezone.utc).isoformat(),
            cluster_id=cluster.cluster_id,
            recommendations=recs,
            overall_urgency=overall_urgency,
            summary=summary,
            auto_scale_triggered=auto_triggered,
        )

    def _analyse_node(self, node: NodeCapacityState) -> list[Recommendation]:
        recs = []

        # Capacity exhaustion
        dtf = node.days_to_fill
        if dtf is not None:
            if dtf < self.critical_dtf:
                urgency = Urgency.CRITICAL.value
            elif dtf < self.warning_dtf:
                urgency = Urgency.MEDIUM.value if dtf > 7 else Urgency.HIGH.value
            else:
                urgency = Urgency.LOW.value

            if dtf < self.warning_dtf:
                # Check if Backup workloads can be moved to cheaper tier
                backup_fraction = node.workload_mix.get("Backup", 0.0)
                if backup_fraction > 0.1:
                    recs.append(Recommendation(
                        rec_id=self._next_id(),
                        rec_type=RecommendationType.TIER_COLD_DATA.value,
                        urgency=urgency,
                        title=f"Node {node.node_id}: tier backup data to object storage",
                        description=(
                            f"Node has {backup_fraction:.0%} backup workload. "
                            f"Moving to object storage tier could free ~"
                            f"{node.used_capacity_gb * backup_fraction:.0f} GB "
                            f"and extend headroom by est. {dtf * (1 / max(1 - backup_fraction, 0.1)):.0f} days."
                        ),
                        estimated_headroom_gained_days=dtf * backup_fraction / max(node.util_pct / 100, 0.01),
                        estimated_cost_impact="low",
                        auto_actionable=True,
                        payload={"node_id": node.node_id, "target_tier": "object",
                                 "workload_type": "Backup"},
                    ))
                else:
                    recs.append(Recommendation(
                        rec_id=self._next_id(),
                        rec_type=RecommendationType.EXPAND_POOL.value,
                        urgency=urgency,
                        title=f"Node {node.node_id}: expand storage pool",
                        description=(
                            f"Estimated {dtf:.0f} days to fill at current growth rate "
                            f"(util={node.util_pct:.1f}%). Expand pool or add drives."
                        ),
                        estimated_headroom_gained_days=dtf * 2,
                        estimated_cost_impact="medium",
                        auto_actionable=False,
                        payload={"node_id": node.node_id},
                    ))

        # QoS shaping for noisy neighbours
        if node.latency_p99_us > 8000 and node.throughput_p99_mbps > 800:
            recs.append(Recommendation(
                rec_id=self._next_id(),
                rec_type=RecommendationType.QOS_SHAPE.value,
                urgency=Urgency.HIGH.value,
                title=f"Node {node.node_id}: apply QoS to high-throughput workloads",
                description=(
                    f"p99 latency={node.latency_p99_us:.0f}µs with p99 throughput="
                    f"{node.throughput_p99_mbps:.0f} MB/s suggests throughput-heavy "
                    f"workloads (Backup/AI_Training) are impacting latency-sensitive workloads."
                ),
                estimated_headroom_gained_days=0.0,
                estimated_cost_impact="low",
                auto_actionable=True,
                payload={"node_id": node.node_id, "throttle_classes": ["Backup", "AI_Training"]},
            ))

        return recs

    def _next_id(self) -> str:
        self._rec_counter += 1
        return f"rec-{self._rec_counter:04d}"

    def _build_summary(
        self, cluster: ClusterCapacityState, recs: list[Recommendation]
    ) -> str:
        n_critical = sum(1 for r in recs if r.urgency == Urgency.CRITICAL.value)
        n_high = sum(1 for r in recs if r.urgency == Urgency.HIGH.value)
        if n_critical > 0:
            return (f"CRITICAL: {n_critical} critical capacity recommendations. "
                    f"Immediate action required.")
        if n_high > 0:
            return (f"WARNING: {n_high} high-priority recommendations. "
                    f"Cluster util={cluster.overall_util_pct:.1f}%.")
        if recs:
            return (f"Cluster healthy (util={cluster.overall_util_pct:.1f}%). "
                    f"{len(recs)} low-priority recommendations.")
        return f"Cluster healthy. util={cluster.overall_util_pct:.1f}%. No action required."
