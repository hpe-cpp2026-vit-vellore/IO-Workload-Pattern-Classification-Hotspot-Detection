"""
tests/unit/test_forecaster.py
"""

import pandas as pd
import numpy as np
import pytest
from datetime import datetime, timezone, timedelta

from ml.forecasting.forecaster import (
    CapacityForecaster,
    BandwidthForecaster,
    LatencyRiskForecaster,
    ForecastingPipeline,
)


def _history(n=30, start_util=50.0, slope_per_sample=0.5,
             throughput_base=200.0, latency_base=1000.0):
    """Generate synthetic history DataFrame."""
    base = datetime(2024, 1, 1, tzinfo=timezone.utc)
    rows = []
    for i in range(n):
        rows.append({
            "timestamp_utc": (base + timedelta(hours=i)).isoformat(),
            "disk_util_pct": start_util + slope_per_sample * i,
            "throughput_mbps": throughput_base + np.random.normal(0, 10),
            "latency_us": latency_base + np.random.normal(0, 50),
            "iops": 10000.0,
        })
    return pd.DataFrame(rows)


class TestCapacityForecaster:
    def setup_method(self):
        self.forecaster = CapacityForecaster(
            warning_threshold_pct=80.0,
            critical_threshold_pct=90.0,
        )

    def test_returns_forecast_object(self):
        df = _history()
        result = self.forecaster.forecast("vol-01", df)
        assert result is not None
        assert result.volume_id == "vol-01"

    def test_positive_slope_gives_dtf(self):
        # util starts at 50 and grows — should produce a finite DTF
        df = _history(n=50, start_util=50.0, slope_per_sample=0.5)
        result = self.forecaster.forecast("vol-01", df)
        assert result.days_to_fill is not None
        assert result.days_to_fill > 0

    def test_flat_or_declining_util_no_dtf(self):
        df = _history(n=30, start_util=50.0, slope_per_sample=-0.1)
        result = self.forecaster.forecast("vol-01", df)
        assert result.days_to_fill is None

    def test_insufficient_history_returns_low_confidence(self):
        df = _history(n=3)
        result = self.forecaster.forecast("vol-01", df)
        assert result.confidence == 0.0

    def test_critical_warning_when_low_dtf(self):
        # Fast-growing utilization
        df = _history(n=30, start_util=88.0, slope_per_sample=0.3)
        result = self.forecaster.forecast("vol-01", df)
        assert result.warning_level in ("CRITICAL", "WARNING")

    def test_ok_warning_when_plenty_of_headroom(self):
        df = _history(n=30, start_util=10.0, slope_per_sample=0.05)
        result = self.forecaster.forecast("vol-01", df)
        assert result.warning_level == "OK"


class TestBandwidthForecaster:
    def setup_method(self):
        self.forecaster = BandwidthForecaster(horizon_hours=72)

    def test_returns_forecast_object(self):
        df = _history()
        result = self.forecaster.forecast("vol-01", df)
        assert result.p50_mbps >= 0
        assert result.p95_mbps >= result.p50_mbps
        assert result.p99_mbps >= result.p95_mbps

    def test_quantile_ordering(self):
        df = _history(n=100, throughput_base=500.0)
        result = self.forecaster.forecast("vol-01", df)
        assert result.p50_mbps <= result.p95_mbps <= result.p99_mbps

    def test_empty_history_returns_zeros(self):
        df = pd.DataFrame()
        result = self.forecaster.forecast("vol-01", df)
        assert result.p50_mbps == 0.0


class TestLatencyRiskForecaster:
    def setup_method(self):
        self.forecaster = LatencyRiskForecaster(slo_p99_us=5_000.0)

    def test_low_risk_for_normal_workload(self):
        df = _history(n=50, latency_base=500.0, throughput_base=100.0)
        from ml.forecasting.forecaster import BandwidthForecast
        bw = BandwidthForecast("vol-01", "now", 72, 100, 120, 140, "now")
        result = self.forecaster.forecast("vol-01", df, bw)
        assert result.risk_level in ("LOW", "MEDIUM")
        assert result.slo_breach_probability < 0.5

    def test_critical_risk_for_high_latency_high_throughput(self):
        df = _history(n=50, latency_base=3_000.0, throughput_base=800.0)
        from ml.forecasting.forecaster import BandwidthForecast
        bw = BandwidthForecast("vol-01", "now", 72, 1500, 2000, 2500, "now")
        result = self.forecaster.forecast("vol-01", df, bw)
        assert result.risk_level in ("HIGH", "CRITICAL")
        assert result.slo_breach_probability > 0.5


class TestForecastingPipeline:
    def test_run_returns_all_forecast_types(self):
        df = _history(n=40)
        pipeline = ForecastingPipeline(horizon_hours=72)
        result = pipeline.run("vol-01", df)

        assert "capacity_forecast" in result
        assert "bandwidth_forecast" in result
        assert "latency_risk_forecast" in result
        assert "summary" in result

    def test_summary_has_required_keys(self):
        df = _history(n=40)
        pipeline = ForecastingPipeline()
        result = pipeline.run("vol-01", df)
        summary = result["summary"]

        for key in ["days_to_fill", "capacity_warning",
                    "p99_bandwidth_mbps", "latency_risk", "slo_breach_probability"]:
            assert key in summary, f"Missing key: {key}"
