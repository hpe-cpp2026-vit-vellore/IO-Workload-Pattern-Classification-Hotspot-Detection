"""
ml/forecasting/forecaster.py

Capacity and performance forecasting.

Forecasts produced:
  - days_to_fill (DTF)     — when will disk capacity exhaust
  - bandwidth_demand       — p50/p95/p99 throughput over next N hours
  - latency_risk           — tail latency risk under forecast load

Uses a simple but production-robust approach:
  1. Linear trend + seasonal decomposition (STL) for capacity
  2. Quantile regression / rolling quantiles for bandwidth
  3. Derived latency risk from bandwidth demand vs. observed baseline

For production, replace or augment with Prophet or a Temporal Fusion Transformer.
"""

from __future__ import annotations

import logging
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from typing import Any

import numpy as np
import pandas as pd

logger = logging.getLogger(__name__)


@dataclass
class CapacityForecast:
    volume_id: str
    timestamp_utc: str
    current_util_pct: float
    days_to_fill: float | None         # None if not trending toward full
    fill_date_estimate: str | None
    confidence: float                  # 0–1
    trend_slope_pct_per_day: float
    warning_level: str                 # OK / WARNING / CRITICAL


@dataclass
class BandwidthForecast:
    volume_id: str
    timestamp_utc: str
    horizon_hours: int
    p50_mbps: float
    p95_mbps: float
    p99_mbps: float
    peak_window: str                   # ISO timestamp of predicted peak


@dataclass
class LatencyRiskForecast:
    volume_id: str
    timestamp_utc: str
    current_p99_us: float
    forecast_p99_us: float
    risk_level: str                    # LOW / MEDIUM / HIGH / CRITICAL
    slo_breach_probability: float      # 0–1


class CapacityForecaster:
    """
    Forecasts days-to-fill using linear regression over utilization trend.
    """

    def __init__(
        self,
        warning_threshold_pct: float = 80.0,
        critical_threshold_pct: float = 90.0,
        min_history_points: int = 10,
    ) -> None:
        self.warning_threshold = warning_threshold_pct
        self.critical_threshold = critical_threshold_pct
        self.min_history = min_history_points

    def forecast(
        self,
        volume_id: str,
        history: pd.DataFrame,
        util_col: str = "disk_util_pct",
        ts_col: str = "timestamp_utc",
        capacity_pct_full: float = 100.0,
    ) -> CapacityForecast:
        """
        Args:
            volume_id: Volume identifier.
            history: DataFrame with timestamp and utilization columns.
            util_col: Column name for utilization %.
            ts_col: Column name for timestamps.
            capacity_pct_full: The utilization % that represents 100% full.

        Returns:
            CapacityForecast with days_to_fill estimate.
        """
        now = datetime.now(timezone.utc).isoformat()

        if len(history) < self.min_history:
            return CapacityForecast(
                volume_id=volume_id,
                timestamp_utc=now,
                current_util_pct=float(history[util_col].iloc[-1]) if len(history) else 0.0,
                days_to_fill=None,
                fill_date_estimate=None,
                confidence=0.0,
                trend_slope_pct_per_day=0.0,
                warning_level="OK",
            )

        df = history.copy()
        df[ts_col] = pd.to_datetime(df[ts_col], utc=True)
        df = df.sort_values(ts_col)

        t0 = df[ts_col].iloc[0]
        df["days_elapsed"] = (df[ts_col] - t0).dt.total_seconds() / 86400

        x = df["days_elapsed"].values
        y = df[util_col].values

        # linear regression
        coeffs = np.polyfit(x, y, deg=1)
        slope = float(coeffs[0])  # perc per day
        intercept = float(coeffs[1])

        current_util = float(y[-1])
        current_x = float(x[-1])

        y_pred = np.polyval(coeffs, x)
        ss_res = np.sum((y - y_pred) ** 2)
        ss_tot = np.sum((y - y.mean()) ** 2)
        r2 = float(1 - ss_res / (ss_tot + 1e-9))
        confidence = max(0.0, min(1.0, r2))

        if slope <= 0:
            dtf = None
            fill_date = None
        else:
            days_remaining = (capacity_pct_full - current_util) / slope
            dtf = float(days_remaining) if days_remaining > 0 else 0.0
            fill_date = (datetime.now(timezone.utc) + timedelta(days=dtf)).isoformat()

        # Warning level
        if current_util >= self.critical_threshold or (dtf is not None and dtf < 7):
            warning_level = "CRITICAL"
        elif current_util >= self.warning_threshold or (dtf is not None and dtf < 30):
            warning_level = "WARNING"
        else:
            warning_level = "OK"

        return CapacityForecast(
            volume_id=volume_id,
            timestamp_utc=now,
            current_util_pct=round(current_util, 2),
            days_to_fill=round(dtf, 1) if dtf is not None else None,
            fill_date_estimate=fill_date,
            confidence=round(confidence, 3),
            trend_slope_pct_per_day=round(slope, 4),
            warning_level=warning_level,
        )


class BandwidthForecaster:
    """
    Forecasts bandwidth demand using rolling quantiles.
    """

    def __init__(self, horizon_hours: int = 72) -> None:
        self.horizon_hours = horizon_hours

    def forecast(
        self,
        volume_id: str,
        history: pd.DataFrame,
        tp_col: str = "throughput_mbps",
        ts_col: str = "timestamp_utc",
    ) -> BandwidthForecast:
        now = datetime.now(timezone.utc)

        if len(history) < 5:
            return BandwidthForecast(
                volume_id=volume_id,
                timestamp_utc=now.isoformat(),
                horizon_hours=self.horizon_hours,
                p50_mbps=0.0, p95_mbps=0.0, p99_mbps=0.0,
                peak_window=now.isoformat(),
            )

        tp = history[tp_col].astype(float)

        # Find time of historical peak
        peak_idx = tp.idxmax()
        try:
            peak_ts = history[ts_col].iloc[peak_idx]
        except Exception:
            peak_ts = now.isoformat()

        return BandwidthForecast(
            volume_id=volume_id,
            timestamp_utc=now.isoformat(),
            horizon_hours=self.horizon_hours,
            p50_mbps=round(float(tp.quantile(0.50)), 2),
            p95_mbps=round(float(tp.quantile(0.95)), 2),
            p99_mbps=round(float(tp.quantile(0.99)), 2),
            peak_window=str(peak_ts),
        )


class LatencyRiskForecaster:
    """
    Estimates future tail-latency risk based on forecast bandwidth vs. baseline.
    """

    def __init__(self, slo_p99_us: float = 5000.0) -> None:
        self.slo_p99_us = slo_p99_us

    def forecast(
        self,
        volume_id: str,
        history: pd.DataFrame,
        bandwidth_forecast: BandwidthForecast,
        lat_col: str = "latency_us",
        tp_col: str = "throughput_mbps",
    ) -> LatencyRiskForecast:
        now = datetime.now(timezone.utc).isoformat()

        current_p99 = float(history[lat_col].quantile(0.99)) if len(history) > 5 else 0.0

        # Heuristic: latency scales roughly with bandwidth utilization
        # At p99 bandwidth, expect proportionally higher latency
        baseline_tp = float(history[tp_col].median()) if len(history) > 5 else 1.0
        forecast_ratio = bandwidth_forecast.p99_mbps / max(baseline_tp, 1.0)
        forecast_p99 = current_p99 * min(forecast_ratio ** 1.5, 5.0)  # cap 5x

        # SLO breach probability
        if forecast_p99 <= self.slo_p99_us * 0.7:
            risk = "LOW"
            breach_prob = 0.05
        elif forecast_p99 <= self.slo_p99_us:
            risk = "MEDIUM"
            breach_prob = 0.25
        elif forecast_p99 <= self.slo_p99_us * 1.5:
            risk = "HIGH"
            breach_prob = 0.65
        else:
            risk = "CRITICAL"
            breach_prob = 0.95

        return LatencyRiskForecast(
            volume_id=volume_id,
            timestamp_utc=now,
            current_p99_us=round(current_p99, 1),
            forecast_p99_us=round(forecast_p99, 1),
            risk_level=risk,
            slo_breach_probability=round(breach_prob, 2),
        )


class ForecastingPipeline:
    """
    Orchestrates all three forecasters for a single volume.
    """

    def __init__(
        self,
        horizon_hours: int = 72,
        slo_p99_us: float = 5000.0,
    ) -> None:
        self.capacity = CapacityForecaster()
        self.bandwidth = BandwidthForecaster(horizon_hours=horizon_hours)
        self.latency = LatencyRiskForecaster(slo_p99_us=slo_p99_us)

    def run(
        self,
        volume_id: str,
        history: pd.DataFrame,
    ) -> dict[str, Any]:
        cap = self.capacity.forecast(volume_id, history)
        bw = self.bandwidth.forecast(volume_id, history)
        lat = self.latency.forecast(volume_id, history, bw)

        return {
            "capacity_forecast": cap,
            "bandwidth_forecast": bw,
            "latency_risk_forecast": lat,
            "summary": {
                "days_to_fill": cap.days_to_fill,
                "capacity_warning": cap.warning_level,
                "p99_bandwidth_mbps": bw.p99_mbps,
                "latency_risk": lat.risk_level,
                "slo_breach_probability": lat.slo_breach_probability,
            },
        }
