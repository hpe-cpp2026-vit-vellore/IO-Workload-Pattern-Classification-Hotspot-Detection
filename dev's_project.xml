"""
config/settings.py
Loads layered YAML configs (base → environment override) and exposes
a single Settings object used across all platform components.
"""

from __future__ import annotations

import os
from functools import lru_cache
from pathlib import Path
from typing import Any

import yaml


CONFIG_DIR = Path(__file__).parent


def _deep_merge(base: dict, override: dict) -> dict:
    """Recursively merge override into base, returning a new dict."""
    result = dict(base)
    for key, val in override.items():
        if key in result and isinstance(result[key], dict) and isinstance(val, dict):
            result[key] = _deep_merge(result[key], val)
        else:
            result[key] = val
    return result


def _load_yaml(path: Path) -> dict:
    with open(path) as f:
        return yaml.safe_load(f) or {}


@lru_cache(maxsize=1)
def load_config(env: str | None = None) -> dict[str, Any]:
    """
    Load configuration for the given environment.

    Priority (highest wins):
      1. Environment variables (KAFKA__BOOTSTRAP_SERVERS, etc.)
      2. config/<env>.yaml
      3. config/base.yaml

    Args:
        env: Environment name (dev, staging, prod). Defaults to
             the ENV environment variable, falling back to "dev".

    Returns:
        Merged config dictionary.
    """
    env = env or os.getenv("ENV", "dev")

    base = _load_yaml(CONFIG_DIR / "base.yaml")

    env_file = CONFIG_DIR / f"{env}.yaml"
    if env_file.exists():
        override = _load_yaml(env_file)
        config = _deep_merge(base, override)
    else:
        config = base

    return config


class _Section:
    """Thin wrapper that allows dot-access on a config sub-dict."""

    def __init__(self, data: dict) -> None:
        self._data = data

    def __getattr__(self, item: str) -> Any:
        try:
            val = self._data[item]
            return _Section(val) if isinstance(val, dict) else val
        except KeyError:
            raise AttributeError(f"Config key '{item}' not found") from None

    def __getitem__(self, item: str) -> Any:
        return self._data[item]

    def get(self, item: str, default: Any = None) -> Any:
        return self._data.get(item, default)

    def as_dict(self) -> dict:
        return self._data


class Settings(_Section):
    """Top-level settings object. Import and use as a singleton."""

    def __init__(self, env: str | None = None) -> None:
        super().__init__(load_config(env))

    @property
    def kafka(self) -> _Section:
        return _Section(self._data["kafka"])

    @property
    def redis(self) -> _Section:
        return _Section(self._data["redis"])

    @property
    def mlflow(self) -> _Section:
        return _Section(self._data["mlflow"])

    @property
    def feature_engineering(self) -> _Section:
        return _Section(self._data["feature_engineering"])

    @property
    def offline_store(self) -> _Section:
        return _Section(self._data["offline_store"])

    @property
    def inference(self) -> _Section:
        return _Section(self._data["inference"])

    @property
    def decision_engine(self) -> _Section:
        return _Section(self._data["decision_engine"])

    @property
    def rebalancer(self) -> _Section:
        return _Section(self._data["rebalancer"])

    @property
    def autoscaler(self) -> _Section:
        return _Section(self._data["autoscaler"])

    @property
    def observability(self) -> _Section:
        return _Section(self._data["observability"])


# Module-level singleton — import this everywhere
settings = Settings()
</file>

