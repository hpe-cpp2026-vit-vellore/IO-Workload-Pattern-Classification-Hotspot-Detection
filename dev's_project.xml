#  Model Drift Detector 

class ModelDriftDetector:
    """
    Detects distribution shift between training-time predictions
    and live production predictions using KL-divergence.

    If drift exceeds threshold, signals that model retraining is needed.
    """

    def __init__(
        self,
        classes: list[str],
        reference_distribution: dict[str, float] | None = None,
        window_size: int = 1000,
        drift_threshold: float = 0.1,
    ) -> None:
        self.classes = classes
        self.window_size = window_size
        self.drift_threshold = drift_threshold
        self._window: deque[str] = deque(maxlen=window_size)
        self._reference = reference_distribution  # from training set label distribution

    def record_prediction(self, predicted_class: str) -> None:
        self._window.append(predicted_class)

    def compute_kl_divergence(self) -> float:
        """KL(production || reference). Returns 0 if no reference set."""
        if not self._reference or len(self._window) < 50:
            return 0.0

        import numpy as np
        counts = {c: 0 for c in self.classes}
        for pred in self._window:
            if pred in counts:
                counts[pred] += 1

        total = max(sum(counts.values()), 1)
        prod_dist = {c: (counts[c] + 1e-9) / (total + len(self.classes) * 1e-9)
                     for c in self.classes}

        ref_total = sum(self._reference.values())
        ref_dist = {c: self._reference.get(c, 1e-9) / ref_total
                    for c in self.classes}

        kl = sum(
            prod_dist[c] * np.log(prod_dist[c] / ref_dist[c])
            for c in self.classes
        )
        return float(kl)

    def is_drifted(self) -> bool:
        return self.compute_kl_divergence() > self.drift_threshold


#  Structured Logger 

class AuditLogger:
    """
    Writes structured audit events to the io.audit.log Kafka topic.
    All control-plane decisions are logged for compliance and post-mortems.
    """

    def __init__(self, publisher=None) -> None:
        self._publisher = publisher
        self._local_logger = logging.getLogger("audit")

    def log(self, event_type: str, payload: dict) -> None:
        import json
        from datetime import datetime, timezone
        event = {
            "event_type": event_type,
            "timestamp_utc": datetime.now(timezone.utc).isoformat(),
            **payload,
        }
        self._local_logger.info("AUDIT %s: %s", event_type, json.dumps(event))

        if self._publisher:
            try:
                self._publisher.publish_raw(
                    topic="io.audit.log",
                    key=event_type,
                    value=json.dumps(event),
                )
            except Exception as exc:
                self._local_logger.error("Failed to publish audit event: %s", exc)


