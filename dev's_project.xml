"""
ingestion/kafka/admin.py

Creates and validates Kafka topics required by the platform.
Run once on cluster bootstrap or CI.

Usage:
    python -m ingestion.kafka.admin --bootstrap-servers localhost:9092
"""

from __future__ import annotations

import logging
from dataclasses import dataclass

import click
from confluent_kafka.admin import AdminClient, NewTopic, ConfigResource, ConfigSource

logger = logging.getLogger(__name__)


@dataclass
class TopicSpec:
    name: str
    num_partitions: int
    replication_factor: int
    config: dict[str, str] | None = None


PLATFORM_TOPICS: list[TopicSpec] = [
    TopicSpec(
        name="io.telemetry.raw",
        num_partitions=8,
        replication_factor=1,
        config={
            "retention.ms": str(7 * 24 * 60 * 60 * 1000),   # 7 days
            "compression.type": "snappy",
            "cleanup.policy": "delete",
        },
    ),
    TopicSpec(
        name="io.telemetry.features",
        num_partitions=8,
        replication_factor=1,
        config={
            "retention.ms": str(3 * 24 * 60 * 60 * 1000),   # 3 days
            "compression.type": "snappy",
        },
    ),
    TopicSpec(
        name="io.hotspot.events",
        num_partitions=4,
        replication_factor=1,
        config={
            "retention.ms": str(30 * 24 * 60 * 60 * 1000),  # 30 days
            "compression.type": "lz4",
        },
    ),
    TopicSpec(
        name="io.rebalance.actions",
        num_partitions=4,
        replication_factor=1,
        config={
            "retention.ms": str(90 * 24 * 60 * 60 * 1000),  # 90 days — audit trail
            "cleanup.policy": "delete",
        },
    ),
    TopicSpec(
        name="io.audit.log",
        num_partitions=2,
        replication_factor=1,
        config={
            "retention.ms": str(365 * 24 * 60 * 60 * 1000), # 1 year
            "cleanup.policy": "delete",
        },
    ),
]


def create_topics(
    admin: AdminClient,
    topics: list[TopicSpec],
    dry_run: bool = False,
) -> dict[str, bool]:
    """
    Create topics that don't yet exist.

    Returns:
        dict mapping topic name → True (created/exists) / False (error)
    """
    existing = set(admin.list_topics(timeout=10).topics.keys())
    to_create = [t for t in topics if t.name not in existing]

    if not to_create:
        logger.info("All topics already exist — nothing to create")
        return {t.name: True for t in topics}

    if dry_run:
        for t in to_create:
            logger.info("[DRY RUN] Would create topic: %s", t.name)
        return {t.name: True for t in topics}

    new_topics = [
        NewTopic(
            t.name,
            num_partitions=t.num_partitions,
            replication_factor=t.replication_factor,
            config=t.config or {},
        )
        for t in to_create
    ]

    results: dict[str, bool] = {}
    fs = admin.create_topics(new_topics)
    for name, future in fs.items():
        try:
            future.result()
            logger.info("Created topic: %s", name)
            results[name] = True
        except Exception as exc:
            logger.error("Failed to create topic %s: %s", name, exc)
            results[name] = False

    for t in topics:
        if t.name not in results:
            results[t.name] = True   # already existed

    return results


@click.command()
@click.option("--bootstrap-servers", default="localhost:9092",
              envvar="KAFKA_BOOTSTRAP_SERVERS")
@click.option("--dry-run", is_flag=True, default=False)
@click.option("--replication-factor", default=1, type=int,
              help="Override replication factor for all topics")
def main(bootstrap_servers: str, dry_run: bool, replication_factor: int) -> None:
    """Bootstrap Kafka topics for the IO Workload Platform."""
    logging.basicConfig(level="INFO",
                        format="%(asctime)s %(levelname)s %(message)s")

    admin = AdminClient({"bootstrap.servers": bootstrap_servers})

    topics = PLATFORM_TOPICS
    if replication_factor != 1:
        topics = [
            TopicSpec(t.name, t.num_partitions, replication_factor, t.config)
            for t in topics
        ]

    results = create_topics(admin, topics, dry_run=dry_run)
    failed = [n for n, ok in results.items() if not ok]
    if failed:
        raise SystemExit(f"Failed to create topics: {failed}")

    logger.info("Kafka topic bootstrap complete ✓")


if __name__ == "__main__":
    main()
