#!/usr/bin/env python3
"""
scripts/run_pipeline.py

Full pipeline orchestration script.

Wires together all platform components for a complete end-to-end run:

  Mode: offline (default)
    1. Batch feature engineering on sample/historical data
    2. Train workload classifier
    3. Evaluate classifier + write report
    4. Train hotspot detector (Isolation Forest)
    5. Run forecasting on each volume's history
    6. Run decision engine on generated signals
    7. Produce a move plan from the rebalancer

  Mode: serve
    Starts the inference server (FastAPI).

  Mode: stream (requires Kafka + Redis)
    Starts all streaming consumers in separate threads.

Usage:
    python scripts/run_pipeline.py --mode offline
    python scripts/run_pipeline.py --mode serve
    python scripts/run_pipeline.py --mode stream
"""

from __future__ import annotations

import logging
import os
import sys
import threading
import time
from pathlib import Path

import click

# Allow imports from repo root
sys.path.insert(0, str(Path(__file__).parent.parent))

logging.basicConfig(
    level=os.getenv("LOG_LEVEL", "INFO"),
    format="%(asctime)s %(levelname)s %(name)s %(message)s",
)
logger = logging.getLogger(__name__)


#  Offline Pipeline 

def run_offline(
    data_path: str,
    output_dir: str,
    mlflow_uri: str,
    skip_train: bool,
) -> None:
    import yaml

    logger.info("═" * 60)
    logger.info("OFFLINE PIPELINE")
    logger.info("═" * 60)

    #  Step 1: Feature Backfill 
    logger.info("\n[1/6] Feature Engineering Backfill")
    from feature_engineering.batch.backfill import run_backfill
    offline_store_dir = os.path.join(output_dir, "offline_store")
    df = run_backfill(input_path=data_path, output_dir=offline_store_dir)
    logger.info("  ✓ %d rows backfilled to %s", len(df), offline_store_dir)

    if skip_train:
        logger.info("  Skipping training (--skip-train)")
    else:
        #  Step 2: Train Classifier 
        logger.info("\n[2/6] Train Workload Classifier")
        import mlflow
        from ml.classification.train import train

        cfg_path = "config/ml/classification.yaml"
        with open(cfg_path) as f:
            cfg = yaml.safe_load(f)
        cfg["tuning"] = {"enabled": False}  # fast run

        mlflow.set_tracking_uri(mlflow_uri)
        mlflow.set_experiment("io-workload-classification")

        models_dir = os.path.join(output_dir, "models")
        metrics = train(cfg=cfg, data_path=data_path, output_dir=models_dir)
        logger.info("  ✓ f1_macro=%.4f  precision=%.4f  recall=%.4f",
                    metrics["f1_macro"], metrics["precision_macro"], metrics["recall_macro"])

        #  Step 3: Evaluate Classifier 
        logger.info("\n[3/6] Evaluate Classifier")
        from ml.classification.evaluate import evaluate
        report = evaluate(
            model_path=os.path.join(models_dir, "workload_classifier_latest.pkl"),
            data_path=data_path,
            output_path=os.path.join(output_dir, "reports", "eval_latest.json"),
        )
        gate = "✓ PASSED" if report["gate_passed"] else "✗ FAILED"
        logger.info("  %s  f1=%.4f", gate, report["metrics"]["f1_macro"])

        #  Step 4: Train Hotspot Detector 
        logger.info("\n[4/6] Train Hotspot Detector (Isolation Forest)")
        from ml.hotspot_detection.detector import IsolationForestDetector
        import joblib

        iso = IsolationForestDetector(contamination=0.05)
        iso.fit(df)
        iso_path = os.path.join(models_dir, "hotspot_detector_latest.pkl")
        iso.save(iso_path)
        logger.info("  ✓ Saved hotspot detector to %s", iso_path)

    #  Step 5: Forecasting 
    logger.info("\n[5/6] Forecasting (sample volumes)")
    from ml.forecasting.forecaster import ForecastingPipeline
    pipeline = ForecastingPipeline(horizon_hours=72)

    # Run forecast for each unique volume in the sample data
    import pandas as pd
    sample_df = pd.read_csv(data_path)
    if "workload_type" in sample_df.columns:
        sample_df = sample_df.rename(columns={"workload_type": "workload_label"})
    if "volume_id" not in sample_df.columns:
        sample_df["volume_id"] = [f"vol-{i:04d}" for i in range(len(sample_df))]
    if "timestamp_utc" not in sample_df.columns:
        from datetime import datetime, timezone, timedelta
        base = datetime(2024, 1, 1, tzinfo=timezone.utc)
        sample_df["timestamp_utc"] = [
            (base + timedelta(seconds=i * 5)).isoformat()
            for i in range(len(sample_df))
        ]

    forecast_results = []
    for vol_id in sample_df["volume_id"].unique()[:5]:  # sample 5 volumes
        history = sample_df[sample_df["volume_id"] == vol_id]
        if len(history) < 3:
            continue
        result = pipeline.run(volume_id=vol_id, history=history)
        forecast_results.append(result["summary"])

    logger.info("  ✓ %d volume forecasts produced", len(forecast_results))
    for r in forecast_results[:3]:
        logger.info("    vol: dtf=%-6s capacity=%-8s latency_risk=%s",
                    str(r.get("days_to_fill", "N/A")),
                    r.get("capacity_warning", "?"),
                    r.get("latency_risk", "?"))

    #  Step 6: Decision Engine 
    logger.info("\n[6/6] Decision Engine (dry-run on forecast signals)")
    from decision_engine.engine import DecisionEngine, PolicyConstraints

    engine = DecisionEngine(
        constraints=PolicyConstraints(dry_run=True, cooldown_seconds=0)
    )

    actions_generated = 0
    for summary in forecast_results:
        action = engine.on_forecast_result({
            "volume_id": "vol-sample",
            "node_id": "node-01",
            "summary": summary,
        })
        if action:
            actions_generated += 1
            logger.info("  Action: type=%-22s priority=%d reason='%s'",
                        action.action_type, action.priority, action.reason[:60])

    logger.info("  ✓ %d actions generated (dry-run)", actions_generated)

    #  Rebalancer (demo) 
    logger.info("\nRebalancer Plan Demo")
    from rebalancer.optimizer import GreedyRebalancer, VolumeInfo, NodeState

    nodes = [
        NodeState("node-01", util_pct=88, free_capacity_gb=200, iops_headroom=5000,
                  tier="nvme_low_latency", volumes=["vol-0001", "vol-0002"]),
        NodeState("node-02", util_pct=42, free_capacity_gb=1800, iops_headroom=30000,
                  tier="nvme_high_throughput", volumes=["vol-0003"]),
        NodeState("node-03", util_pct=55, free_capacity_gb=900, iops_headroom=20000,
                  tier="sas", volumes=["vol-0004"]),
    ]
    vols = [
        VolumeInfo("vol-0001", "node-01", size_gb=50, iops_demand=8000,
                   throughput_mbps=100, workload_class="DB_OLTP", priority=2),
        VolumeInfo("vol-0002", "node-01", size_gb=200, iops_demand=1000,
                   throughput_mbps=900, workload_class="Backup", priority=4),
    ]
    plan = GreedyRebalancer().plan(volumes_to_move=vols, nodes=nodes)
    logger.info("  Plan: %d moves | %.1f GB total | projected_max_util=%.1f%%",
                len(plan.moves), plan.total_data_gb, plan.projected_max_util_pct)
    for m in plan.moves:
        logger.info("    %s: %s → %s (%.1f GB)",
                    m.volume_id, m.source_node, m.target_node, m.size_gb)

    logger.info("\n" + "═" * 60)
    logger.info("OFFLINE PIPELINE COMPLETE")
    logger.info("  Reports: %s/reports/", output_dir)
    logger.info("  Models:  %s/models/", output_dir)
    logger.info("═" * 60)


#  Serve Mode 

def run_serve(host: str, port: int) -> None:
    import uvicorn
    logger.info("Starting inference server on %s:%d", host, port)
    uvicorn.run(
        "inference.serving.app:app",
        host=host,
        port=port,
        log_level="info",
        reload=False,
    )


#  Stream Mode 

def run_stream(bootstrap_servers: str) -> None:
    logger.info("Starting streaming pipeline (Kafka consumers + feature engineering)")

    threads = []

    def start_feature_consumer():
        from feature_engineering.streaming.consumer import FeatureEngineeringConsumer
        c = FeatureEngineeringConsumer(
            bootstrap_servers=bootstrap_servers,
            raw_topic="io.telemetry.raw",
            features_topic="io.telemetry.features",
        )
        c.run()

    t = threading.Thread(target=start_feature_consumer, daemon=True, name="feature-consumer")
    t.start()
    threads.append(t)

    logger.info("Streaming pipeline started. Press Ctrl+C to stop.")
    try:
        while True:
            time.sleep(5)
            alive = [t.name for t in threads if t.is_alive()]
            logger.info("Active threads: %s", alive)
    except KeyboardInterrupt:
        logger.info("Shutting down streaming pipeline")


#  CLI 

@click.command()
@click.option("--mode", type=click.Choice(["offline", "serve", "stream"]), default="offline")
@click.option("--data", "data_path",
              default="data/sample/io_workload_data_sample.csv")
@click.option("--output-dir", default=".")
@click.option("--mlflow-uri", default="http://localhost:5000",
              envvar="MLFLOW_TRACKING_URI")
@click.option("--host", default="0.0.0.0")
@click.option("--port", default=8080, type=int)
@click.option("--bootstrap-servers", default="localhost:9092",
              envvar="KAFKA_BOOTSTRAP_SERVERS")
@click.option("--skip-train", is_flag=True, default=False,
              help="Skip model training (use existing models)")
def main(mode, data_path, output_dir, mlflow_uri, host, port,
         bootstrap_servers, skip_train):
    """IO Workload Platform pipeline runner."""
    if mode == "offline":
        run_offline(
            data_path=data_path,
            output_dir=output_dir,
            mlflow_uri=mlflow_uri,
            skip_train=skip_train,
        )
    elif mode == "serve":
        run_serve(host=host, port=port)
    elif mode == "stream":
        run_stream(bootstrap_servers=bootstrap_servers)


if __name__ == "__main__":
    main()
