# config/base.yaml
# All environment-specific configs (dev.yaml, prod.yaml) override these values.

kafka:
  bootstrap_servers: "localhost:9092"
  topics:
    telemetry_raw: "io.telemetry.raw"
    telemetry_features: "io.telemetry.features"
    hotspot_events: "io.hotspot.events"
    rebalance_actions: "io.rebalance.actions"
    audit_log: "io.audit.log"
  consumer_group: "io-workload-platform"
  producer_acks: "all"
  replication_factor: 1       # override to 3 in prod
  num_partitions: 8

redis:
  host: "localhost"
  port: 6379
  db: 0
  ttl_seconds: 300            # feature TTL in online store

postgres:
  host: "localhost"
  port: 5432
  database: "io_platform"
  user: "io_user"
  # password via env: POSTGRES_PASSWORD

mlflow:
  tracking_uri: "http://localhost:5000"
  experiment_name: "io-workload-classification"
  artifact_location: "./mlruns"

feature_engineering:
  window_sizes_seconds: [10, 60, 300]   # rolling windows for feature computation
  burst_threshold_multiplier: 2.0       # IOPS spike detection multiplier
  min_samples_for_window: 5

offline_store:
  path: "./data/offline_store"
  format: "parquet"
  partition_cols: ["date", "workload_type"]

inference:
  host: "0.0.0.0"
  port: 8080
  model_path: "./models"
  classification_model: "workload_classifier_latest.onnx"
  hotspot_model: "hotspot_detector_latest.onnx"
  forecast_model: "forecaster_latest.pkl"
  confidence_threshold: 0.80

decision_engine:
  slo:
    max_p99_latency_us: 5000
    max_node_util_pct: 85
    min_free_tier_headroom_pct: 15
  move_budget:
    max_concurrent_moves: 5
    max_bytes_per_move_gb: 100
    cooldown_seconds: 300
  approval_required_above_gb: 500     # moves >500GB need operator approval

rebalancer:
  algorithm: "greedy_load_aware"       # options: greedy_load_aware, lp_solver
  score_weights:
    latency: 0.5
    throughput: 0.3
    utilization: 0.2
  dry_run: false

autoscaler:
  forecast_horizon_hours: 72
  capacity_warning_pct: 80
  capacity_critical_pct: 90
  auto_scale_enabled: false            # set true in prod after validation

observability:
  prometheus_port: 9090
  metrics_prefix: "io_platform"
  log_level: "INFO"
  enable_tracing: true
  otlp_endpoint: "http://localhost:4317"
