        util = st.slider(f"Util %", 0, 100,
                         [88, 42, 55, 30, 76, 60, 91, 45][i % 8],
                         key=f"util_{i}", step=1)
        free = st.number_input(f"Free (GB)", 50, 5000,
                               [200, 2000, 900, 3000, 400, 1500, 100, 2500][i % 8],
                               step=50, key=f"free_{i}")
        nodes_data.append(NodeState(
            node_id=f"node-{i+1:02d}",
            util_pct=float(util),
            free_capacity_gb=float(free),
            iops_headroom=float(np.random.randint(5000, 50000)),
            tier=tier,
            volumes=[],
        ))

# ── Utilization bar ───────────────────────────────────────────────────────────
fig_util = go.Figure(go.Bar(
    x=[n.node_id for n in nodes_data],
    y=[n.util_pct for n in nodes_data],
    marker_color=[TIER_COLORS.get(n.tier, "#4B5563") for n in nodes_data],
    text=[f"{n.util_pct:.0f}%" for n in nodes_data],
    textposition="outside",
    hovertemplate="<b>%{x}</b><br>Util: %{y:.0f}%<extra></extra>",
))
fig_util.add_hline(y=85, line_dash="dash", line_color="rgba(239,68,68,0.33)",
                   annotation_text="Hotspot threshold")
fig_util.update_layout(
    paper_bgcolor="rgba(0,0,0,0)", plot_bgcolor="rgba(0,0,0,0)",
    font_color="#9CA3AF", height=220,
    yaxis=dict(range=[0,110], gridcolor="#1F2937", ticksuffix="%"),
    xaxis=dict(gridcolor="#1F2937"),
    margin=dict(l=0, r=0, t=10, b=0),
)
st.plotly_chart(fig_util, use_container_width=True)

# ── Volumes to Rebalance ───────────────────────────────────────────────────────
st.markdown("<div class='section-header'>Volumes to Rebalance</div>", unsafe_allow_html=True)

WORKLOAD_CLASSES = ["DB_OLTP", "VM", "Backup", "AI_Training", "AI_Inference"]

n_vols = st.slider("Number of volumes to move", 1, 6, 2)
vol_cols = st.columns(min(n_vols, 3))
vols_to_move = []
for i in range(n_vols):
    col = vol_cols[i % 3]
    with col:
        st.markdown(f"**vol-{i+1:03d}**")
        src_idx = st.selectbox("Source node", [n.node_id for n in nodes_data],
                               index=0, key=f"vsrc_{i}")
        wl = st.selectbox("Workload class", WORKLOAD_CLASSES,
                          index=i % len(WORKLOAD_CLASSES), key=f"vwl_{i}")
        size = st.number_input("Size (GB)", 1, 500, [50, 200, 80, 150, 30, 100][i % 6],
                               step=10, key=f"vsz_{i}")
        pri  = st.select_slider("Priority", [1,2,3,4,5],
                                value=[2,4,1,3,5,2][i % 6], key=f"vpri_{i}")
        vols_to_move.append(VolumeInfo(
            volume_id=f"vol-{i+1:03d}", node_id=src_idx,
            size_gb=float(size), iops_demand=10000.0,
            throughput_mbps=200.0, workload_class=wl, priority=pri,
        ))

st.markdown("<br>", unsafe_allow_html=True)

# ── Rebalancer config ──────────────────────────────────────────────────────────
rc1, rc2, rc3 = st.columns(3)
max_util   = rc1.slider("Max target util %",    50, 95, 80, key="max_util")
max_moves  = rc2.slider("Max concurrent moves", 1, 10, 5,  key="max_moves")
max_size   = rc3.number_input("Max move size (GB)", 10, 1000, 500, step=10, key="max_size")

# ── Run planner ───────────────────────────────────────────────────────────────
if st.button("🧮 Compute Move Plan", type="primary"):
    rebalancer = GreedyRebalancer(
        max_target_util_pct=float(max_util),
        max_concurrent_moves=int(max_moves),
        max_bytes_per_move_gb=float(max_size),
    )
    plan = rebalancer.plan(vols_to_move, nodes_data)

    st.markdown("<br><div class='section-header'>Move Plan</div>", unsafe_allow_html=True)

    if not plan.moves:
        st.warning("⚠️ No feasible moves found — all target nodes may be at capacity or above the util threshold.")
    else:
        pm1, pm2, pm3, pm4 = st.columns(4)
        pm1.metric("Moves Planned",       len(plan.moves))
        pm2.metric("Total Data",          f"{plan.total_data_gb:.1f} GB")
        pm3.metric("Est. Duration",       f"{plan.estimated_total_duration_s/60:.0f} min")
        pm4.metric("Projected Max Util",  f"{plan.projected_max_util_pct:.1f}%")

        st.markdown("<br>", unsafe_allow_html=True)

        # Sankey-style move arrows
        node_names  = list(dict.fromkeys(
            [m.source_node for m in plan.moves] + [m.target_node for m in plan.moves]
        ))
        all_nodes   = list(dict.fromkeys([n.node_id for n in nodes_data]))
        label_map   = {n: i for i, n in enumerate(all_nodes)}

        source_idx  = [label_map.get(m.source_node, 0)  for m in plan.moves]
        target_idx  = [label_map.get(m.target_node, 0)  for m in plan.moves]
        values      = [m.size_gb for m in plan.moves]
        labels      = all_nodes

        fig_sankey = go.Figure(go.Sankey(
            node=dict(
                pad=20, thickness=20, line=dict(color="#1F2937", width=0.5),
                label=labels,
                color=[TIER_COLORS.get(n.tier, "#4B5563") for n in nodes_data],
            ),
            link=dict(
                source=source_idx, target=target_idx, value=values,
                color=["rgba(239,68,68,0.3)" for _ in plan.moves],
                label=[f"{m.volume_id}: {m.size_gb:.0f} GB" for m in plan.moves],
            ),
        ))
        fig_sankey.update_layout(
            paper_bgcolor="rgba(0,0,0,0)",
            font_color="#9CA3AF", height=300,
            margin=dict(l=0, r=0, t=20, b=0),
        )
        st.plotly_chart(fig_sankey, use_container_width=True)

        # Move table
        move_rows = [{
            "Op ID":       m.op_id[:8] + "…",
            "Volume":      m.volume_id,
            "Source":      m.source_node,
            "Target":      m.target_node,
            "Size (GB)":   f"{m.size_gb:.0f}",
            "Est. Duration": f"{m.estimated_duration_s/60:.1f} min",
            "Priority":    m.priority,
            "Reason":      m.reason[:60] + "…" if len(m.reason) > 60 else m.reason,
        } for m in plan.moves]
        st.dataframe(pd.DataFrame(move_rows), hide_index=True, use_container_width=True)

        st.info("ℹ️ This is a **dry-run** plan. To execute, pass this plan to the actuator layer via `decision_engine` → `execution_monitor` → `actuator`.")
