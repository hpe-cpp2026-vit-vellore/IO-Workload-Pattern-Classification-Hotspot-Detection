# deploy/k8s/feature-consumer.yaml
# Feature Engineering Consumer + Telemetry Agent deployments

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: feature-engineering-consumer
  namespace: io-platform
  labels:
    app: feature-engineering-consumer
    component: streaming
spec:
  replicas: 2    # scale with Kafka partition count (max = num_partitions / 2)
  selector:
    matchLabels:
      app: feature-engineering-consumer
  template:
    metadata:
      labels:
        app: feature-engineering-consumer
        component: streaming
    spec:
      containers:
        - name: consumer
          image: your-registry/io-workload-platform:latest
          command:
            - python
            - -m
            - feature_engineering.streaming.consumer
          envFrom:
            - configMapRef:
                name: io-platform-config
          resources:
            requests:
              cpu: "250m"
              memory: "256Mi"
            limits:
              cpu: "1"
              memory: "512Mi"
          livenessProbe:
            exec:
              command: ["python", "-c", "import sys; sys.exit(0)"]
            initialDelaySeconds: 30
            periodSeconds: 30

---
# DaemonSet: one telemetry agent per storage node
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: telemetry-agent
  namespace: io-platform
  labels:
    app: telemetry-agent
    component: agent
spec:
  selector:
    matchLabels:
      app: telemetry-agent
  template:
    metadata:
      labels:
        app: telemetry-agent
        component: agent
    spec:
      tolerations:
        - key: node-role.kubernetes.io/storage
          operator: Exists
          effect: NoSchedule
      nodeSelector:
        node-type: storage        # only run on storage nodes
      hostNetwork: true           # access to host-level storage metrics
      containers:
        - name: agent
          image: your-registry/io-workload-platform:latest
          command:
            - python
            - -m
            - agents.telemetry_agent.agent
            - --mode
            - synthetic            # replace with 'real' when array SDK is integrated
            - --interval
            - "5"
          envFrom:
            - configMapRef:
                name: io-platform-config
          env:
            - name: NODE_ID
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "200m"
              memory: "128Mi"
</file>

<file path="deploy/k8s/inference-hub.yaml">
# deploy/k8s/inference-hub.yaml
#
# Kubernetes manifests for the IO Workload Inference Hub.
# Adjust image, resource limits, and ConfigMap values for your cluster.
#
# Apply:
#   kubectl apply -f deploy/k8s/inference-hub.yaml
#   kubectl apply -f deploy/k8s/feature-consumer.yaml

---
apiVersion: v1
kind: Namespace
metadata:
  name: io-platform

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: io-platform-config
  namespace: io-platform
data:
  ENV: "prod"
  KAFKA_BOOTSTRAP_SERVERS: "kafka-headless.kafka.svc.cluster.local:9092"
  REDIS_HOST: "redis-master.io-platform.svc.cluster.local"
  REDIS_PORT: "6379"
  MLFLOW_TRACKING_URI: "http://mlflow.io-platform.svc.cluster.local:5000"
  LOG_LEVEL: "INFO"

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: inference-hub
  namespace: io-platform
  labels:
    app: inference-hub
    component: ml
spec:
  replicas: 2
  selector:
    matchLabels:
      app: inference-hub
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app: inference-hub
        component: ml
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "8080"
        prometheus.io/path: "/metrics"
    spec:
      containers:
        - name: inference-hub
          image: your-registry/io-workload-platform:latest   # replace with your image
          imagePullPolicy: Always
          command:
            - uvicorn
            - inference.serving.app:app
            - --host
            - "0.0.0.0"
            - --port
            - "8080"
            - --workers
            - "2"
          ports:
            - containerPort: 8080
              name: http
          envFrom:
            - configMapRef:
                name: io-platform-config
          env:
            - name: MODEL_DIR
              value: /models
          resources:
            requests:
              cpu: "500m"
              memory: "512Mi"
            limits:
              cpu: "2"
              memory: "2Gi"
          volumeMounts:
            - name: models
              mountPath: /models
              readOnly: true
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 5
      volumes:
        - name: models
          persistentVolumeClaim:
            claimName: models-pvc

---
apiVersion: v1
kind: Service
metadata:
  name: inference-hub
  namespace: io-platform
  labels:
    app: inference-hub
spec:
  selector:
    app: inference-hub
  ports:
    - name: http
      port: 80
      targetPort: 8080
  type: ClusterIP

---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: inference-hub-pdb
  namespace: io-platform
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: inference-hub

---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: inference-hub-hpa
  namespace: io-platform
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: inference-hub
  minReplicas: 2
  maxReplicas: 8
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 80
</file>

