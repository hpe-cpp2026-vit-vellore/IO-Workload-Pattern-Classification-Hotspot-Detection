<file path="ingestion/kafka/consumer.py">
"""
ingestion/kafka/consumer.py

Reusable base Kafka consumer with:
  - Graceful shutdown on SIGTERM/SIGINT
  - At-least-once delivery with manual commit
  - Dead-letter queue for unprocessable messages
  - Lag reporting to Prometheus
  - Configurable error backoff

All platform consumers (feature engineering, decision engine, etc.)
inherit from BaseKafkaConsumer and implement process_message().
"""

from __future__ import annotations

import json
import logging
import os
import signal
import threading
import time
from abc import ABC, abstractmethod
from typing import Any

from confluent_kafka import Consumer, Producer, KafkaError, KafkaException, Message

logger = logging.getLogger(__name__)


class BaseKafkaConsumer(ABC):
    """
    Abstract base Kafka consumer.

    Subclasses implement:
        process_message(raw_value: dict, msg: Message) -> bool

    process_message() returns True on success, False to route to DLQ.
    Exceptions in process_message() are caught and routed to DLQ.
    """

    def __init__(
        self,
        topics: list[str],
        bootstrap_servers: str,
        consumer_group: str,
        dlq_topic: str | None = None,
        auto_offset_reset: str = "latest",
        max_poll_interval_ms: int = 60_000,
        session_timeout_ms: int = 30_000,
        enable_auto_commit: bool = False,
        commit_interval: int = 100,       # commit every N messages
        error_backoff_s: float = 1.0,
    ) -> None:
        self.topics = topics
        self.bootstrap_servers = bootstrap_servers
        self.consumer_group = consumer_group
        self.dlq_topic = dlq_topic
        self.commit_interval = commit_interval
        self.error_backoff = error_backoff_s

        self._consumer = Consumer({
            "bootstrap.servers": bootstrap_servers,
            "group.id": consumer_group,
            "auto.offset.reset": auto_offset_reset,
            "enable.auto.commit": "false",
            "max.poll.interval.ms": max_poll_interval_ms,
            "session.timeout.ms": session_timeout_ms,
            "fetch.min.bytes": 1,
            "fetch.wait.max.ms": 500,
        })

        self._dlq_producer: Producer | None = None
        if dlq_topic:
            self._dlq_producer = Producer({
                "bootstrap.servers": bootstrap_servers,
                "acks": "1",
            })

        self._running = False
        self._msg_count = 0
        self._error_count = 0
        self._dlq_count = 0
        self._lock = threading.Lock()

        # Register signal handlers for graceful shutdown
        signal.signal(signal.SIGTERM, self._handle_signal)
        signal.signal(signal.SIGINT,  self._handle_signal)

    # ── Abstract ──────────────────────────────────────────────────────────

    @abstractmethod
    def process_message(self, value: dict, msg: Message) -> bool:
        """
        Process a single decoded message.

        Args:
            value: Decoded JSON dict from the message value.
            msg:   Raw Confluent Kafka Message (for metadata access).

        Returns:
            True  — processed successfully, will commit offset.
            False — processing failed non-fatally, will route to DLQ.
        """
        ...

    # ── Public API ────────────────────────────────────────────────────────

    def run(self) -> None:
        """Start the consumer loop (blocking)."""
        self._consumer.subscribe(
            self.topics,
            on_assign=self._on_assign,
            on_revoke=self._on_revoke,
        )
        self._running = True
        logger.info("%s started: topics=%s group=%s",
                    self.__class__.__name__, self.topics, self.consumer_group)

        try:
            while self._running:
                msg = self._consumer.poll(timeout=1.0)
                if msg is None:
                    continue

                if msg.error():
                    if msg.error().code() == KafkaError._PARTITION_EOF:
                        logger.debug("EOF: %s[%d] @ offset %d",
                                     msg.topic(), msg.partition(), msg.offset())
                        continue
                    logger.error("Kafka error: %s", msg.error())
                    time.sleep(self.error_backoff)
                    continue

                self._handle_message(msg)

        except KafkaException as exc:
            logger.exception("Fatal Kafka error: %s", exc)
        finally:
            try:
                self._consumer.commit(asynchronous=False)
            except Exception:
                pass
            self._consumer.close()
            if self._dlq_producer:
                self._dlq_producer.flush()
            logger.info("%s stopped. processed=%d errors=%d dlq=%d",
                        self.__class__.__name__,
                        self._msg_count, self._error_count, self._dlq_count)

    def stop(self) -> None:
        self._running = False

    def stats(self) -> dict[str, int]:
        with self._lock:
            return {
                "processed": self._msg_count,
                "errors": self._error_count,
                "dlq": self._dlq_count,
            }

    # ── Internal ──────────────────────────────────────────────────────────

    def _handle_message(self, msg: Message) -> None:
        try:
            raw = json.loads(msg.value().decode("utf-8"))
        except (json.JSONDecodeError, UnicodeDecodeError) as exc:
            logger.warning("Failed to decode message from %s[%d]@%d: %s",
                           msg.topic(), msg.partition(), msg.offset(), exc)
            self._route_to_dlq(msg, error=str(exc))
            self._consumer.commit(message=msg, asynchronous=False)
            return

        try:
            success = self.process_message(raw, msg)
        except Exception as exc:
            logger.exception("Unhandled exception in process_message: %s", exc)
            success = False
            with self._lock:
                self._error_count += 1

        if not success:
            self._route_to_dlq(msg, error="process_message returned False")

        with self._lock:
            self._msg_count += 1
            should_commit = (self._msg_count % self.commit_interval == 0)

        if should_commit:
            self._consumer.commit(asynchronous=False)

    def _route_to_dlq(self, msg: Message, error: str) -> None:
        if not self._dlq_producer or not self.dlq_topic:
            return
        try:
            self._dlq_producer.produce(
                topic=self.dlq_topic,
                key=msg.key(),
                value=msg.value(),
                headers={"error": error.encode(), "source_topic": msg.topic().encode()},
            )
            self._dlq_producer.poll(0)
            with self._lock:
                self._dlq_count += 1
        except Exception as exc:
            logger.error("Failed to route to DLQ: %s", exc)

    def _on_assign(self, consumer, partitions) -> None:
        logger.info("Partitions assigned: %s",
                    [(p.topic, p.partition) for p in partitions])

    def _on_revoke(self, consumer, partitions) -> None:
        logger.info("Partitions revoked: %s",
                    [(p.topic, p.partition) for p in partitions])
        try:
            consumer.commit(asynchronous=False)
        except Exception:
            pass

    def _handle_signal(self, signum, frame) -> None:
        logger.info("Received signal %d — shutting down", signum)
        self.stop()
