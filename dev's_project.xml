#  Array API Actuator 

class ArrayAPIActuator(BaseActuator):
    """
    Actuator for vendor storage arrays (Pure Storage, NetApp, Dell EMC, etc.)

    Communicates via the array's REST API.
    Concrete implementation is vendor-specific; this is the interface skeleton.
    """

    def __init__(
        self,
        monitor: ExecutionMonitor,
        array_endpoint: str,
        api_token: str,
    ) -> None:
        super().__init__(monitor)
        self.array_endpoint = array_endpoint
        self.api_token = api_token

    def _execute_move(self, move: MoveOp) -> bool:
        self.monitor.update_phase(move.op_id, MovePhase.PRE_CHECK)
        logger.info("[ArrayAPI] Would move vol=%s on %s",
                    move.volume_id, self.array_endpoint)

        # TODO: Call array REST API
        # e.g. POST /api/2.x/volumes/{volume_id}/migrate
        # Poll until complete, report progress

        self.monitor.update_phase(move.op_id, MovePhase.COMPLETED,
                                   bytes_moved_gb=move.size_gb)
        return True

    def rollback_move(self, op_id: str) -> bool:
        logger.info("[ArrayAPI] Rollback for op_id=%s — vendor-specific", op_id)
        return False


#  Factory 

def get_actuator(
    actuator_type: str,
    monitor: ExecutionMonitor,
    **kwargs,
) -> BaseActuator:
    if actuator_type == "stub":
        return StubActuator(monitor, **kwargs)
    elif actuator_type == "csi":
        return CSIActuator(monitor, **kwargs)
    elif actuator_type == "array_api":
        return ArrayAPIActuator(monitor, **kwargs)
    else:
        raise ValueError(f"Unknown actuator type: {actuator_type}")
